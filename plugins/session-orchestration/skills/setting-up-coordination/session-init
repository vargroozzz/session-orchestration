# --- Migrate (--migrate [--dry-run] [--apply=ID | --decline=ID]): an older setup's layout made current ------------
# The detectors are --check's `[ID CLASS]` lines (CLASS auto, ask or hand). Each auto one is fixed in id order, its
# rewritten personal files backed up first to P/migrate-backup/<date>/, and logged to P/migrate.log (`<id> start`, each
# move, `<id> done` or `failed`): a run after one that stopped midway resumes, as every fix checks before it applies.
# The ask and hand ones are listed (an ask's would-be change indented under it) for open_pane to queue as pane asks;
# ids in P/setup.json's `declined` aren't (--check still names them). m7 auto asks instead while other sessions of
# this project run: they hold the old paths until they restart. --apply=ID runs ID's fix whatever its class
# (--dry-run: what it would change), --decline=ID adds an ask or hand id to `declined`; either then runs the plain
# --migrate. P/setup.json is stamped with LAYOUT once --check names nothing open: a stamp at LAYOUT ends the next run
# after one read. --dry-run: what it would do, writing nothing. A fix never writes a file git tracks in the checkout:
# it writes that file's copy in a team worktree (R/.worktrees/coordination/migrate-<id>, from origin/<default>), one
# team PR per id, and while one is open (a branch with a commit HEAD lacks, by patch) the id is `[ID wait]`.
if [ "$mode" = migrate ]; then
  stamp=$P/setup.json log=$P/migrate.log l=$sl
  [ -z "$newer" ] || { echo "$newer"; exit 0; }
  [ -n "$apply$decline" ] || [ "$l" != "$LAYOUT" ] || { echo "current: layout $LAYOUT ($(tilde "$stamp"))"; exit 0; }
  [ "$state" = configured ] || { echo "not set up for coordination ($state): run session-status --init first"; exit 1; }
  # One run at a time per project: open_pane and session-status --start may run it in the same turn.
  if [ -z "$dry" ] && [ -z "${SI_MIGRATE_LOCKED:-}" ]; then
    lk=$P/migrate.lock; mkdir -p "$P" || exit 1
    find "$lk" -maxdepth 0 -mmin +10 -exec rmdir {} \; 2>/dev/null   # left by a run that was killed
    n=0; until mkdir "$lk" 2>/dev/null; do
      n=$((n + 1)); [ "$n" -lt 80 ] || { echo "busy: another --migrate runs for this project ($(tilde "$lk"))"; exit 0; }; sleep 0.25
    done
    trap 'rmdir "$lk" 2>/dev/null' EXIT; export SI_MIGRATE_LOCKED=1
  fi
  chk=$(bash "$0" --check 2>/dev/null)
  ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
  jl() { [ -n "$dry" ] || { mkdir -p "$P" && echo "$(ts) $*" >> "$log"; }; }
  declined=$(jq -r '.declined // [] | .[] | strings' "$stamp" 2>/dev/null | paste -sd' ' -)
  # an id started and never done or failed: the run before stopped midway
  [ -n "$apply$decline" ] || [ ! -f "$log" ] || awk '$3 != "mv" { s[$2] = $3 } END { for (i in s) if (s[i] == "start") print "resuming " i ": an earlier run stopped midway"; else if (s[i] == "failed:") print "retrying " i ": it failed in an earlier run" }' "$log"
  # backup FILE…: each existing one into today's backup folder, at its path under the root, once a day
  backup() {
    local f b; for f; do
      [ -f "$f" ] || continue
      b=$P/migrate-backup/$(date +%F)/${f#"$root"/}; [ -e "$b" ] || { mkdir -p "$(dirname "$b")" && cp -p "$f" "$b"; } || return 1
    done
  }
  # jset FILE JQ-ARGS… FILTER: FILE (created as {}) through jq
  jset() { local f=$1; shift; mkdir -p "$(dirname "$f")" && { [ -e "$f" ] || echo '{}' > "$f"; } && jq "$@" "$f" > "$f.tmp" && mv "$f.tmp" "$f"; }
  # live: this project's other running sessions (any account), which keep the old paths until they restart; `?` when
  # an account's listing failed (counted as live: moving under a running session is what this guards against)
  live() {
    local t n; t=$(mktemp -d) || { echo '?'; return; }
    n=$( ( TMP=$t; load_module features accounts list_accounts 2>/dev/null; list_sessions 2>/dev/null ) |
      awk -F'\t' -v r="$root" -v me="${CLAUDE_CODE_SESSION_ID:-}" '$1 != me && $3 !~ /^(done|failed|stopped)$/ && ($6 == r || index($6, r "/") == 1) { n++ } END { print n + 0 }')
    [ ! -e "$t/ask.failed" ] || n='?'; rm -rf "$t"; echo "$n"
  }
  # --- Team files: a fix's change to a tracked file goes to a team PR (coordination/migrate-<id>), never the checkout
  # dbr R: R's default branch
  dbr() {
    local b; b=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && { echo "${b#origin/}"; return; }
    git -C "$1" rev-parse -q --verify origin/main >/dev/null || ! git -C "$1" rev-parse -q --verify origin/master >/dev/null || { echo master; return; }
    echo main
  }
  # trs: the repos a team PR may be in: the root's and the one holding the committed files' folder
  trs() {
    local t
    { [ -z "$top0" ] || echo "$top0"; [ -z "$sd" ] || { t=$(git -C "$sd" rev-parse --show-toplevel 2>/dev/null) && (cd "$t" && pwd -P); }; } | awk '!s[$0]++'
  }
  tdrop() { git -C "$1" worktree remove --force "$1/.worktrees/$2" >/dev/null 2>&1; git -C "$1" branch -q -D "$2" >/dev/null 2>&1; return 0; }
  # tfetch: the migrate branches on origin (teammates' open PRs), best effort
  # (no credential prompt: open_pane runs this unattended)
  tfetch() { local R; while IFS= read -r R; do GIT_TERMINAL_PROMPT=0 git -C "$R" fetch -q --prune origin '+refs/heads/coordination/migrate-*:refs/remotes/origin/coordination/migrate-*' 2>/dev/null; done < <(trs); return 0; }
  # open_pr ID: the branch of ID's open team PR (a local or origin branch with a commit HEAD lacks: cherry compares
  # patches, as a rebase merge rewrites the SHAs) and, indented, how to drop it when it won't merge; else fails
  open_pr() {
    local R r B=coordination/migrate-$1
    while IFS= read -r R; do
      for r in "refs/heads/$B" "refs/remotes/origin/$B"; do
        git -C "$R" rev-parse -q --verify "$r" >/dev/null && git -C "$R" cherry HEAD "$r" 2>/dev/null | grep -q '^+' &&
          { echo "$B"; echo "  not going ahead with it (no, closed, or merged changed): close its PR and drop the branch (git -C $R worktree remove --force $R/.worktrees/$B; git -C $R branch -D $B; git -C $R push origin --delete $B), then --migrate asks again"; return 0; }
      done
    done < <(trs)
    return 1
  }
  # tf FILE (inside fix, sees its i): the path a fix writes FILE at: FILE itself when untracked (or with pv set), else
  # its copy in ID's team worktree, made from origin/<default> on first use
  tf() {
    local f=$1 R B W d ex
    if [ -n "$pv" ] || ! git -C "${f%/*}" ls-files --error-unmatch -- "${f##*/}" >/dev/null 2>&1; then echo "$f"; return 0; fi
    f=$(cd "${f%/*}" && pwd -P)/${f##*/}   # physical, as R is (a `team` path with .. or a symlink)
    R=$(git -C "${f%/*}" rev-parse --show-toplevel) && R=$(cd "$R" && pwd -P) || { echo "refused: no repo for $f"; return 1; }
    B=coordination/migrate-$i W=$R/.worktrees/coordination/migrate-$i
    if [ ! -d "$W" ]; then
      git -C "$R" worktree prune 2>/dev/null
      # an earlier run's branch with nothing open (merged) goes; one with open commits is a PR not seen as open here
      if git -C "$R" rev-parse -q --verify "refs/heads/$B" >/dev/null; then
        git -C "$R" cherry HEAD "$B" 2>/dev/null | grep -q '^+' || tdrop "$R" "$B"
        ! git -C "$R" rev-parse -q --verify "refs/heads/$B" >/dev/null ||
          { echo "refused: $B exists already in $R: push it and open its PR, or remove it (git -C $R branch -D $B)"; return 1; }
      fi
      d=$(dbr "$R")
      GIT_TERMINAL_PROMPT=0 git -C "$R" fetch -q origin "$d" 2>/dev/null   # best effort: offline, the origin/$d fetched last
      git -C "$R" rev-parse -q --verify "origin/$d^{commit}" >/dev/null || { echo "refused: no origin/$d in $R to branch the team PR from"; return 1; }
      git -C "$R" worktree add -q -b "$B" "$W" "origin/$d" >/dev/null 2>&1 || { echo "refused: git worktree add $W failed"; return 1; }
      ex=$(git -C "$R" rev-parse --git-path info/exclude); case $ex in /*) ;; *) ex=$R/$ex ;; esac
      (cd "$R" && git check-ignore -q .worktrees/x) || echo /.worktrees/ >> "$ex"   # the main checkout stays clean
    fi
    # the fix read the checkout's copy: one that isn't origin's would change something else, or nothing (checked while
    # the team copy is untouched: m3 comes back to it per hook)
    ! git -C "$W" diff --quiet -- "${f#"$R"/}" 2>/dev/null || cmp -s "$f" "$W/${f#"$R"/}" ||
      { echo "refused: ${f#"$R"/} here isn't origin/$(dbr "$R")'s (an uncommitted edit, another branch or an unpushed commit): land it on $(dbr "$R") first, then run this again"; return 1; }
    echo "$W/${f#"$R"/}"
  }
  # tnote FILE (inside fix): where a tracked FILE's change goes, for out
  tnote() {
    git -C "${1%/*}" ls-files --error-unmatch -- "${1##*/}" >/dev/null 2>&1 || return 0
    echo " (git tracks it: a team PR, committed on coordination/migrate-$i from origin/$(dbr "$(git -C "${1%/*}" rev-parse --show-toplevel)"); this checkout gets it with the merge)"
  }
  # team_pr ID [fail]: ID's team worktrees committed (the repo file's layout raised, the added lines scrubbed), each
  # with the push + PR command for one pane ask; fail: the ones with no commit go
  team_pr() {
    local R B=coordination/migrate-$1 W d rel bad msg url pr note rc=0 sdp dd
    sdp=$( [ -n "$sd" ] && cd "$sd" 2>/dev/null && pwd -P)
    while IFS= read -r R; do
      W=$R/.worktrees/$B; [ -d "$W" ] || continue
      d=$(dbr "$R")
      if [ -n "${2:-}" ]; then [ -n "$(git -C "$W" rev-list -1 "origin/$d..HEAD" 2>/dev/null)" ] || tdrop "$R" "$B"; continue; fi
      msg="coordination: migrate $1 (lines from an older setup)"   # no ' : it goes in the PR command's quotes
      if [ -n "$(git -C "$W" status --porcelain)" ]; then
        case $sdp in "$R"/*) rel=${sdp#"$R"/}/coordination.json
          [ ! -f "$W/$rel" ] || { jq --argjson l "$LAYOUT" '.layout = ([.layout // 0, $l] | max)' "$W/$rel" > "$W/$rel.tmp" && mv "$W/$rel.tmp" "$W/$rel"; } || rc=1 ;;
        esac
        git -C "$W" add -A || rc=1
        # the added lines, less those the file had already (jq's rewrite re-indents: compared trimmed, no trailing comma)
        dd=$(git -C "$W" diff --cached -U0)
        bad=$(team_scrub "$B" "$(awk 'function t(s) { gsub(/^[ \t]+|[ \t,]+$/, "", s); return s }
          FNR == NR { if (/^-/ && !/^--- /) old[t(substr($0, 2))] = 1; next }
          /^\+/ && !/^\+\+\+ / && !(t(substr($0, 2)) in old) { print substr($0, 2) }' <(printf '%s\n' "$dd") <(printf '%s\n' "$dd"))" | sort -u)
        if [ -n "$bad" ]; then
          tdrop "$R" "$B"; echo "refused: $B would put personal details in a team file:"; sed 's/^/  /' <<<"$bad"; rc=1; continue
        fi
        [ "$rc" = 0 ] && git -C "$W" commit -q -m "$msg" || { tdrop "$R" "$B"; echo "refused: the commit in $W failed"; rc=1; continue; }
      fi
      if [ -z "$(git -C "$W" rev-list -1 "origin/$d..HEAD" 2>/dev/null)" ]; then tdrop "$R" "$B"; echo "  origin/$d has it already: pull $d"; continue; fi
      url=$(git -C "$R" config --get remote.origin.url) pr="git -C $W push -u origin $B" note=
      case $url in   # as configured, not insteadOf-rewritten: what gh resolves
        *github.com*) pr+=" && gh pr create -R $(url_slug "$url") --base $d --head $B --title '$msg' --body 'An older setup made current in the shared coordination files: every collaborator gets it with the merge.'" ;;
        *) note="Then open a PR from $B into $d on the code host." ;;
      esac
      echo "Team PR: committed on $B ($W): show its diff in one pane ask (git -C $W show), then on yes: $pr"
      [ -z "$note" ] || echo "$note"
    done < <(trs)
    return "$rc"
  }
  # fix ID: ID's fix (an auto or an ask one), what it did in $out; with pv set, what it would change, writing nothing
  pv=
  fix() {
    local i=$1 rc=0 x f g k v c d n src ds ct new ks=()
    out=
    case $i in
      m1) ! tracked "$cfg_person" || { out="refused: the committed .claude/coordination.local.json can't take approvals.delegate"; return 1; }
          out="approvals.delegate=true → .claude/coordination.local.json"
          [ -n "$pv" ] || { backup "$cfg_person" && jset "$cfg_person" '.approvals.delegate = true'; } || return 1 ;;
      m2) # one id, up to three keys: each one --check found
          ! grep -q '^\[m2 ask\] detected ' <<<"$chk" || ks+=("$cfg_person	terminal	\"$term_found\"")
          ! grep -q '^\[m2 ask\] second account found' <<<"$chk" || ks+=("$cfg_person	features.accounts	true")
          ! grep -q '^\[m2 ask\] review inbox found' <<<"$chk" || ks+=("$cfg_repo	features.review_inbox	true")
          for x in ${ks[@]+"${ks[@]}"}; do
            IFS=$'\t' read -r f k v <<<"$x"
            [ "$f" != "$cfg_person" ] || ! tracked "$f" || { out+="refused: the committed .claude/coordination.local.json can't take $k"$'\n'; rc=1; continue; }
            out+="$k=$v → ${f#"$root"/}$(tnote "$f")"$'\n'
            g=$(tf "$f") || { out+="$g"$'\n'; rc=1; continue; }
            [ -n "$pv" ] || { { [ "$g" != "$f" ] || backup "$f"; } && jset "$g" --arg k "$k" --argjson v "$v" 'setpath($k | split("."); $v)'; } || rc=1
          done
          return "$rc" ;;
      m3) # each hook --check named: its folder (the one `git -C DIR` or `cd DIR` names, in the command or a script it
          # runs) into history.dirs, the hook out of the settings file
          ! tracked "$cfg_person" || { out="refused: the committed .claude/coordination.local.json can't take history.dirs"; return 1; }
          while IFS= read -r c; do
            [ -n "$c" ] || continue
            src=$c x=$(sed -e "s#\${CLAUDE_PROJECT_DIR}#$root#g; s#\$CLAUDE_PROJECT_DIR#$root#g" -e 's/["'\'']//g' <<<"$c")
            set -f; for f in $x; do case $f in /*) ;; '~'/*) f=$HOME/${f#'~/'} ;; *) f=$root/$f ;; esac
              [ -f "$f" ] && src+=$'\n'$(cat "$f"); done; set +f
            src=$(sed -e "s#\${CLAUDE_PROJECT_DIR}#$root#g; s#\$CLAUDE_PROJECT_DIR#$root#g" -e 's/["'\'']//g' <<<"$src")
            ds=$(grep -oE 'git[[:space:]]+-C[[:space:]]+[^[:space:];&|)]+' <<<"$src" | awk '{ print $NF }' | sort -u)
            [ -n "$ds" ] || ds=$(grep -oE '(^|[^[:alnum:]_])cd[[:space:]]+[^[:space:];&|)]+' <<<"$src" | awk '{ print $NF }' | sort -u)
            if [ "$(grep -c . <<<"$ds")" != 1 ] || [[ $ds == *'$'* ]]; then
              out+="refused: can't tell the folder the Stop hook ($c) commits${ds:+ (it names: $(paste -sd' ' - <<<"$ds"))}: add it to history.dirs in .claude/coordination.local.json and drop the hook by hand"$'\n'; rc=1; continue
            fi
            case $ds in "$root") d=. ;; "$root"/*) d=${ds#"$root"/} ;; /*|'~'/*) d=$ds ;; *) d=$ds ;; esac
            out+="history.dirs += $d (.claude/coordination.local.json)"$'\n'; k=
            for f in "$root"/.claude/settings.json "$root"/.claude/settings.local.json; do
              jq -e --arg c "$c" 'any(.hooks.Stop[]?.hooks[]?; .command? == $c)' "$f" >/dev/null 2>&1 || continue
              k=1
              g=$(tf "$f") || { out+="$g"$'\n'; rc=1; continue; }
              new=$(jq --arg c "$c" '.hooks.Stop |= (map(.hooks |= map(select(.command? != $c))) | map(select((.hooks | length) > 0)))
                | if .hooks.Stop == [] then del(.hooks.Stop) else . end | if .hooks == {} then del(.hooks) else . end' "$g") || { rc=1; continue; }
              out+="the hook out of ${f#"$root"/}$(tnote "$f")"
              out+=$'\n'$(diff <(jq . "$g") <(printf '%s\n' "$new") | sed -n 's/^< /- /p; s/^> /+ /p')$'\n'
              [ -n "$pv" ] || { { [ "$g" != "$f" ] || backup "$f"; } && printf '%s\n' "$new" > "$g.tmp" && mv "$g.tmp" "$g"; } || rc=1
            done
            [ -n "$k" ] || { out+="refused: no settings file holds the Stop hook ($c) as --check read it: drop it by hand"$'\n'; rc=1; continue; }
            [ -n "$pv" ] || { backup "$cfg_person" && jset "$cfg_person" --arg d "$d" '.history.dirs = ((.history.dirs // []) + [$d] | unique)'; } || rc=1
          done < <(sed -n 's/^\[m3 ask\] project Stop hook commits a folder (\(.*\)): run setup to move that folder to history.dirs and drop the hook$/\1/p' <<<"$chk" | sort -u)
          return "$rc" ;;
      m4) rb=$(retro_brief "$orch" retro rnd); n=${rb%/*}/retro-brief.md
          [ -z "$pv" ] || { out="would rename $rb → $n"; return 0; }
          mv "$(at "$rb")" "$(at "$n")" && out="$rb → $n" && jl "$i mv $(at "$rb") → $(at "$n")" || rc=1 ;;
      m5) # the crontab's rnd-weekly lines for this root: retro-run takes the same ROOT (no due check without
          # retro.schedule: the cron line stays the schedule). Rewritten only from a crontab -l that read it.
          ct=$(crontab -l 2>/dev/null) && [ -n "$ct" ] || { out="refused: crontab -l gave nothing to edit"; return 1; }
          # from the versioned install cache, retro-run --install's resolver: the cache path goes with the next update
          case ${LIB_DIR%/} in
            */plugins/cache/*/*/*) v=${LIB_DIR%/}; v=${v%/*}; x=${v##*/}; v=${v%/*}; x=$x@${v##*/}
              rr="/bin/bash -c 'd=\$(jq -r --arg k $x \".plugins[\\\$k][0].installPath // empty\" \"\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}/plugins/installed_plugins.json\") && [ -n \"\$d\" ] && exec \"\$d/skills/retro/retro-run\" \"\$@\"' retro-run" ;;
            *) rr=$LIB_DIR/skills/retro/retro-run ;;
          esac
          new=$(RR=$rr awk -v r="$root" '{
              if (index($0, "rnd-weekly") && match($0, /[^ \t"\047]*rnd-weekly/)) {
                pre = substr($0, 1, RSTART - 1); post = substr($0, RSTART + RLENGTH); p = post; sub(/^["\047]/, "", p)
                # a quoted old path loses its quotes: the new one may be a command with its own
                q = substr(pre, length(pre)); if ((q == "\"" || q == "\047") && substr(post, 1, 1) == q) { pre = substr(pre, 1, length(pre) - 1); post = substr(post, 2) }
                rr = ENVIRON["RR"]
                k = 0; a1 = ""; a2 = ""; n = split(p, w, /[ \t]+/)
                for (j = 1; j <= n; j++) if (w[j] != "") { if (++k == 1) a1 = w[j]; else { a2 = w[j]; break } }
                gsub(/["\047]/, "", a1)
                if (a1 == r) { if (a2 ~ /^-/) bad = 1; $0 = pre rr post; hit = 1 }
              }
              print } END { exit bad ? 3 : hit ? 0 : 4 }' <<<"$ct"); rc=$?
          [ "$rc" != 3 ] || { out="refused: the rnd-weekly line passes more than the folder: replace it by hand with retro-run ROOT"; return 1; }
          [ "$rc" = 0 ] || { out="refused: no rnd-weekly line runs rnd-weekly ROOT for this folder: replace it by hand with retro-run ROOT"; return 1; }
          out="crontab: rnd-weekly → retro-run"$'\n'$(diff <(printf '%s\n' "$ct") <(printf '%s\n' "$new") | sed -n 's/^< /- /p; s/^> /+ /p')
          [ -z "$pv" ] || return 0
          x=$P/migrate-backup/$(date +%F)/crontab
          { [ -e "$x" ] || { mkdir -p "${x%/*}" && printf '%s\n' "$ct" > "$x"; }; } && printf '%s\n' "$new" | crontab - || return 1 ;;
      m6) # the first memory line naming a start mode: its one mode word becomes start.mode, the line goes
          ! tracked "$cfg_person" || { out="refused: the committed .claude/coordination.local.json can't take start.mode"; return 1; }
          x=$(grep -HniE '(^|[^a-z])start[ ._-]?mode' "$memf" "${memf%.md}"/*.md 2>/dev/null | head -1)
          [ -n "$x" ] || { out="nothing to do: no start mode line in memory"; return 0; }
          f=${x%%:*} x=${x#*:}; n=${x%%:*} x=${x#*:}
          v=$(grep -oiE 'read[ _-]?only|propose|at[ _-]?once' <<<"$x" | tr 'A-Z' 'a-z' | sed -E 's/^read[ _-]?only$/read_only/; s/^at[ _-]?once$/at_once/' | sort -u)
          [ "$(grep -c . <<<"$v")" = 1 ] || { out="refused: can't tell one start mode from line $n of $(tilde "$f") ($x): set start.mode by hand and delete the line"; return 1; }
          out="start.mode=$v → .claude/coordination.local.json; line $n of $(tilde "$f") deleted: $x"
          [ -n "$pv" ] || { backup "$f" "$cfg_person" && jset "$cfg_person" --arg v "$v" '.start.mode = $v' &&
            awk -v n="$n" 'NR != n' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; } || return 1 ;;
      m7) [ -z "$pv" ] || { out="would move them into $(tilde "$P") and rewrite their lines (session-status --init --write --move)"; return 0; }
          backup "$root/CLAUDE.local.md" "$root/CLAUDE.md" "$root/.claude/session-status-adapter" "$cfg_person" || rc=1
          [ "$rc" = 1 ] || { out=$(SI_MIGRATE=1 bash "$0" --write --move 2>&1) || rc=1; }
          while IFS= read -r x; do case $x in '  '*' → '*) jl "$i mv ${x#  }" ;; esac; done <<<"$out" ;;
      m8) rf=$sd/coordination.json
          if tracked "$cfg_person"; then out="the committed .claude/coordination.local.json can't take them"; return 1; fi
          if [ -n "$pv" ]; then
            out="would move pending.file, history.dirs → .claude/coordination.local.json (yours win; $(jq -c '{pending: .pending.file, history: .history.dirs}' "$rf"))"
            x=$(tnote "$rf"); [ -z "$x" ] || out+=$'\n'"out of the committed ${rf#"$root"/}$x"
            return 0
          fi
          # the personal half reads the checkout's repo file; the delete goes to its team copy when git tracks it
          g=$(tf "$rf") || { out=$g; return 1; }
          { [ "$g" != "$rf" ] || backup "$rf"; } && backup "$cfg_person" && mkdir -p "$root/.claude" && { [ -e "$cfg_person" ] || echo '{}' > "$cfg_person"; } &&
            # the person's own value wins; the repo file's goes either way
            jq --slurpfile r "$rf" 'reduce (["pending", "file"], ["history", "dirs"]) as $k (.;
              if getpath($k) == null and ($r[0] | getpath($k)) != null then setpath($k; $r[0] | getpath($k)) else . end)' \
              "$cfg_person" > "$cfg_person.tmp" && mv "$cfg_person.tmp" "$cfg_person" &&
            jq 'del(.pending.file, .history.dirs) | with_entries(select((.key | IN("pending", "history") | not) or .value != {}))' \
              "$g" > "$g.tmp" && mv "$g.tmp" "$g" && out="pending.file, history.dirs → .claude/coordination.local.json" || rc=1 ;;
      m9) ad=$root/.claude/session-status-adapter; map=$(stale_ad)
          if [ -z "$map" ]; then out="nothing left to point"   # a run that stopped after the rewrite
          elif [ -n "$pv" ]; then out=$(RQ=word rew "$ad" check)
          else
            backup "$ad" && out=$(RQ=word rew "$ad" check) && RQ=word rew "$ad" > "$ad.tmp" && chmod +x "$ad.tmp" && mv "$ad.tmp" "$ad" || rc=1
          fi ;;
      m10) # each file's old template lines (a hand-edited one stays, named); the copy keeps the file's mode
          while IFS= read -r f; do
            [ -n "$f" ] && d=$(drift "$f" check) && grep -q '^+ ' <<<"$d" || continue
            out+="${f#"$root"/}$(tnote "$f")"$'\n'"$d"$'\n'
            g=$(tf "$f") || { out+="$g"$'\n'; rc=1; continue; }
            [ -n "$pv" ] || { { [ "$g" != "$f" ] || backup "$f"; } && cp -p "$g" "$g.tmp" && drift "$g" > "$g.tmp" && mv "$g.tmp" "$g"; } || { rm -f "$g.tmp"; rc=1; }
          done <<<"$(drift_files)"
          [ -n "$out" ] || out="nothing left to bring current" ;;
      *) out="no fix for $i in this plugin (a session does it by hand)"; return 1 ;;
    esac
    return "$rc"
  }
  # run_fix ID HOW: fix ID, logged, `[ID HOW] done` or `failed: why`
  run_fix() {
    local i=$1 why
    jl "$i start"
    local tp=
    # a tracked file's change is committed in its team worktree once the fix is through (team_pr), or dropped
    if fix "$i" && tp=$(team_pr "$i"); then jl "$i done"; echo "[$i $2] done"; grep . <<<"$out" | sed 's/^ */  /'; [ -z "$tp" ] || echo "$tp"
    else
      out=$tp$'\n'$out; team_pr "$i" fail
      why=$(grep -m1 -E '^(refused|move failed):' <<<"$out" || grep . <<<"$out" | tail -1); jl "$i failed: $why"; echo "[$i $2] failed: $why"
      [ -z "$tp" ] || grep '^  ' <<<"$tp"   # the scrub's lines
      return 1
    fi
  }
  if [ -n "$apply$decline" ]; then
    i=${apply:-$decline} rc=0
    [[ $i =~ ^[mh][0-9]+$ ]] || { echo "not a migration id: $i"; exit 2; }
    [ -n "$apply" ] || [ -z "$dry" ] || { echo "--decline has no --dry-run"; exit 2; }
    case $apply in h*) echo "$i: no --apply (a hand one: a session does it; --decline=$i puts it away)"; exit 2 ;; esac
    [ -z "$apply" ] || ! grep -q "^\[$i hand\] " <<<"$chk" || { echo "$i: no --apply (a hand one now: a session does it; --decline=$i puts it away)"; exit 2; }
    [ -z "$apply" ] || ! grep -q "^\[$i " <<<"$chk" || tfetch
    if ! grep -q "^\[$i " <<<"$chk"; then echo "$i: not open (--check doesn't name it)"
    elif [ -n "$apply" ] && b=$(open_pr "$i"); then echo "$i: a team PR is open on ${b%%$'\n'*}: nothing to apply until it merges and you pull"; echo "${b#*$'\n'}"; exit 0
    elif [ -n "$apply" ] && [ -n "$dry" ]; then pv=1; fix "$i"; rc=$?; grep . <<<"$out"; exit "$rc"
    elif [ -n "$apply" ]; then
      run_fix "$i" apply || rc=1
      [ "$rc" = 1 ] || [ ! -f "$stamp" ] || jset "$stamp" --arg i "$i" '.declined = ((.declined // []) - [$i])'
    elif [ "$i" = m7 ] && ! grep -q '^\[m7 hand\] ' <<<"$chk"; then echo "m7: not declined, put off: it's asked again while other sessions run, and moves unasked once none does"
    elif grep -q "^\[$i auto\] " <<<"$chk"; then echo "$i: an automatic fix: nothing to decline"
    else
      jset "$stamp" --arg i "$i" '.layout //= 0 | .declined = ((.declined // []) + [$i] | unique)' || exit 1
      jl "$i declined"; echo "$i: declined (--check still names it; --apply=$i applies it)"
    fi
    bash "$0" --migrate || rc=1; exit "$rc"
  fi
  failed= open= dec= waiting= tfd=
  # every id, in run order: m8 before m7 (m9, m10 last), so the move sees (and rewrites) the pending.file m8 brings over
  for i in m1 m2 m3 m4 m5 m6 m8 m7 m9 m10 h1 h2; do
    lines=$(grep "^\[$i " <<<"$chk") || continue
    if [[ " $declined " == *" $i "* ]] && { [ "$i" != m7 ] || grep -q '^\[m7 hand\] ' <<<"$lines"; }; then dec+=" $i"; continue; fi
    if [ "$i" = m7 ] && grep -q '^\[m7 auto\] ' <<<"$lines" && n=$(live) && [ "$n" != 0 ]; then
      x=${lines#*outside }; x=${x%%: run session-status*}
      [ "$n" = '?' ] && n="maybe other running sessions (listing them failed)" || n="$n other running session(s)"
      lines="[m7 ask] coordinator files outside $x, and $n of this project keep the old paths until they restart: move now (--apply=m7) or wait"
    fi
    if ! grep -q "^\[$i auto\] " <<<"$lines"; then
      # its team PR open (this person's or a teammate's): not asked again (open_pane queues only ask and hand lines)
      [ -n "$tfd" ] || { tfetch; tfd=1; }   # once, and only for an id still open
      if b=$(open_pr "$i"); then
        echo "[$i wait] a team PR is open on ${b%%$'\n'*} (yours or a teammate's): it applies here once it merges and you pull"; echo "${b#*$'\n'}"
        waiting+=" $i"; continue
      fi
      # a hand one with its indented lines (what to do), an ask one with what the answer would change
      if grep -q "^\[$i hand\] " <<<"$lines"; then awk -v p="[$i hand] " 'index($0, p) == 1 { f = 1; print; next } f && /^  / { print; next } { f = 0 }' <<<"$chk"
      else echo "$lines"; ( pv=1; fix "$i"; grep . <<<"$out" ) 2>/dev/null | sed 's/^/  /'; fi
      open+=" $i"
      continue
    fi
    [ -z "$dry" ] || { echo "would fix: $lines"; continue; }
    run_fix "$i" auto || failed+=" $i"
  done
  [ -z "$dec" ] || echo "declined:$dec (--check still names them; --apply=ID applies one)"
  if [ -n "$dry" ]; then
    um=$(grep '^unmeasured: ' <<<"$chk" | paste -sd';' -)
    if [ -n "$open" ]; then echo "stamp: not yet (open:$open)"; elif [ -n "$waiting" ]; then echo "stamp: not yet (team PR open:$waiting)"
    elif [ -n "$um" ]; then echo "stamp: not yet ($um)"
    else echo "stamp: would write layout $LAYOUT to $(tilde "$stamp")"; fi
    exit 0
  fi
  [ -z "$failed" ] || { echo "stamp: not written (failed:$failed; --check still names it, files left where they are)"; exit 1; }
  # the detectors decide: an auto fix that left its line is a failure too (an open or declined one isn't)
  c2=$(bash "$0" --check 2>/dev/null); left=$(grep -E '^\[m[0-9]+ auto\] ' <<<"$c2")
  x=$(echo $open $declined $waiting | tr ' ' '|'); [ -z "$x" ] || [ -z "$left" ] || left=$(grep -vE "^\[($x) auto\] " <<<"$left")
  [ -z "$left" ] || { echo "stamp: not written, still found:"; sed 's/^/  /' <<<"$left"; exit 1; }
  [ -z "$open" ] || { echo "stamp: not yet (open:$open)"; exit 0; }
  [ -z "$waiting" ] || { echo "stamp: not yet (team PR open:$waiting)"; exit 0; }
  # a detector that couldn't look found nothing only by not looking: the stamp would end the checks for good
  um=$(grep '^unmeasured: ' <<<"$c2" | paste -sd';' -); [ -z "$um" ] || { echo "stamp: not yet ($um)"; exit 0; }
  dec=$(jq -c '.declined // []' "$stamp" 2>/dev/null); ver=$(jq -r .version "$LIB_DIR/.claude-plugin/plugin.json")
  mkdir -p "$P" && jq -n --argjson l "$LAYOUT" --arg v "$ver" --arg at "$(ts)" --argjson d "${dec:-[]}" \
    '{layout: $l, plugin: $v, at: $at, declined: $d}' > "$stamp.tmp" && mv "$stamp.tmp" "$stamp" || exit 1
  echo "stamp: layout $LAYOUT → $(tilde "$stamp")"; exit 0
fi
if [ "$state" = parent ]; then
  p=$(slug "$(basename "$parent")")-coordinator
  echo "This folder is inside $parent, whose coordinator ($p) covers it. Should it get a coordinator of its own"
  echo "(${name}-coordinator, its own adapter and files)? If so: session-status --init --own (proposal), then --write --own."
  exit 3
fi

# --- Move (--write --move): an older setup's files into the state folder P, the section lines after them ----------
# Each item keeps its name in P (replies: P/replies). Moved only from inside the root or the old state replies folder;
# a source elsewhere stays, and its section line (replies, memory, handoff) still moves, so the project gets its own
# files in P. Never moved: the committed config folder, or anything git tracks in the root's repo or one with a remote.
# All or nothing: any target in the way refuses the whole move. Then the plain --write runs (exec), on the new lines.
if [ -n "$move$link" ]; then
  [ "$mode" = write ] || { echo "--move and --link go with --write: session-status --init --write --move"; exit 2; }
  moves=() conflicts=() relines=() lrel=() left=() seen=$'\n' claimed=$'\n'
  case $hand_cfg in ""|"$P"/*) ;; *) [ ! -e "$hand_cfg" ] || left+=("$hand_cfg (config pending.file: it and its archive stay)") ;; esac
  rl() { relines+=("$s	$d"); [ "$k" = file ] || lrel+=("$s	$d"); }   # lrel: the section lines' own (line, mem)
  # pair SRC DST: a missing DST takes SRC whole, two folders go entry by entry, anything else in the way is a conflict
  pair() {
    if [ ! -e "$2" ] && [ ! -L "$2" ]; then
      case $claimed in *$'\n'"$2"$'\n'*) conflicts+=("$2 (two sources)"); return ;; esac
      claimed+="$2"$'\n'; moves+=("$1	$2")
    elif [ -d "$1" ] && [ ! -L "$1" ] && [ -d "$2" ] && [ ! -L "$2" ]; then
      local e; for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do [ -e "$e" ] || [ -L "$e" ] || continue; pair "$e" "$2/${e##*/}"; done
    else conflicts+=("$2")
    fi
  }
  for it in ${items[@]+"${items[@]}"}; do
    k=${it%%	*} s=${it#*	}
    case $seen in *$'\n'"$s"$'\n'*) continue ;; esac; seen+="$s"$'\n'
    d=$P/${s##*/}; [ -z "$replies" ] || [ "$s" != "$(at "$replies")" ] || d=$P/replies
    [ "$s" != "$d" ] || continue
    # outside: a memory file stays and its line moves (memory-init writes the project's own); a replies folder or
    # handoff file elsewhere is the person's choice (pending.file may be any path): both stay
    if ! inside "$s"; then
      case $k in
        mem) [ ! -e "$s" ] || left+=("$s (outside this project: its line moves to $d, the file stays)"); rl ;;
        line) [ ! -e "$s" ] || left+=("$s (outside this project: it and its line stay)") ;;
      esac; continue
    fi
    # inside a source that moves: it goes along, and its line follows that source's
    for mv in ${moves[@]+"${moves[@]}"}; do case $s in "${mv%%	*}"|"${mv%%	*}"/*) continue 2 ;; esac; done
    [ -e "$s" ] || [ -L "$s" ] || { [ "$k" = file ] || rl; continue; }
    why=$(stays "$s"); [ -z "$why" ] || { left+=("$s ($why)"); continue; }
    pair "$s" "$d"; rl
  done
  # the handoff line names the configured pending.file (a moved one too), not the path it had
  # (first, so it wins over a moving folder the old file was in; not in lrel: a tracked CLAUDE.md isn't refused for it)
  [ -z "$hand_cfg" ] || [ -z "$hline" ] || [ "$hline" = "$hand_cfg" ] || relines=("$hline	$hand_cfg" ${relines[@]+"${relines[@]}"})
  # The section files: CLAUDE.local.md, and CLAUDE.md unless git tracks it (a tracked one is never written).
  map=$(printf '%s\n' ${relines[@]+"${relines[@]}"})
  secs=(); [ ! -f "$root/CLAUDE.local.md" ] || secs+=("$root/CLAUDE.local.md")
  if [ -f "$root/CLAUDE.md" ]; then
    if git -C "$root" ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1; then
      bq "$root/CLAUDE.md" > "$root/CLAUDE.md.n" || exit 1
      tl=$(map=$(printf '%s\n' ${lrel[@]+"${lrel[@]}"}); rew "$root/CLAUDE.md.n" check); rm -f "$root/CLAUDE.md.n"   # the section's lines only, not prose
      [ -z "$move" ] || [ -z "$tl" ] || { echo "refused: the committed CLAUDE.md holds coordinator path lines; move them to CLAUDE.local.md first, then run this again:"; sed 's/^/  /' <<<"$tl"; exit 1; }
    else secs+=("$root/CLAUDE.md"); fi
  fi
  # The adapter's paths, quoted or not: its pending line cats the handoff, which would otherwise read a moved file.
  ad=$root/.claude/session-status-adapter; ads=
  if [ -f "$ad" ] && [ -n "$(RQ=word rew "$ad" check)" ]; then
    if git -C "$root" ls-files --error-unmatch .claude/session-status-adapter >/dev/null 2>&1; then
      [ -z "$move" ] || { echo "refused: the committed .claude/session-status-adapter names files this would move; point it into $P first, then run this again:"; RQ=word rew "$ad" check | sed 's/^/  /'; exit 1; }
    else ads=1; fi
  fi
  if [ -n "$move" ] && [ "${#conflicts[@]}" -gt 0 ]; then   # --link alone moves nothing: nothing to refuse
    echo "refused: these are in $P already, so nothing was moved (move or merge them by hand, then run this again):"
    printf '  %s\n' "${conflicts[@]}"; exit 1
  fi
  if [ -n "$move" ]; then
    if [ "${#moves[@]}" = 0 ] && [ "${#relines[@]}" = 0 ]; then
      if [ "${#left[@]}" = 0 ]; then echo "Move: nothing to move (everything is in $P)"; else echo "Move: nothing to move"; fi
    else
      echo "Moved to $P:"
      failed= i=0
      for mv in ${moves[@]+"${moves[@]}"}; do
        s=${mv%%	*} d=${mv#*	}
        mkdir -p "$(dirname "$d")" && mv "$s" "$d" || { failed="$s → $d"; break; }
        echo "  $s → $d"; i=$((i + 1))
      done
      # A move that failed midway: the lines still follow the moves done, not the sources left (or a folder that
      # moves entry by entry with entries left), so a second run finds each file where its line says.
      if [ -n "$failed" ]; then
        keep=()
        for r in ${relines[@]+"${relines[@]}"}; do
          rs=${r%%	*}
          for mv in "${moves[@]:$i}"; do case ${mv%%	*} in "$rs"|"$rs"/*) continue 2 ;; esac; done
          keep+=("$r")
        done
        map=$(printf '%s\n' ${keep[@]+"${keep[@]}"})
      fi
      for f in ${secs[@]+"${secs[@]}"}; do
        bq "$f" > "$f.n" || { rm -f "$f.n"; exit 1; }
        [ -n "$(rew "$f.n" check)" ] || { rm -f "$f.n"; continue; }
        rew "$f.n" > "$f.tmp" && rm -f "$f.n" && mv "$f.tmp" "$f" || { rm -f "$f.n" "$f.tmp"; exit 1; }; echo "  lines in ${f#"$root"/} rewritten"
      done
      if [ -n "$ads" ] && [ -n "$(RQ=word rew "$ad" check)" ]; then
        RQ=word rew "$ad" > "$ad.tmp" && chmod +x "$ad.tmp" && mv "$ad.tmp" "$ad" || exit 1; echo "  paths in .claude/session-status-adapter rewritten"
      fi
      # emptied folders go, up to the root
      for mv in ${moves[@]+"${moves[@]:0:$i}"}; do   # only the ones that moved: a kept line may name an empty source
        s=${mv%%	*}; [ ! -d "$s" ] || find "$s" -depth -type d -empty -delete 2>/dev/null
        d=$(dirname "$s"); while case $d in "$root"/*|"$oldrep") true ;; *) false ;; esac && rmdir "$d" 2>/dev/null; do d=$(dirname "$d"); done
      done
      [ -z "$failed" ] || { echo "move failed: $failed (the ones above moved and their lines follow; run this again for the rest)"; exit 1; }
    fi
    [ "${#left[@]}" = 0 ] || { echo "Left where they are:"; printf '  %s\n' "${left[@]}"; }
    for o in "${mem:+$(at "$mem")}" "${hand:+$(dirname "$hand")}"; do
      case $o in "$root"/*) [ -d "$o" ] && [ -n "$(ls -A "$o")" ] && echo "Still in ${o#"$root"/}: $(ls -A "$o" | paste -sd' ' -)" ;; esac
    done | sort -u
  fi
  if [ -n "$link" ]; then
    if [ "$(readlink "$root/.coordinator" 2>/dev/null)" = "$P" ]; then :
    elif [ -e "$root/.coordinator" ] || [ -L "$root/.coordinator" ]; then echo "--link: $root/.coordinator exists already and isn't a link to $P: left alone"
    else
      mkdir -p "$P" && ln -s "$P" "$root/.coordinator" && echo "Linked: .coordinator → $P" || exit 1
      if [ -n "$top0" ]; then
        ex=$(git -C "$root" rev-parse --git-path info/exclude); case $ex in /*) ;; *) ex=$root/$ex ;; esac
        r=${root#"$top0"}; r=${r#/}; f="/${r:+$r/}.coordinator"
        mkdir -p "$(dirname "$ex")" && { grep -qxF "$f" "$ex" 2>/dev/null || echo "$f" >> "$ex"; }
      fi
    fi
  fi
  [ -z "${SI_MIGRATE:-}" ] || exit 0   # --migrate's m7: the move only, no plain --write (unset keys stay defaults)
  exec bash "$0" "${rest[@]}"
fi

# --- Facts -------------------------------------------------------------------------------------------------------
top=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null) && top=$(cd "$top" && pwd -P)
if [ -n "$top" ]; then repos=("$top"); layout="one repo"
else
  repos=(); while IFS= read -r g; do repos+=("$(cd "${g%/.git}" && pwd -P)"); done < <(cd "$root" && find . -mindepth 2 -maxdepth 3 -name .git 2>/dev/null | sed "s#^\.#$root#" | sort)
  layout="workspace of ${#repos[@]} repos"
fi
first=${repos[0]:-}
url=; [ -n "$first" ] && url=$(git -C "$first" config --get remote.origin.url 2>/dev/null)   # as configured, not insteadOf-rewritten
case $url in
  *github.com*) host=github ;; *bitbucket*) host=bitbucket ;; *forgejo*) host=forgejo ;; *gitlab*) host=gitlab ;; *) host=none ;;
esac
cfg_host=$host cfg_note=   # the config's host: GitLab isn't one yet (TODO: GitLab support)
[ "$host" = gitlab ] && cfg_host=none cfg_note=" (host=none: GitLab support is a TODO)"
repo_slug=$(url_slug "$url")
gh=; [ "$host" = github ] && command -v gh >/dev/null && gh=1
# The briefs' commands: a PR merge and a review post, by code host; `retro.py units` counts these by default
# (TODO: gitlab's are unchecked).
case $host in
  github) merge_cmd="gh pr merge" post_cmd="gh pr review" ;;
  bitbucket) merge_cmd="bitbucketdc-cli pr merge" post_cmd="bitbucketdc-cli pr comment create" ;;
  forgejo) merge_cmd="forgejo-cli pr merge" post_cmd="forgejo-cli pr comment create" ;;
  gitlab) merge_cmd="glab mr merge" post_cmd="glab mr note" ;;
  *) merge_cmd= post_cmd= ;;
esac
default_branch=
[ -n "$first" ] && default_branch=$(git -C "$first" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && default_branch=${default_branch#origin/}
if [ -z "$default_branch" ]; then
  default_branch=main
  [ -n "$first" ] && ! git -C "$first" rev-parse -q --verify main >/dev/null && git -C "$first" rev-parse -q --verify master >/dev/null && default_branch=master
fi

# Task keys: the commonest tracker prefix over the last 200 commit subjects and the remote branches, if it's in 20%.
words=$(for r in ${repos[@]+"${repos[@]}"}; do git -C "$r" log --format=%s -200 2>/dev/null; git -C "$r" branch -r --format='%(refname:short)' 2>/dev/null; done)
total=$(grep -c . <<<"$words")
best=$(grep -oE '\b[A-Z][A-Z0-9]+-[0-9]+' <<<"$words" | sed 's/-[0-9]*$//' | sort | uniq -c | sort -rn | head -1)
prefix=${best##* }
share=0; [ "$total" -gt 0 ] && [ -n "$prefix" ] && share=$(( $(grep -cE "\b$prefix-[0-9]+" <<<"$words") * 100 / total ))
issues=0; [ "$total" -gt 0 ] && issues=$(( $(grep -cE '#[0-9]+' <<<"$words") * 100 / total ))
if [ "$share" -ge 20 ]; then
  keys=tracker key_re="$prefix-[0-9]+" key_example="$prefix-123" key_note="$prefix-123 (in $share% of commits and branches)"
else
  keys=session key_re="$name-[a-z0-9]+(-[a-z0-9]+)*" key_example="$name-<short-desc>"
  key_note="session names, $name-<short-desc> (no tracker key in 20% of commits and branches${prefix:+; the commonest, $prefix, is in $share%})"
  [ "$host" = github ] && [ "$issues" -ge 20 ] && key_note="$key_note; #N issue references are in $issues%, which session names don't track"
fi
# The tracker's ticket URL, from the project's docs.
tracker_url=
if [ "$keys" = tracker ]; then
  docs=$(cd "$root" && { ls CLAUDE.md CLAUDE.local.md README* 2>/dev/null; find docs -name '*.md' 2>/dev/null | head -200; })
  tracker_url=$(cd "$root" && [ -n "$docs" ] && grep -hoE "https?://[^ )>\"'\`]+/browse/$prefix-" $docs 2>/dev/null | head -1 | sed 's#/browse/.*#/browse/{key}#')
  [ -n "$tracker_url" ] || tracker_url=$(cd "$root" && [ -n "$docs" ] && grep -hoE "https://linear\.app/[^/ ]+/issue/$prefix-" $docs 2>/dev/null | head -1 | sed 's#/issue/.*#/issue/{key}#')
fi
# The config's tracker: jira for tracker keys, github for #N issue refs on GitHub, else none. Linear isn't one yet.
tracker=none
if [ "$keys" = tracker ]; then
  case $tracker_url in *linear.app*) cfg_note="$cfg_note (tracker=none: Linear support is a TODO)" ;; *) tracker=jira ;; esac
elif [ "$host" = github ] && [ "$issues" -ge 20 ]; then tracker=github; fi
# Branches: the commonest shape among remote branches.
br=$(for r in ${repos[@]+"${repos[@]}"}; do git -C "$r" branch -r --format='%(refname:short)' 2>/dev/null; done | sed 's#^[^/]*/##' | grep -v '^HEAD$')
if [ "$keys" = tracker ]; then
  shape=$(grep -oE "^([a-z]+/)?$prefix-[0-9]+" <<<"$br" | sed -E "s#$prefix-[0-9]+##" | sort | uniq -c | sort -rn | head -1 | awk '{print $2}')
  branch_pattern="${shape}$prefix-123-<desc>"
else branch_pattern="<key>"; fi
# Worktrees: a script CLAUDE.md names, an existing .worktrees/, else EnterWorktree (one repo) or git worktree add.
worktree_cmd= worktree_line=
script=$(cd "$root" && grep -hoE '[~/A-Za-z0-9_.-]*-wt\b' CLAUDE.md CLAUDE.local.md 2>/dev/null | head -1)
if [ -n "$script" ]; then worktree_cmd="$script <key>" worktree_line=1
elif [ "${#repos[@]}" = 0 ]; then worktree_cmd="none (no git repo here)"
elif [ "${#repos[@]}" -gt 1 ] || [ -d "$first/.worktrees" ]; then
  worktree_cmd="git -C <repo> worktree add <repo>/.worktrees/<branch>" worktree_line=1
else worktree_cmd="EnterWorktree (under .claude/worktrees/)"; fi
# Where things go: the section in CLAUDE.local.md when CLAUDE.md is tracked; the files in the state folder P.
section_file=CLAUDE.md
[ -n "$top" ] && git -C "$root" ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1 && section_file=CLAUDE.local.md
urls=-   # built after the corrections, from a corrected repo_slug or tracker_url too, unless urls itself is given

# A committed repo file answers the repo keys, in every mode (an explicit tracker= / host= below still wins).
if [ -n "$repo_tracked" ]; then
  x=$(jq -r '.tracker // empty' "$cfg_repo" 2>/dev/null); [ -z "$x" ] || tracker=$x
  x=$(jq -r '.host // empty' "$cfg_repo" 2>/dev/null); [ -z "$x" ] || cfg_host=$x
fi
# Corrections from the reply: KEY=VALUE.
for kv in ${over[@]+"${over[@]}"}; do
  k=${kv%%=*} v=${kv#*=}
  case $k in
    name|key_re|key_example|tracker_url|default_branch|branch_pattern|worktree_cmd|section_file|orch|urls|repo_slug|merge_cmd|post_cmd|tracker|team) printf -v "$k" '%s' "$v" ;;
    host) cfg_host=$v ;;
    terminal) term_found=$v term_note= ;;
    *) echo "unknown fact: $k (one of name key_re key_example tracker_url default_branch branch_pattern worktree_cmd section_file orch urls repo_slug merge_cmd post_cmd tracker host terminal team)"; exit 2 ;;
  esac
done
if [ "$urls" = - ]; then
  urls=
  [ -n "$tracker_url" ] && urls="'ticket $tracker_url'"
  [ "$host" = github ] && [ -n "$repo_slug" ] && urls="${urls:+$urls }'pr https://github.com/${repo_slug%/*}/{repo}/pull/{id}'"
fi
enc_root=$(enc_path "$root")
# A task session isolated in a worktree can't write into its repo's checkout, so the replies folder lives outside
# every checkout, in P. An existing section's path wins.
replies_dir=$P/replies
[ -z "$replies" ] || replies_dir=${replies%/}
# A memory folder outside this project and not P (a parent project's) isn't written: --move gives it its own.
mem_out=; case $(at "$orch")/ in "$root"/*|"$P"/*) ;; *) mem_out=1 ;; esac
# The handoff file the section and adapter name: the one config or the section names, else beside the memory.
handoff=${hand:-$orch/pending.md}
# The review brief's folder: the memory's (orch), or P when that memory is outside this project; the handoff file's
# when the section names one (not config pending.file) in this project or P.
bo=$orch; [ -z "$mem_out" ] || bo=$P
bd=$bo; [ -z "$hand" ] || [ -n "$hand_cfg" ] || case $(dirname "$hand")/ in "$root"/*|"$P"/*) bd=$(dirname "$hand") ;; esac
done_rule="its session's done-when held (no command to count)"
[ -n "$merge_cmd" ] && done_rule="its PR merged (the merge is the unit)"
[ "$keys" = tracker ] && done_rule="its $key_example ticket moved to done (pass that command's regex as \`--done RX\`)"
# The retro brief the retro skill reads: beside the memory (not one left outside), else .claude/ (older setups).
rb=$(retro_brief "$orch")
# A brief the section names counts as present.
briefs=$( [ -n "$review_brief$named_brief" ] || [ -e "$(at "$bd")/review-brief.md" ] || echo "--review-brief: a brief for PR reviewer sessions ($bd/review-brief.md)"
          [ -n "$retro_brief$rb" ] || if [ -n "$mem_out" ]; then echo "--retro-brief: what the weekly retro counts ($P/retro-brief.md, once --move gives this project its own memory there)"
          else echo "--retro-brief: what the weekly retro counts ($orch/retro-brief.md)"; fi)
# Shared mode's repo (the team's in a workspace), its default branch, and the team PR's branch and worktree.
# The repo holding the repo file's folder (a team recorded in coordination.local.json too), else the team's, else here.
td=$(dirname "$cfg_repo")
trepo=$(for d in "$td" "$root/$team"; do (cd "$d" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) && break; done)
[ -z "$trepo" ] || { trepo=$(cd "$trepo" && pwd -P); [ ! -d "$td" ] || td=$(cd "$td" && pwd -P); }
tdb=$default_branch   # the team repo's own, unless default_branch= was said
if [ -n "$trepo" ] && [[ " ${over[*]-} " != *" default_branch="* ]]; then
  tdb=$(git -C "$trepo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && tdb=${tdb#origin/} ||
    { tdb=main; git -C "$trepo" rev-parse -q --verify origin/main >/dev/null || ! git -C "$trepo" rev-parse -q --verify origin/master >/dev/null || tdb=master; }
fi
tb=coordination/setup-$(date +%F) wt=$trepo/.worktrees/coordination/setup-$(date +%F)
trel=${td#"$trepo"/}
# The team memory: memory.md (the prune PR's lines) and memory/*.md.
gattr="/$trel/memory.md merge=union
/$trel/memory/*.md merge=union"
# --- Team memory (--team-memory): the prune's gather -------------------------------------------------------------
# The [team] entry lines of the person's memory (P's memory.md, a flat one's lines to misc.md, and memory/<topic>.md)
# go, verbatim, to the same topic in the team folder (T/memory/<topic>.md, T/memory.md its index), in a worktree from
# origin/<default> on coordination/memory-<date>-<time>: deduped, scrubbed (a refused line stays in P, named), one commit
# and a Team PR line for one pane ask. A line leaves P only once origin/<default>'s team memory has it (the PR
# merged, or a teammate carried the same line); a gather branch of this clone that isn't merged yet is the one open
# team PR: nothing new is opened meanwhile. merge=union on the topic files lets two people's PRs rebase cleanly.
if [ "$mode" = team_memory ]; then
  mdir=$(at "$orch")
  [ -z "$dry" ] || { echo "--team-memory has no --dry-run"; exit 2; }
  [ -z "$newer" ] || { echo "refused: $newer"; exit 1; }
  [ -n "$trepo" ] || { echo "refused: --team-memory needs a git repo for the team files"; exit 1; }
  case $trel in /*) echo "refused: --team-memory: the repo file's folder ($trel) is outside $trepo"; exit 1 ;; esac
  GIT_TERMINAL_PROMPT=0 git -C "$trepo" fetch -q origin "$tdb" 2>/dev/null   # best effort: offline, the origin/$tdb fetched last
  git -C "$trepo" cat-file -e "origin/$tdb:$trel/coordination.json" 2>/dev/null ||
    { echo "refused: --team-memory: origin/$tdb has no $trel/coordination.json (no shared mode: session-status --init --write --shared): [team] lines stay in your memory"; exit 1; }
  # carried: the entry lines origin/<default>'s team memory has (the index too: older gathers added them there)
  carried=$(git -C "$trepo" ls-tree -r --name-only "origin/$tdb" -- "$trel/memory.md" "$trel/memory/" |
    while IFS= read -r f; do git -C "$trepo" show "origin/$tdb:$f"; done | grep '^- ')
  # notin TEXT: the lines of stdin not in TEXT
  notin() { grep -vxF -f <(printf '%s\n' "$1") || :; }
  tagged='^- [^:]*: \[team\] '   # the tag where memory-rules puts it: `- <date> <TASK>: [team] …`
  srcs=(); [ ! -f "$mdir/memory.md" ] || srcs+=("$mdir/memory.md")
  for f in "$mdir"/memory/*.md; do [ -f "$f" ] && srcs+=("$f"); done
  # 1. This clone's earlier gather branches: merged (every entry line it adds is, or once was, on origin/<default>: a
  # rebase merge rewrites SHAs, union may reorder, a later prune may drop a line) goes, its lines counted as carried;
  # else it's the open team PR.
  git -C "$trepo" worktree prune 2>/dev/null
  while IFS= read -r B; do
    [ -n "$B" ] || continue
    add=$(git -C "$trepo" diff "origin/$tdb...$B" -- "$trel" | sed -n 's/^+- /- /p')
    hist=$(git -C "$trepo" log -p --format= "origin/$tdb" -- "$trel" | sed -n 's/^+- /- /p')
    if [ -n "$(notin "$carried"$'\n'"$hist" <<<"$add")" ]; then
      drop="git -C $trepo worktree remove --force $trepo/.worktrees/$B; git -C $trepo branch -D $B"
      if [ -z "$(git -C "$trepo" config --get "branch.$B.remote")" ]; then
        echo "Team memory branch not pushed: $B (the pane ask said no?): push it and open its PR (git -C $trepo/.worktrees/$B show), or drop it ($drop); no new one meanwhile."
      elif GIT_TERMINAL_PROMPT=0 git -C "$trepo" ls-remote --exit-code --heads origin "$B" >/dev/null 2>&1; [ $? = 2 ]; then
        echo "Team PR gone from origin: $B (merged with edits, or closed): the lines it adds that origin/$tdb never had stay in your memory; reword or untag them there, then drop the branch ($drop)."
      else
        echo "Team PR open: $B: its lines leave your memory once it merges and this runs again; no new one meanwhile. Not merging it: close the PR and drop the branch ($drop; git -C $trepo push origin --delete $B)"
      fi
      exit 0
    fi
    carried+=$'\n'$add
    git -C "$trepo" worktree remove --force "$trepo/.worktrees/$B" >/dev/null 2>&1; git -C "$trepo" branch -q -D "$B" >/dev/null 2>&1
  done < <(git -C "$trepo" for-each-ref --format='%(refname:short)' 'refs/heads/coordination/memory-*')
  # 2. Carried lines leave P. shortcut: a session's append in the instant between the grep and the mv is lost; a
  # lock would need every appender to take it.
  gone=0
  for f in ${srcs[@]+"${srcs[@]}"}; do
    d=$(grep "$tagged" "$f" | grep -xF -f <(printf '%s\n' "$carried")) || continue
    { grep -vxF -f <(printf '%s\n' "$d") "$f" || :; } > "$f.tmp" && mv "$f.tmp" "$f" || { echo "refused: rewriting $f failed"; exit 1; }
    gone=$((gone + $(wc -l <<<"$d")))
  done
  [ "$gone" = 0 ] || echo "Carried: $gone [team] line(s) landed on origin/$tdb, removed from your memory."
  # 3. The rest: TOPIC<tab>LINE each, deduped; a line the scrub refuses stays in P.
  todo= kept=
  for f in ${srcs[@]+"${srcs[@]}"}; do
    t=${f##*/}; [ "$f" != "$mdir/memory.md" ] || t=misc.md
    while IFS= read -r l; do
      [ -n "$l" ] || continue
      bad=$(team_scrub "memory/$t" "$l")
      if [ -n "$bad" ]; then kept+=$(sed 's/^[^:]*:[0-9]*: /  /' <<<"$bad")$'\n'; else todo+="$t	$l"$'\n'; fi
    done < <(grep "$tagged" "$f" | notin "$carried")
  done
  todo=$(printf '%s' "$todo" | awk '!s[$0]++')
  [ -z "$kept" ] || printf 'Kept in your memory (reword or untag them; the scrub refuses them for a team file):\n%s' "$kept"
  [ -n "$todo" ] || { echo "Team memory: nothing to carry."; exit 0; }
  # to the second: an earlier gather's branch may still be on origin after its merge
  tb=coordination/memory-$(date +%F-%H%M%S); wt=$trepo/.worktrees/$tb
  # --no-track: an upstream set only by the Team PR line's push -u tells step 1 the branch was pushed
  git -C "$trepo" worktree add -q --no-track -b "$tb" "$wt" "origin/$tdb" 2>&1 || { echo "Team memory: git worktree add failed: no team PR"; exit 1; }
  tex=$(git -C "$trepo" rev-parse --git-path info/exclude); case $tex in /*) ;; *) tex=$trepo/$tex ;; esac
  (cd "$trepo" && git check-ignore -q .worktrees/x) || echo /.worktrees/ >> "$tex"   # the main checkout stays clean
  tfail() { echo "Team memory: $1: no team PR"; git -C "$trepo" worktree remove --force "$wt"; git -C "$trepo" branch -q -D "$tb"; exit 1; }
  ti=$wt/$trel/memory.md
  if [ ! -f "$ti" ]; then mkdir -p "$wt/$trel" && cp "$tpl/team-memory.md" "$ti" || tfail "writing $trel/memory.md failed"; fi
  topics=$(cut -f1 <<<"$todo" | sort -u)
  while IFS= read -r t; do
    tf=$wt/$trel/memory/$t src=$mdir/memory/$t
    if [ ! -f "$tf" ]; then
      # the person's topic header (title, trigger), as written by memory-init: the same text in every clone, so two
      # people's first gathers of a topic merge to one header
      h1=$(grep -m1 '^# ' "$src" 2>/dev/null) rw=$(grep -m1 '^> \*\*Read when\*\*: ' "$src" 2>/dev/null)
      [ "$t" != misc.md ] || [ -n "$h1" ] || { h1='# Memory: everything else' rw='> **Read when**: nothing else fits.'; }
      [ -n "$h1" ] && [ -n "$rw" ] && [ -z "$(team_scrub x "$h1"$'\n'"$rw")" ] || { h1="# Memory: ${t%.md}" rw="> **Read when**: ${t%.md}."; }
      mkdir -p "${tf%/*}" && printf '%s\n\n%s\n' "$h1" "$rw" > "$tf" || tfail "writing $trel/memory/$t failed"
    fi
    [ -z "$(tail -c1 "$tf")" ] || echo >> "$tf"
    awk -F'\t' -v t="$t" '$1 == t' <<<"$todo" | cut -f2- >> "$tf" || tfail "writing $trel/memory/$t failed"
    # union merges can repeat a line: each one once (blank lines stay)
    awk 'NF == 0 || !s[$0]++' "$tf" > "$tf.tmp" && mv "$tf.tmp" "$tf" || tfail "deduping $trel/memory/$t failed"
    # its index row, rows sorted by name (a table added at the end of an index that has none, a flat older one)
    grep -qF "| \`$t\` |" "$ti" && continue
    rw=$(sed -n 's/^> \*\*Read when\*\*: \(.*\)\.$/\1/p' "$tf" | head -1)
    grep -q '^| Topic file' "$ti" || printf '\n| Topic file (`memory/`) | Read when |\n|------------------------|-----------|\n' >> "$ti"
    h=$(awk '/^\| Topic file/ { t = NR; next } t && NR == t + 1 && /^\|-/ { print NR; exit }' "$ti")
    [ -n "$h" ] || tfail "$trel/memory.md has no separator row under its | Topic file header"
    n=$(awk -v h="$h" 'NR > h && /^\| `/ { c++; next } NR > h { exit } END { print c + 0 }' "$ti")
    { head -n "$h" "$ti"; { [ "$n" = 0 ] || sed -n "$((h + 1)),$((h + n))p" "$ti"; echo "| \`$t\` | ${rw:-${t%.md}} |"; } | LC_ALL=C sort
      tail -n +"$((h + n + 1))" "$ti"; } > "$ti.tmp" && mv "$ti.tmp" "$ti" || tfail "writing $trel/memory.md failed"
  done <<<"$topics"
  ga_old=$(git -C "$trepo" show "origin/$tdb:.gitattributes" 2>/dev/null)
  ga_need=$(while IFS= read -r l; do grep -qxF -- "$l" <<<"$ga_old" || echo "$l"; done <<<"$gattr")
  if [ -n "$ga_need" ]; then
    [ ! -s "$wt/.gitattributes" ] || [ -z "$(tail -c1 "$wt/.gitattributes")" ] || echo >> "$wt/.gitattributes"
    printf '%s\n' "$ga_need" >> "$wt/.gitattributes" || tfail "writing .gitattributes failed"
  fi
  git -C "$wt" add -f -- "$trel/memory.md" "$trel/memory" .gitattributes || tfail "git add failed"
  bad=$(team_scrub "$tb" "$(git -C "$wt" diff --cached -U0 | sed -n '/^+++ /d; s/^+//p')")
  [ -z "$bad" ] || { echo "refused: $tb would put personal details in a team file:"; sed 's/^/  /' <<<"$bad"; tfail "scrub"; }
  nl=$(wc -l <<<"$todo" | tr -d ' ')
  tmsg="coordination: team memory ($nl line(s): $(paste -sd, - <<<"$topics" | sed 's/,/, /g'))"
  git -C "$wt" commit -q -m "$tmsg" || tfail "the commit in $wt failed"
  turl=$(git -C "$trepo" config --get remote.origin.url) pr="git -C $wt push -u origin $tb" prnote=
  case $turl in   # as configured, not insteadOf-rewritten: what gh resolves
    *github.com*) pr+=" && gh pr create -R $(url_slug "$turl") --base $tdb --head $tb --title '$tmsg' --body 'Team memory: [team] lines from project memory, for every collaborator; the gather removes them from personal memory once this merges.'" ;;
    *) prnote="Then open a PR from $tb into $tdb on the code host." ;;
  esac
  echo "Team memory: $nl line(s) committed on $tb ($wt):"
  cut -f1 <<<"$todo" | sort | uniq -c | while read -r c t; do echo "  $trel/memory/$t: $c"; done
  [ -z "$ga_need" ] || echo "  .gitattributes: merge=union for team memory"
  echo "Team PR: show its diff in one pane ask (git -C $wt show), then on yes: $pr"
  [ -z "$prnote" ] || echo "$prnote"
  exit 0
fi
# The team section: claude-section.md's rule lines (team_sec) in the committed CLAUDE.md. Once this checkout's
# CLAUDE.md has it, the personal section keeps only its own lines (local_sec): the coordinator, replies, memory,
# handoff; until the team PR merges it stays whole, so no session goes without the rules. Shared mode adds it in one
# repo only (a workspace's sessions start above the team repo and wouldn't read its CLAUDE.md), and the personal
# section then goes to CLAUDE.local.md, unless section_file= was said.
team_sec= local_sec= tsec_need= srel=
if [ -n "$top" ]; then
  srel=${root#"$top"}; srel=${srel#/}; srel=${srel:+$srel/}
  git -C "$root" ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1 && grep -qxF "$team_head" "$root/CLAUDE.md" && local_sec=1
  if [ -n "$shared" ] && [ "$trepo" = "$top" ]; then
    tsec_need=1; [[ " ${over[*]-} " == *" section_file="* ]] || section_file=CLAUDE.local.md
  fi
fi
# tsec_missing: origin/<default>'s CLAUDE.md lacks the team section
tsec_missing() { ! git -C "$trepo" show "origin/$tdb:${srel}CLAUDE.md" 2>/dev/null | grep -qxF "$team_head"; }
[ -z "$tsec_need" ] || tsec_missing || tsec_need=
# key_pattern isn't written: the adapter answers it for session keys, and a tracker key's prefix would narrow the
# default PROJ-123 pattern. It's the user's override only.
# The features: the review inbox where the project names one (Bitbucket or Forgejo), accounts with a second one.
review_inbox=false
[ -z "$inbox" ] || { case $cfg_host in bitbucket|forgejo) review_inbox=true ;; *) cfg_note="$cfg_note (review inbox found: off, it needs host=bitbucket or forgejo; GitHub support is a TODO)" ;; esac; }
accounts=false; [ "$accounts_n" -lt 2 ] || accounts=true
cfg_repo_json=$(jq -cn --arg t "$tracker" --arg h "$cfg_host" --argjson r "$review_inbox" '{tracker: $t, host: $h, features: {review_inbox: $r}}')
# approvals.delegate: true with --delegate (over a value set too, below); false when unset, unless CLAUDE.md still
# delegates in words: then it stays unset without --delegate, as false would revoke that unasked.
deleg=null; [ -n "$deleg_line" ] || deleg=false; [ -z "$delegate" ] || deleg=true
cfg_person_json=$(jq -cn --argjson a "$accounts" --argjson d "$deleg" --arg t "$term_found" --arg team "$team" '{features: {accounts: $a}} + if $t == "plain" then {} else {terminal: $t} end + if $d == null then {} else {approvals: {delegate: $d}} end + if $team == "" then {} else {team: $team} end')
# FILE JSON [--write]: the keys of JSON the file doesn't have yet (an existing value is the user's), as `k=v …`;
# --write adds them.
missing_keys() {
  local old='{}' add
  [ ! -e "$1" ] || old=$(jq -c . "$1") || return 1
  add=$(jq -cn --argjson o "$old" --argjson n "$2" 'reduce ($n | paths(type != "object")) as $p ({}; if ($o | getpath($p)) == null then setpath($p; $n | getpath($p)) else . end)')
  [ "$add" != '{}' ] || return 0
  jq -rn --argjson a "$add" '[$a | paths(type != "object") as $p | "\($p | join("."))=\($a | getpath($p))"] | join(" ")'
  [ "${3:-}" != --write ] || { mkdir -p "$(dirname "$1")" && jq --argjson a "$add" '. * $a' <<<"$old" > "$1.tmp" && mv "$1.tmp" "$1"; }
}
miss_repo=; [ -n "$repo_tracked" ] || miss_repo=$(missing_keys "$cfg_repo" "$cfg_repo_json")
miss_person=$(missing_keys "$cfg_person" "$cfg_person_json")
[ -z "$repo_tracked" ] || cfg_note="$cfg_note (repo keys: the committed ${cfg_repo#"$root"/})"
# The trust round and shared mode, the same lines in both proposals (each ending in its newline).
shared_lines=
[ -z "$team" ] || shared_lines+="   Team: $team/.claude/coordination/ is committed there, so its repo keys apply here (team=$team)."$'\n'
[ "${#team_found[@]}" -lt 2 ] || shared_lines+="   Team: ${team_found[*]} each commit .claude/coordination/: say team=<folder> to use one."$'\n'
if [ "${#review[@]}" -gt 0 ]; then
  shared_lines+="   Committed code to review: it runs on your machine only once you trust it. Read each file first:"$'\n'
  for t in "${review[@]}"; do shared_lines+="     ${sd#"$root"/}/${t%@*} (sha256 ${t##*@})"$'\n'; done
  shared_lines+="   To trust them as they are now: --trust=$(sed 's/ / --trust=/g' <<<"${review[*]}")$( [[ " ${review[*]} " == *" session-status-adapter@"* ]] && [ -z "$(adapter_path "$root" 2>/dev/null)" ] && printf ' (the committed adapter is then used, no local one written)')"$'\n'
fi
[ -z "$shared" ] || shared_lines+="   Shared (a team PR, read by every collaborator once merged): $([ -n "$repo_tracked" ] && printf '%s is committed already, so only ' "$trel/coordination.json" || printf '%s (repo keys only: tracker, host, features.review_inbox) and ' "$trel/coordination.json")the .gitattributes line $gattr$([ -n "$tsec_need" ] && printf ', and a team section "%s" in %sCLAUDE.md (approvals, reserved actions, task names, worktrees; no paths or names)' "${team_head#\#\# }" "$srel"), committed on $tb in a worktree from origin/$tdb. Personal (out of git, this machine only): everything else here."$'\n'
# A newcomer's clone: the committed repo file answers the repo keys, so none is asked; the team files found are named.
if [ -n "$repo_tracked" ] && [ "$state" != configured ] && [ "$mode" = propose ]; then
  tfl=(); for x in "memory.md memory:memory" review-brief.md:review-brief session-status-adapter:adapter; do
    [ -z "$(git -C "$(dirname "$cfg_repo")" ls-files -- ${x%%:*} 2>/dev/null | head -1)" ] || tfl+=("${x#*:}"); done
  ! git -C "$root" ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1 || ! grep -qxF "$team_head" "$root/CLAUDE.md" || tfl+=(section)
  shared_lines+="   Shared coordination found: ${cfg_repo#"$root"/} is committed (team files: ${tfl[*]:-none besides it}), so its repo keys apply as they are and none is asked. Yours: trust, delegation, terminal; written out of git, nothing tracked."$'\n'
fi
# --plugin (with --shared): .claude/settings.json in the team PR enables the plugin for whoever trusts the folder.
sjs=.claude/settings.json plug_need=
if [ -n "$plugin" ] && [ -n "$shared" ] && [ -n "$trepo" ]; then
  git -C "$trepo" show "origin/$tdb:${srel}$sjs" 2>/dev/null | jq -e '.enabledPlugins["session-orchestration@session-orchestration"] == true' >/dev/null 2>&1 || plug_need=1
fi
[ -z "$shared" ] || [ -n "$plugin" ] || shared_lines+="   Option: add --plugin to also commit .claude/settings.json enabling this plugin for the team (off by default: it offers the plugin to every collaborator)."$'\n'
[ -z "$plug_need" ] || shared_lines+="   Plugin: ${srel}$sjs enables session-orchestration@session-orchestration and adds its marketplace, in the same team PR."$'\n'
cfg_line="tracker=$tracker host=$cfg_host features.review_inbox=$review_inbox features.accounts=$accounts terminal=$term_found$cfg_note$term_note"
if [ "$state" = configured ] && [ "$mode" = propose ]; then
  if [ -z "$miss_repo$miss_person$shared_lines" ] && [ -n "$deleg_set" ]; then
    echo "This folder is set up for coordination already ($root, ${name}-coordinator): nothing to propose."
  else
    echo "This folder is set up for coordination already ($root, ${name}-coordinator), but its config isn't recorded:"
    [ -z "$miss_repo" ] || echo "  $miss_repo$cfg_note → .claude/coordination/coordination.json"
    [ -z "$miss_person" ] || echo "  $miss_person → .claude/coordination.local.json"
    [ -n "$deleg_set" ] || [ -z "$deleg_line" ] || echo "  approvals.delegate=true (CLAUDE.md delegates; write with --delegate) → .claude/coordination.local.json"
    printf '%s' "$shared_lines"
    echo "  Write: session-status --init --write$([ -n "$deleg_line" ] && printf ' --delegate')${shared:+ --shared} [--trust=…] [KEY=VALUE…]"
  fi
  [ -z "$briefs" ] || { echo "Optional, on request (session-status --init --write FLAG):"; sed 's/^/  /' <<<"$briefs"; }
  exit 0
fi

# --- Plan: each file, written only if it's missing --------------------------------------------------------------
plan=()   # "template<TAB>target"
[ -n "$replies" ] || plan+=("claude-section.md	$section_file")
# One GitHub repo with gh: the adapter that puts its PRs in the pane. Else the minimal one (pending, keys, links).
adapter_tpl=session-status-adapter; [ -n "$gh" ] && [ "${#repos[@]}" = 1 ] && adapter_tpl=github-adapter
[ -n "$adapter$noexec" ] || plan+=("$adapter_tpl	.claude/session-status-adapter")
# The handoff file: the one config or the section names, else beside the memory (not in a memory folder left outside).
[ -n "$hand" ] || [ -z "$mem_out" ] && plan+=("pending.md	$handoff")
# The project memory (index and topic files): project-memory's memory-init writes what's missing.
meminit=$(pm_dir)/skills/project-memory/memory-init || exit 1
mem_args=("$orch" --root "$root" --topic coordinator.md "coordinating sessions" "acting as the coordinator, or messaging, resuming or handing work to another session")
[ -z "$review_brief" ] || [ -n "$named_brief" ] || plan+=("review-brief.md	$bd/review-brief.md")
[ -z "$retro_brief" ] || [ -n "$rb$mem_out" ] || plan+=("retro-brief.md	$orch/retro-brief.md")
todo=()
for p in ${plan[@]+"${plan[@]}"}; do
  t=${p#*	}
  # The section goes into an existing CLAUDE.md/CLAUDE.local.md too (appended); every other file only when missing.
  [ "${p%%	*}" = claude-section.md ] || [ ! -e "$(at "$t")" ] || continue
  todo+=("$p")
done
targets=$(for p in ${todo[@]+"${todo[@]}"}; do t=${p#*	}; [ -e "$(at "$t")" ] && t="$t (section appended)"; echo "$t"; done
          if [ -n "$mem_out" ]; then echo "no memory: $orch is outside this project (session-status --init --write --move gives it its own in $P)"
          else (cd "$root" && "$meminit" "${mem_args[@]}" --dry-run); fi
          [ -d "$(at "$replies_dir")" ] || echo "$replies_dir/")

if [ "$mode" = propose ]; then
  # lines that are there only sometimes, each ending in its newline (a $(…) in the text below would drop it)
  extra=
  [ -z "$noexec" ] || extra+=$'   .claude/session-status-adapter exists but is not executable: chmod +x it (not rewritten).\n'
  extra+=$shared_lines
  # Others commit here: the default stays personal, and --shared is named once (the design's open question 1).
  na=0; [ -z "$first" ] || na=$(git -C "$first" log -200 --format=%ae 2>/dev/null | sort -u | grep -c .)
  [ -n "$shared$repo_tracked" ] || [ "$na" -lt 2 ] || extra+="   Others commit here too ($na authors): all of this stays personal. Say \"shared\" to also open a team PR with the repo keys (--shared)."$'\n'
  ! nocli=$(no_cli) || extra+="   $nocli"$'\n'
  [ "$term_found" = plain ] || extra+="   Terminal: $term_found found, so the pane's Attach in tab and Logs in split open there (terminal=$term_found). Say \"plain\" to copy the commands instead."$'\n'
  [ -z "$briefs" ] || extra+="6. Optional, off unless you say:"$'\n'"$(sed 's/^/   /' <<<"$briefs")"$'\n'
  cat <<EOF
This folder isn't set up for coordination yet${adapter:+ (it has an adapter but no CLAUDE.md section)}${replies:+ (its CLAUDE.md section is there, the adapter is not)}. From the repo I found:
1. Task keys: $key_note.${tracker_url:+ Tickets: $tracker_url.} Branches $branch_pattern from $default_branch.
2. Code host: ${url:-none} ($host, $layout)$([ -n "$gh" ] && printf ', gh installed')$([ "$host" = github ] && [ -z "$gh" ] && printf ', gh not installed')$([ "$adapter_tpl" = github-adapter ] && [ -z "$adapter$noexec" ] && printf ' → GitHub adapter: open PRs, approvals, conflicts and CI in the pane').
3. Files: $(paste -sd, - <<<"$targets" | sed 's/,/, /g')$([ -n "$top" ] && printf '; the new ones added to .git/info/exclude'). Config: $cfg_line.
4. Approvals: not delegated (approvals.delegate=false): a coordinator's message alone approves nothing. Say "delegate" to let
   my messages count as yours (merges into $default_branch, deploys and messages as you stay reserved either way).
5. Worktrees: $worktree_cmd.
${extra}Reply "yes" to write all of this, "yes, delegate" to delegate approvals too, or corrections.
Facts (correct one with KEY=VALUE): name=$name${team:+ team=$team} tracker=$tracker host=$cfg_host terminal=$term_found key_re=$key_re key_example=$key_example tracker_url=${tracker_url:--} default_branch=$default_branch branch_pattern=$branch_pattern section_file=$section_file orch=$orch worktree_cmd='$worktree_cmd' urls=${urls:--}$([ "$adapter_tpl" = github-adapter ] && printf ' repo_slug=%s' "$repo_slug") merge_cmd='${merge_cmd:--}' post_cmd='${post_cmd:--}'
Write: session-status --init --write [--delegate]${own:+ --own}${shared:+ --shared}$([ "${#review[@]}" = 0 ] || printf ' [--trust=…]') [--review-brief] [--retro-brief] [KEY=VALUE…]
EOF
  exit 0
fi

# --- Write -------------------------------------------------------------------------------------------------------
# Shared mode, checked before anything is written: the team files that origin/<default> lacks, each past the scrub.
# Shared: what reaches the team PR (the repo file's keys, the .gitattributes line; team_scrub, above). Personal: all
# the rest, below.
tj= ga_need=
if [ -n "$shared" ]; then
  [ -n "$trepo" ] || { echo "refused: --shared needs a git repo for the team files (here, or the team repo in a workspace)"; exit 1; }
  case $trel in /*) echo "refused: --shared: the repo file's folder ($trel) is outside $trepo"; exit 1 ;; esac
  git -C "$trepo" fetch -q origin "$tdb" 2>/dev/null   # best effort: offline, the origin/$tdb fetched last
  git -C "$trepo" rev-parse -q --verify "origin/$tdb^{commit}" >/dev/null ||
    { echo "refused: --shared: no origin/$tdb in $trepo to branch the team PR from (push $tdb or fetch it, or say default_branch=…)"; exit 1; }
  if ! git -C "$trepo" cat-file -e "origin/$tdb:$trel/coordination.json" 2>/dev/null; then
    old='{}'; [ ! -e "$cfg_repo" ] || old=$(jq -c . "$cfg_repo") || exit 1
    tj=$(jq -n --argjson n "$cfg_repo_json" --argjson o "$old" '$n * $o')   # this checkout's values win, as --write keeps them
    msg=   # the messages module as coord_json finds it: person-wide config, then this project's
    for f in "$(user_config)" "$person_src"; do [ -f "$f" ] && m=$(jq -r '.messages // empty | strings' "$f" 2>/dev/null) && [ -n "$m" ] && msg=$m; done
    pk=$(jq -rn --argjson a "$tj" --argjson b "$(jq -c "$(person_keys_drop "$msg")" <<<"$tj")" \
      '($b | [paths(type != "object") | join(".")]) as $kb | [$a | paths(type != "object") | join(".") | select(. as $k | $kb | index([$k]) | not)] | join(", ")')
    [ -z "$pk" ] || { echo "refused: --shared: ${cfg_repo#"$root"/} has person keys, which never go in a team file: $pk (move them to .claude/coordination.local.json); setup stopped before writing"; exit 1; }
    bad=$(team_scrub "$trel/coordination.json (as committed)" "$tj" | sort -u)
    [ -z "$bad" ] || { echo "refused: --shared: these lines would put personal details in a team file (fix them in ${cfg_repo#"$root"/}); setup stopped before writing:"; sed 's/^/  /' <<<"$bad"; exit 1; }
  fi
  ga_old=$(git -C "$trepo" show "origin/$tdb:.gitattributes" 2>/dev/null)
  ga_need=$(while IFS= read -r l; do grep -qxF -- "$l" <<<"$ga_old" || echo "$l"; done <<<"$gattr")
  [ -z "$tsec_need" ] || tsec_missing || tsec_need=   # again, on the origin just fetched
  [ -z "$plug_need" ] || ! git -C "$trepo" show "origin/$tdb:${srel}$sjs" 2>/dev/null | jq -e '.enabledPlugins["session-orchestration@session-orchestration"] == true' >/dev/null 2>&1 || plug_need=
  # An earlier day's setup branch (open or not merged yet) counts too: one team PR at a time.
  prev=$(git -C "$trepo" for-each-ref --format='%(refname:short)' 'refs/heads/coordination/setup-*' 'refs/remotes/origin/coordination/setup-*' | head -1)
  if [ -n "$tj$ga_need$tsec_need$plug_need" ] && { [ -n "$prev" ] || [ -e "$wt" ]; }; then
    prev=${prev:-$tb}
    echo "refused: --shared: $prev exists already: open its PR, or remove it (git -C $trepo worktree remove $trepo/.worktrees/${prev#origin/}; git -C $trepo branch -D ${prev#origin/}), then run this again"; exit 1
  fi
fi
key_re_flag=; [ "$keys" = session ] && key_re_flag=1   # the default pattern already matches PROJ-123
tracker_keys=; [ "$keys" = tracker ] && tracker_keys=1
fill() { # template, then flags: lines starting {{?FLAG}} kept when FLAG is set, {{?!FLAG}} when it isn't (chained: all must hold)
  local line out= f
  while IFS= read -r line || [ -n "$line" ]; do
    while [[ $line =~ ^\{\{\?(!?)([a-z_]+)\}\}(.*)$ ]]; do
      f=${BASH_REMATCH[2]}; f=${!f:-}
      if [ -n "${BASH_REMATCH[1]}" ]; then [ -z "$f" ] || continue 2; else [ -n "$f" ] || continue 2; fi
      line=${BASH_REMATCH[3]}
    done
    out+=$line$'\n'
  done < "$tpl/$1"
  for v in name orch handoff replies_dir default_branch key_example key_re branch_pattern worktree_cmd enc_root urls repo_slug merge_cmd post_cmd done_rule; do
    out=${out//"{{$v}}"/${!v:-}}
  done
  printf '%s' "$out"
}
tsec=
if [ -n "$tsec_need" ]; then
  tsec=$(team_sec=1 local_sec='' fill claude-section.md)
  bad=$(team_scrub "${srel}CLAUDE.md (team section)" "$tsec" | sort -u)
  [ -z "$bad" ] || { echo "refused: --shared: these lines would put personal details in a team file (correct the fact with KEY=VALUE); setup stopped before writing:"; sed 's/^/  /' <<<"$bad"; exit 1; }
fi
wrote=()
for p in ${todo[@]+"${todo[@]}"}; do
  t=${p%%	*} f=$(at "${p#*	}")
  mkdir -p "$(dirname "$f")" || exit 1
  if [ "$t" = claude-section.md ] && [ -e "$f" ]; then
    { echo; fill "$t"; } >> "$f" || exit 1; wrote+=("${p#*	} (section appended)")
  else
    fill "$t" > "$f" || exit 1
    case $f in */session-status-adapter) chmod +x "$f" || exit 1 ;; esac
    wrote+=("${p#*	}")
  fi
done
memw=; [ -n "$mem_out" ] || memw=$(cd "$root" && "$meminit" "${mem_args[@]}") || exit 1
while IFS= read -r l; do [ -z "$l" ] || wrote+=("$l"); done <<<"$memw"
[ -d "$(at "$replies_dir")" ] || { mkdir -p "$(at "$replies_dir")" && wrote+=("$replies_dir/"); }
# The config: each key only when unset (an existing value is the user's); approvals.delegate also when --delegate
# turns it on.
[ -z "$miss_repo" ] || { missing_keys "$cfg_repo" "$cfg_repo_json" --write >/dev/null || exit 1; wrote+=(".claude/coordination/coordination.json ($miss_repo$cfg_note)"); }
[ -z "$miss_person" ] || { missing_keys "$cfg_person" "$cfg_person_json" --write >/dev/null || exit 1; wrote+=(".claude/coordination.local.json ($miss_person)"); }
if [ -n "$delegate" ] && [ "$(jq -r .approvals.delegate "$cfg_person")" != true ]; then
  jq '.approvals.delegate = true' "$cfg_person" > "$cfg_person.tmp" && mv "$cfg_person.tmp" "$cfg_person" || exit 1
  wrote+=(".claude/coordination.local.json (approvals.delegate=true)")
fi
# Keep them out of git: the repo's own .git/info/exclude (shared .gitignore untouched).
if [ -n "$top" ]; then
  ex=$(git -C "$root" rev-parse --git-path info/exclude); case $ex in /*) ;; *) ex=$root/$ex ;; esac
  mkdir -p "$(dirname "$ex")"
  # The config files up front, written or not: this checkout's repo file is personal too (shared mode commits the
  # team's copy in its own worktree; once merged, the pull replaces this ignored one), the person's always.
  # Shared mode hides only the repo file, not its folder: team files added there later (memory.md) must stay visible.
  rel=${root#"$top"}; rel=${rel#/}; rel=${rel:+$rel/}
  cdir="/${rel}.claude/coordination/"; cf=$cdir; [ -z "$shared" ] || cf=${cdir}coordination.json
  if [ -n "$shared" ] && grep -qxF "$cdir" "$ex" 2>/dev/null; then   # a personal setup's folder line goes
    { grep -vxF "$cdir" "$ex" || :; } > "$ex.tmp" && mv "$ex.tmp" "$ex"
  fi
  for f in "$cf" "/${rel}.claude/coordination.local.json" "/${rel}.claude/coordination.local/"; do
    git -C "$root" ls-files --error-unmatch "$top$f" >/dev/null 2>&1 && continue   # tracked (shared mode): not ours to hide
    grep -qxF "$f" "$ex" 2>/dev/null || echo "$f" >> "$ex"
  done
  # the worktree command's folder: a session's worktrees there never show in git status
  case $worktree_cmd in *"/.worktrees/"*) [ -n "$rel" ] ||   # a subfolder's: the repo's own folder isn't ours to name
     (cd "$root" && git check-ignore -q .worktrees/x) || grep -qxF "/${rel}.worktrees/" "$ex" 2>/dev/null || echo "/${rel}.worktrees/" >> "$ex" ;; esac
  for w in ${wrote[@]+"${wrote[@]}"}; do
    case $w in *" (section appended)"|.claude/coordination.local*|.claude/coordination/coordination.json*) continue ;; esac   # the user's file / the config, above
    case $w in .claude/coordination/*) [ -n "$shared" ] || continue ;; esac   # under the folder line, unless shared
    case $w in "$orch"/*) [ -n "$shared" ] && [ "${orch%/}" = .claude/coordination ] || w=$orch/ ;; esac   # the whole folder, so files added there later stay out too
    f=$(at "$w")
    case $f in "$top"/*) ;; *) continue ;; esac   # outside this repo
    (cd "$root" && git check-ignore -q "$f") && continue
    git -C "$root" ls-files --error-unmatch "$f" >/dev/null 2>&1 && continue   # tracked: not ours to hide
    grep -qxF "/${f#"$top"/}" "$ex" 2>/dev/null || echo "/${f#"$top"/}" >> "$ex"
  done
fi
for t in ${trust[@]+"${trust[@]}"}; do wrote+=(".claude/coordination.local.json (trusted ${t%@*})"); done
if [ "${#wrote[@]}" = 0 ]; then echo "Wrote: nothing (every file is there already)"
else printf 'Wrote:\n'; printf '  %s\n' "${wrote[@]}"; fi
# Shared mode: the team files, committed with the person's git identity in a worktree of their own (never the main
# checkout), for one team PR.
if [ -n "$shared" ]; then
  echo "Personal: everything above, out of git (.git/info/exclude, $section_file, $P): this machine only."
  [ -z "$tsec_need" ] || [ ! -e "$root/CLAUDE.md" ] || git -C "$root" ls-files --error-unmatch CLAUDE.md >/dev/null 2>&1 ||
    echo "Note: this checkout's CLAUDE.md is untracked and the team PR adds one: move its lines to CLAUDE.local.md before pulling the merge."
  if [ -z "$tj$ga_need$tsec_need$plug_need" ]; then echo "Shared: origin/$tdb has the team files already: no team PR."
  else
    tf=()
    git -C "$trepo" worktree add -q -b "$tb" "$wt" "origin/$tdb" 2>&1 || { echo "Shared: git worktree add failed: no team PR"; exit 1; }
    tex=$(git -C "$trepo" rev-parse --git-path info/exclude); case $tex in /*) ;; *) tex=$trepo/$tex ;; esac
    (cd "$trepo" && git check-ignore -q .worktrees/x) || echo /.worktrees/ >> "$tex"   # the main checkout stays clean
    # A failed step takes the worktree and branch back, so the next run isn't refused over an empty branch.
    tfail() { echo "Shared: $1 (see above): no team PR"; git -C "$trepo" worktree remove --force "$wt"; git -C "$trepo" branch -q -D "$tb"; exit 1; }
    if [ -n "$tj" ]; then
      mkdir -p "$wt/$trel" && printf '%s\n' "$tj" > "$wt/$trel/coordination.json" || tfail "writing $trel/coordination.json failed"
      tf+=("$trel/coordination.json (repo keys: $(jq -r '[paths(type != "object") | join(".")] | join(", ")' <<<"$tj"))")
    fi
    if [ -n "$ga_need" ]; then
      [ ! -s "$wt/.gitattributes" ] || [ -z "$(tail -c1 "$wt/.gitattributes")" ] || echo >> "$wt/.gitattributes"
      printf '%s\n' "$ga_need" >> "$wt/.gitattributes" || tfail "writing .gitattributes failed"
      tf+=(".gitattributes ($(paste -sd ';' - <<<"$ga_need" | sed 's/;/; /g'): two people's team memory appends merge on rebase)")
    fi
    if [ -n "$plug_need" ]; then
      f=$wt/${srel}$sjs; mkdir -p "$(dirname "$f")" && { [ -s "$f" ] || echo '{}' > "$f"; } &&
        jq '.enabledPlugins["session-orchestration@session-orchestration"] = true | .extraKnownMarketplaces["session-orchestration"] //= {source: {source: "github", repo: "vargroozzz/session-orchestration"}}' "$f" > "$f.tmp" &&
        mv "$f.tmp" "$f" || tfail "writing ${srel}$sjs failed"
      tf+=("${srel}$sjs (enables the plugin for whoever trusts the folder: off unless --plugin)")
    fi
    if [ -n "$tsec" ]; then
      f=$wt/${srel}CLAUDE.md; mkdir -p "$(dirname "$f")" || tfail "writing ${srel}CLAUDE.md failed"
      [ ! -s "$f" ] || { [ -z "$(tail -c1 "$f")" ] || echo; echo; } >> "$f"
      printf '%s\n' "$tsec" >> "$f" || tfail "writing ${srel}CLAUDE.md failed"
      tf+=("${srel}CLAUDE.md (team section \"${team_head#\#\# }\": approvals, reserved actions, task names, worktrees; no paths or names)")
    fi
    tmsg="coordination: shared setup ($([ -n "$tj" ] && printf 'repo keys, ')$([ -n "$tsec" ] && printf 'team CLAUDE.md section, ')$([ -n "$plug_need" ] && printf 'plugin enablement, ')merge=union for team memory)"
    # -f: an ignore rule (this clone's own exclude, or one like .claude/*) would hide the team folder
    git -C "$wt" add -f -- ${tj:+"$trel/coordination.json"} ${ga_need:+.gitattributes} ${tsec:+"${srel}CLAUDE.md"} ${plug_need:+"${srel}$sjs"} &&
      git -C "$wt" commit -q -m "$tmsg" || tfail "the commit in $wt failed"
    turl=$(git -C "$trepo" config --get remote.origin.url)
    pr="git -C $wt push -u origin $tb" prnote=
    case $turl in   # as configured, not insteadOf-rewritten: what gh resolves
      *github.com*) pr+=" && gh pr create -R $(url_slug "$turl") --base $tdb --head $tb --title '$tmsg' --body 'Shared coordination files: every collaborator reads them once this merges; personal files stay out of git.'" ;;
      *) prnote="Then open a PR from $tb into $tdb on the code host." ;;
    esac
    echo "Shared: committed on $tb ($wt), for a team PR every collaborator sees:"
    printf '  %s\n' "${tf[@]}"
    echo "Team PR: show its diff in one pane ask (git -C $wt show), then on yes: $pr"
    [ -z "$prnote" ] || echo "$prnote"
  fi
fi
echo "Next: session-status --init --check (expect configured), then open_pane."
