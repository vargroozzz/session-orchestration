#!/usr/bin/env bash
# session-status --init: sets a folder up for coordination (skill setting-up-coordination).
# No model call, no tracker call: everything comes from the folder, its git repos and their remotes.
#   session-status --init --check   one line, exit 0 configured, 1 unconfigured or partial, 3 covered by a parent;
#                                   configured adds the active line (`active: tracker=… host=… delegate=…
#                                   pr_create=… start=…[,feedback_apply:…][,sidebar] terminal=… messages=… features=…`), under it one indented line per doc of the
#                                   terminal, the messages module and each enabled feature (its start step and when to
#                                   read it), the indented value lines open_pane reads (`review_inbox url: URL`,
#                                   `notify after: N min`), and a line per warning (a config value not valid, a module that doesn't load whole,
#                                   delegation still in CLAUDE.md, a second account with features.accounts off, a
#                                   terminal detected but not recorded, `unmeasured: ID, why` for a migration detector that couldn't look:
#                                   --migrate writes no stamp while one shows), and `team[ (DIR)]: section, memory, review-brief, adapter
#                                   (trusted[, local wins])`: the team files git tracks in .claude/coordination/ and the
#                                   committed CLAUDE.md's "Coordinated sessions (team)" section (section) (DIR,
#                                   relative to the root, in a workspace's team repo), read before the person's
#   session-status --init           the proposal: what it found and what it would write, numbered for one reply
#   session-status --init --write [--delegate] [--own] [--shared [--plugin]] [--trust=REL@SHA…] [--review-brief] [--retro-brief]
#                                 [KEY=VALUE…]
#                                   writes the missing files from templates/ (never over an existing one; the
#                                   CLAUDE.md section is appended to a CLAUDE.md/CLAUDE.local.md that lacks one),
#                                   keeps new files out of git (.git/info/exclude), prints what it wrote. KEY=VALUE overrides an
#                                   inferred fact (the names `--init` prints under "Facts"). The optional briefs (PR
#                                   reviewer sessions, the retro's units) are written only when asked, also into a
#                                   folder set up already. The config (lib.sh), each key only when it's unset:
#                                   .claude/coordination/coordination.json (tracker, host, features.review_inbox) and
#                                   .claude/coordination.local.json (features.accounts, terminal, approvals.delegate: true with
#                                   --delegate, which also turns it on when set); both excluded up front, also in a
#                                   folder set up already. --shared (shared mode) also commits the team files (the
#                                   repo file's keys, a .gitattributes merge=union line for team memory, in one repo
#                                   the CLAUDE.md team section: claude-section.md's rule lines, while the personal
#                                   section in CLAUDE.local.md keeps the coordinator, replies, memory, handoff) in a worktree
#                                   from origin/<default> on coordination/setup-<date>, after a scrub (no home path,
#                                   email, session name or ID, person key), and prints the push + PR command for one
#                                   pane ask; the main checkout gets only personal, excluded files. --trust=REL@SHA records
#                                   a committed .claude/coordination/REL (an adapter or module) as trusted, refused
#                                   when its sha256 is no longer the SHA the proposal showed. In a workspace, the one
#                                   repo one level down with a committed .claude/coordination/ becomes the team key.
#                                   New files go to the project's state folder (lib.sh proj_dir, P), not the checkout.
#   session-status --init --write --move [--link]
#                                   an older setup's replies, memory, handoff (with its archive), briefs and
#                                   .claude/tasks/ moved into P, the section's path lines, the adapter's
#                                   paths rewritten (a configured pending.file stays where it is),
#                                   then the plain --write; all or nothing when a target exists. --link: a .coordinator
#                                   symlink to P in the root, kept out of git.
#   session-status --init --migrate [--dry-run]
#                                   an older layout made current: --check's `[mN auto|ask]` lines (prefixed on each
#                                   line that names one), the auto ones fixed, backed up and logged, the ask ones
#                                   listed, P/setup.json stamped once none is left (see Migrate below). A file git
#                                   tracks is changed in a team PR (coordination/migrate-<id>), never in the checkout.
#   session-status --init --team-memory
#                                   the prune's gather (shared mode): the memory's [team] lines appended, deduped and
#                                   scrubbed, to the same topic in .claude/coordination/memory/<topic>.md (a flat
#                                   memory's to misc.md; the index row added) in a worktree from origin/<default> on
#                                   coordination/memory-<date>-<time>, with the Team PR line; lines origin/<default> has
#                                   leave the memory; while this clone's gather branch is unmerged, nothing new opens.
# Configured: the nearest adapter (.claude/session-status-adapter, as session-status finds the root) is in this
# folder, and its CLAUDE.md or CLAUDE.local.md names a replies folder (the line --handover reads). A folder with its
# own adapter is its own project even when a parent folder has one too (a subproject coordinator); with no adapter
# of its own under a parent's, it is covered by that parent, and --write needs --own.
set -uo pipefail
shopt -u patsub_replacement 2>/dev/null   # bash 5.2+ would expand & in a fill() value; 3.2 has no such option
here=$(cd "$(dirname "$0")" && pwd)
tpl=$here/templates
. "$here/../../lib.sh" || exit 1
root=$(pwd -P)

mode=propose own= delegate= shared= plugin= review_brief= retro_brief= over=() trust=() team_over= move= link= rest=() dry= apply= decline=
for a; do
  case $a in --move) move=1; continue ;; --link) link=1; continue ;; esac
  rest+=("$a")
  case $a in
    --check) mode=check ;; --write) mode=write ;; --migrate) mode=migrate ;; --team-memory) mode=team_memory ;; --dry-run) dry=1 ;;
    --own) own=1 ;; --delegate) delegate=1 ;; --shared) shared=1 ;; --plugin) plugin=1 ;;
    --trust=?*@?*) trust+=("${a#--trust=}") ;;
    --review-brief) review_brief=1 ;; --retro-brief) retro_brief=1 ;;
    --apply=?*) apply=${a#--apply=} ;; --decline=?*) decline=${a#--decline=} ;;   # above *=*, which takes KEY=VALUE
    team=?*) team_over=${a#team=}; over+=("$a") ;;
    *=*) over+=("$a") ;;
    *) echo "unknown argument: $a"; exit 2 ;;
  esac
done

[ -z "$plugin" ] || [ -n "$shared" ] || { echo "--plugin goes with --shared (it adds .claude/settings.json to the team PR)"; exit 2; }
# --- State -------------------------------------------------------------------------------------------------------
cfg_person=$root/.claude/coordination.local.json
# A committed one is ignored (lib.sh tracked), and never written to: that would publish it.
person_src=$cfg_person
if tracked "$cfg_person"; then
  [ "$mode" != write ] || { echo "refused: .claude/coordination.local.json is committed: git rm --cached it first"; exit 1; }
  person_src=/dev/null
fi
# A workspace (not a repo itself): the repos one level down with a committed .claude/coordination/, for the team key.
team_found=()
if ! git -C "$root" rev-parse --git-dir >/dev/null 2>&1 && ! jq -e '.team' "$person_src" >/dev/null 2>&1; then
  for d in "$root"/*/; do
    git -C "$d" ls-files --error-unmatch .claude/coordination/coordination.json >/dev/null 2>&1 && team_found+=("$(basename "$d")")
  done
fi
team=; [ "${#team_found[@]}" = 1 ] && team=${team_found[0]}
[ -z "$team_over" ] || team=$team_over
# The committed files' folder (lib.sh shared_dir; the team found or given, before it is recorded), and its code not
# trusted yet: REL@SHA each, shown for review. One further up than this folder is a parent project's: not this one's.
sd=$(cd "$root" && shared_dir 2>/dev/null)
jq -e '.team' "$person_src" >/dev/null 2>&1 || [ "$sd" = "$root/.claude/coordination" ] || sd=
[ -z "$team" ] || sd=$root/$team/.claude/coordination
review=()
if [ -n "$sd" ]; then
  while IFS= read -r f; do
    r=${f#"$sd"/} want=$(jq -r --arg k "${f#"$sd"/}" '.trusted[$k] // empty | strings' "$person_src" 2>/dev/null)
    sha=$(sha256_of "$f"); [ "$sha" = "$want" ] || review+=("$r@$sha")
  done < <(find "$sd" -maxdepth 2 -type f \( -path "$sd/session-status-adapter" -o -path "$sd/*/*.sh" \) 2>/dev/null | sort)
fi
parent= d=$(dirname "$root")
while [ "$d" != / ]; do [ -x "$d/.claude/session-status-adapter" ] && { parent=$d; break; }; d=$(dirname "$d"); done
# --trust: recorded first, so the adapter below counts a committed one trusted now. Only files still as shown, and
# not in a folder a parent covers (that exits below, writing nothing).
if [ "$mode" = write ] && [ "${#trust[@]}" -gt 0 ] && { [ -z "$parent" ] || [ -n "$own" ] || [ -e "$root/.claude/session-status-adapter" ]; }; then
  for t in "${trust[@]}"; do
    r=${t%@*} sha=${t##*@}
    case $r in ../*|*/../*|/*) echo "--trust=$t: not a path under .claude/coordination/"; exit 2 ;; esac
    [ -f "$sd/$r" ] || { echo "--trust=$t: no ${sd:-.claude/coordination}/$r"; exit 1; }
    [ "$(sha256_of "$sd/$r")" = "$sha" ] || { echo "--trust=$t: $r changed since it was shown: run session-status --init again and review it"; exit 1; }
  done
  for t in "${trust[@]}"; do
    mkdir -p "$root/.claude" && { [ -e "$cfg_person" ] || echo '{}' > "$cfg_person"; } &&
      jq --arg k "${t%@*}" --arg v "${t##*@}" '.trusted[$k] = $v' "$cfg_person" > "$cfg_person.tmp" && mv "$cfg_person.tmp" "$cfg_person" || exit 1
  done
fi
# The adapter: the local one, else a committed one the person trusts (lib.sh adapter_path).
adapter=; [ -n "$(adapter_path "$root" 2>/dev/null)" ] && adapter=1
noexec=; [ -e "$root/.claude/session-status-adapter" ] && [ -z "$adapter" ] && noexec=1   # never rewritten: chmod +x
replies=$(cd "$root" && sed -nE 's/.*[Rr]eplies folder[^`]*`([^`]+)`.*/\1/p' CLAUDE.md CLAUDE.local.md 2>/dev/null | head -1)
# The section's orch folder: its memory line's, else the replies folder's parent (sections written before that line).
mem=$(cd "$root" && sed -nE 's/.*Project memory: `([^`]+)\/memory\.md`.*/\1/p' CLAUDE.md CLAUDE.local.md 2>/dev/null | head -1)
# at PATH: absolute (relative: to the root; ~/: HOME), no trailing /.
at() { local r=${1%/}; r=${r/#\~\//$HOME/}; case $r in /*) echo "$r" ;; *) echo "$root/$r" ;; esac; }
# The project's state folder (lib.sh proj_dir): replies, memory, handoff, briefs and tasks of a setup from the release
# after this one; older ones move there with --write --move.
P=$(proj_dir "$root")
# --migrate's stamp (P/setup.json) past LAYOUT: a newer plugin moved this project to a layout this one doesn't know,
# so --check warns and --write (--move too) writes nothing.
sl=$(jq -r '.layout // 0' "$P/setup.json" 2>/dev/null); [[ $sl =~ ^[0-9]+$ ]] || sl=0
newer=; [ "$sl" -le "$LAYOUT" ] || newer="migrated by plugin $(jq -r '.plugin // "?"' "$P/setup.json") (layout $sl; this one knows $LAYOUT): update this account's plugin"
# The same for the team's committed repo file, whose `layout` a team migration PR raises (Migrate below).
tl=0; [ -z "$sd" ] || ! git -C "$sd" ls-files --error-unmatch coordination.json >/dev/null 2>&1 || tl=$(jq -r '.layout // 0' "$sd/coordination.json" 2>/dev/null)
[[ $tl =~ ^[0-9]+$ ]] || tl=0
[ -n "$newer" ] || [ "$tl" -le "$LAYOUT" ] || newer="the team's committed files were migrated by a newer plugin (layout $tl in ${sd#"$root"/}/coordination.json; this one knows $LAYOUT): update this account's plugin"
[ "$mode" != write ] || [ -z "$newer" ] || { echo "refused: $newer"; exit 1; }
# The orch folder setup writes into: P, else an existing section's (its memory line's; a replies folder in the old
# state dir says nothing about it). A correction (orch=) can change it below.
orch=$P
case $replies in ''|*/session-orchestration/replies/*) ;; *) orch=$(dirname "${replies%/}") ;; esac; orch=${mem:-$orch}
# retro_brief ORCH [NAME...]: the retro brief the retro skill reads: beside the memory (not one left outside the root
# and P), else .claude/ (older setups). Names default to retro; migration m4 passes "retro rnd" to find the old name.
retro_brief() {
  local d n ds=("$1" .claude) ns=("${@:2}"); [ "${#ns[@]}" -gt 0 ] || ns=(retro)
  case $(at "$1")/ in "$root"/*|"$P"/*) ;; *) ds=(.claude) ;; esac
  for n in "${ns[@]}"; do for d in "${ds[@]}"; do [ -e "$(at "$d")/$n-brief.md" ] && { echo "$d/$n-brief.md"; return; }; done; done
}
# The handoff file: config pending.file, else the section's handoff line (absolute; empty when neither names one).
hand=$(cd "$root" && pending_path "$root") hand_cfg=$hand   # a configured one is the person's choice: --move leaves it
# The section's handoff line (absolute; empty: none): a backticked path, else a bullet's bare path ending .md.
hline=$(cd "$root" && sed -nE 's/.*[Hh]andoff file: `([^`]+)`.*/\1/p' CLAUDE.md CLAUDE.local.md 2>/dev/null | head -1)
[ -n "$hline" ] || hline=$(cd "$root" && sed -nE 's/^- .*[Hh]andoff file: ([^][()` ]+\.md).*/\1/p' CLAUDE.md CLAUDE.local.md 2>/dev/null | head -1)
[ -z "$hline" ] || hline=$(at "$hline")
[ -n "$hand" ] || hand=$hline
# A PR reviewer brief the section names (a backticked *brief*.md on a line about a review brief) that exists.
named_brief=$(cd "$root" && grep -hiE 'review.*brief' CLAUDE.md CLAUDE.local.md 2>/dev/null | grep -oE '`[^`]*brief[^`]*\.md`' | tr -d '`' |
  while read -r b; do b=$(at "$b"); [ -f "$b" ] && { echo "$b"; break; }; done)
# What --move may take (--check names it): from inside the root or the old state replies folder, never the committed
# config folder or a file git tracks in the root's repo or one with a remote.
top0=$(git -C "$root" rev-parse --show-toplevel 2>/dev/null) && top0=$(cd "$top0" && pwd -P)
oldrep=${XDG_STATE_HOME:-$HOME/.local/state}/session-orchestration/replies/$(enc_path "$root")
inside() { case $1 in "$root"/*|"$oldrep"|"$oldrep"/*) return 0 ;; esac; return 1; }
# RQ=word (the adapter): each shell word, as a hand-made one may write replies=DIR, cat "FILE" or cat 'A B/FILE'; a
# quoted span stays one word, a $VAR word is left alone (it isn't a path from the root) and so is a comment line.
rew() { # FILE [check|words]: FILE with each backticked path (RQ: that quote instead) at or under a source in $map (SRC<tab>DST lines) pointing at DST; check: the lines it'd change; words: each path word, resolved
  MAP=$map ROOT=$root CHECK=${2:-} Q=${RQ:-'`'} awk '
    BEGIN { n = split(ENVIRON["MAP"], m, "\n"); for (i = 1; i <= n; i++) { split(m[i], kv, "\t"); src[i] = kv[1]; dst[i] = kv[2] }
            q = ENVIRON["Q"]; w = (q == "word"); ck = ENVIRON["CHECK"]
            qre = w ? "\047[^\047]*\047|\"[^\"]*\"|[$]?[^][ \t\047\"=;|&()<>`$]+" : q "[^" q "]+" q }
    w && /^[ \t]*#/ { if (ck == "") print; next }
    { out = ""; s = $0; hit = 0
      while (match(s, qre)) {
        m0 = substr(s, RSTART, RLENGTH); pre = substr(s, 1, RSTART - 1); s = substr(s, RSTART + RLENGTH)
        c = substr(m0, 1, 1); if (!w || c == "\047" || c == "\"") { qq = c; tok = substr(m0, 2, length(m0) - 2) } else { qq = ""; tok = m0 }
        if (tok != "" && tok !~ /^\$/) {
          r = tok; sl = (r ~ /\/$/); sub(/\/+$/, "", r)
          if (r ~ /^~\//) r = ENVIRON["HOME"] substr(r, 2); else if (r !~ /^\//) r = ENVIRON["ROOT"] "/" r
          if (ck == "words") { if (tok ~ /\//) print r; continue }
          for (i = 1; i <= n; i++) if (src[i] != "" && (r == src[i] || index(r, src[i] "/") == 1)) { tok = dst[i] substr(r, length(src[i]) + 1) (sl ? "/" : ""); hit = 1; break }
        }
        out = out pre qq tok qq
      }
      if (ck != "") { if (hit && ck == "check") print; next }
      print out s }' "$1"
}
# bq FILE: FILE with a bullet's bare handoff path backticked, so rew sees it
bq() { sed -E 's/^(- .*[Hh]andoff file: )([^][()` ]+\.md)/\1`\2`/' "$1"; }
# stale_ad: the map (SRC<tab>DST) for an untracked adapter's paths left behind by an earlier move: a missing path
# outside P whose name (replies, pending.md, …) is in P. Empty when the adapter is committed or names none.
stale_ad() {
  local f=$root/.claude/session-status-adapter r map=
  [ -f "$f" ] && ! tracked "$f" 2>/dev/null || return 0
  RQ=word rew "$f" words | sort -u | while IFS= read -r r; do
    case $r in "$P"|"$P"/*) continue ;; esac
    [ -e "$r" ] || [ ! -e "$P/${r##*/}" ] || printf '%s\t%s\n' "$r" "$P/${r##*/}"
  done
}
# m10: lines an older template rendered (the CLAUDE.md section, the adapters) → the current template's line.
# GROUP<tab>ANCHOR<tab>OLD<tab>NEW: a GROUP other than - is rewritten only when every OLD line of it is there (a pair
# split in two would break: the github adapter's review words). The approvals paragraph (deleg, nodeleg) is rewritten
# only when approvals.delegate agrees with it (deleg: true, which m1 sets; nodeleg: not true), and never in a tracked
# file: there it's the team's, and one person's config doesn't decide it. {{k}} is the text up to the character after it (a key, a path). A line
# that starts with an ANCHOR but is neither an OLD nor the NEW was edited by hand: left alone and named.
drift_tbl=$(
  r() { printf '%s\t%s\t%s\t%s\n' "$@"; }
  w1=$'- Whether a coordinator\'s message counts as the user\'s approval is `approvals.delegate` in'
  w2='  `.claude/coordination.local.json` (`session-status --config approvals.delegate`).'
  r deleg '- **The user delegates approvals' $'- **The user delegates approvals to the coordinator.** A coordinator\'s message approving an action counts as the' "$w1"
  r deleg '' $'  user\'s approval: commits, pushes to feature branches, rebases, resumes.' "$w2"
  r nodeleg '- **Approvals are not delegated.**' $'- **Approvals are not delegated.** A coordinator\'s message alone approves nothing; the user approves in your' "$w1"
  r nodeleg '' $'  session, or via a relayed approval verified with the plugin\'s `verify-approval.sh`.' "$w2"
  r - '- **Reserved**, whatever' '- **Reserved**, whatever the above says: the user approves in your session, or via a verified relayed approval:' \
    '- **Reserved**, even when approvals are delegated: the user approves in your session, or via a verified relayed approval:'
  r - $'- Replies folder (the plugin\'s' $'- Replies folder (the plugin\'s "folder for this"): `{{k}}`.' '- Replies folder (status reports, plans, review reports): `{{k}}`.'
  s3=$'- A task is its session\'s name, `{{k}}`: start it with `claude --bg --model M --effort E -n {{k}}` (M, E: what `session-status --kind <kind> {{k}}` prints; paste the rest it prints too: ` --advisor A`, ` --disallowedTools=…`).'
  r - '' $'- A task is its session\'s name, `{{k}}`: start it with `claude --bg --model M --effort E -n {{k}}` (M, E: what `session-status --kind <kind> {{k}}` prints; paste a ` --advisor A` it prints too).' "$s3"
  r - $'- A task is its session\'s name, `' $'- A task is its session\'s name, `{{k}}`: start it with `claude --bg -n {{k}}`.' "$s3"
  r - '' $'- A task is its session\'s name, `{{k}}`: start it with `claude --bg --model M --effort E -n {{k}}` (M, E: what `session-status --kind <kind>` prints).' "$s3"
  r - '' $'- A task is its session\'s name, `{{k}}`: start it with `claude --bg --model M --effort E -n {{k}}` (M, E: what `session-status --kind <kind> {{k}}` prints).' "$s3"
  r gh '        | select(.) | (if .state == "APPROVED" then ' '        | select(.) | (if .state == "APPROVED" then "+" else "!" end) + .author.login]) as $r' \
    '        | select(.) | (if .state == "APPROVED" then "approved by " else "changes requested by " end) + .author.login]) as $r'
  r gh '      + (if any($r[]; startswith(' '      + (if any($r[]; startswith("+")) then "" else " no-human-approval" end)' \
    '      + (if any($r[]; startswith("approved by ")) then "" else " no-human-approval" end)'
)
# drift FILE [check]: FILE with its old template lines made current; check: `- OLD`/`+ NEW` per line it would change,
# `edited by hand, left alone: line N: …` and `waits for m1 (approvals.delegate unset): line N: …` per line it keeps.
drift() {
  local tr=; git -C "${1%/*}" ls-files --error-unmatch -- "${1##*/}" >/dev/null 2>&1 && tr=1
  TBL=$drift_tbl DV=$deleg_val TR=$tr CK=${2:-} awk '
    function rep(t, k,   i, r) { r = ""; while ((i = index(t, "{{k}}"))) { r = r substr(t, 1, i - 1) k; t = substr(t, i + 5) } return r t }
    # kof(LINE, T): the {{k}} text LINE gives T (T has none: ""), or "\n" when LINE does not start like T
    function kof(line, t,   i, p, rest, j) {
      if (!(i = index(t, "{{k}}"))) return ""
      p = substr(t, 1, i - 1); if (index(line, p) != 1) return "\n"
      rest = substr(line, length(p) + 1); j = index(rest, substr(t, i + 5, 1)); return j > 1 ? substr(rest, 1, j - 1) : "\n"
    }
    function is(line, t,   k) { k = kof(line, t); return k != "\n" && rep(t, k) == line }
    BEGIN { n = split(ENVIRON["TBL"], rows, "\n"); for (r = 1; r <= n; r++) { split(rows[r], f, "\t"); g[r] = f[1]; an[r] = f[2]; o[r] = f[3]; nw[r] = f[4]; need[g[r]]++ }
            ck = ENVIRON["CK"]; dv = ENVIRON["DV"]; tr = ENVIRON["TR"] }
    { L[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) for (r = 1; r <= n; r++) if (is(L[i], o[r])) { m[i] = r; nl[i] = rep(nw[r], kof(L[i], o[r])); if (!seen[r]++) found[g[r]]++; break }
      for (i = 1; i <= NR; i++) {
        if ((r = m[i])) {
          x = g[r]; ap = x == "deleg" || x == "nodeleg"
          ok = x == "-" || (found[x] == need[x] && (!ap || (tr == "" && (x == "deleg") == (dv == "true"))))
          if (ok) { if (ck == "") print nl[i]; else { print "- " L[i]; print "+ " nl[i] }; continue }
          if (ck != "") print (found[x] != need[x] ? "edited by hand, left alone (its other line was)" : tr != "" ? "left alone: a tracked file, its approvals paragraph is the team one (edit it by hand)" : \
            x == "deleg" && dv == "" ? "waits for m1 (approvals.delegate unset)" : "left alone: approvals.delegate is " (dv == "" ? "unset" : dv) ", not what it says") ": line " i ": " L[i]
        } else if (ck != "") {
          for (r = 1; r <= n; r++) if (an[r] != "" && index(L[i], an[r]) == 1) { cur = 0; for (q = 1; q <= n; q++) if (an[q] == an[r] || g[q] == g[r] && g[r] != "-") if (is(L[i], nw[q])) cur = 1
            if (!cur) print "edited by hand, left alone: line " i ": " L[i]; break }
        }
        if (ck == "") print L[i]
      }
    }' "$1"
}
# drift_files: the files m10 looks at: CLAUDE.md and CLAUDE.local.md (tracked or not), an untracked local adapter
drift_files() {
  local f; for f in "$root/CLAUDE.md" "$root/CLAUDE.local.md" "$root/.claude/session-status-adapter"; do
    [ -f "$f" ] || continue; [ "${f##*/}" != session-status-adapter ] || ! tracked "$f" 2>/dev/null || continue; echo "$f"
  done
}
# stays SRC: why SRC can't move (empty: it can)
stays() {
  local s=$1 d t
  case $s in "$root/.claude/coordination"|"$root/.claude/coordination/"*) echo "the committed config folder"; return ;; esac
  [ -d "$s" ] && d=$s || d=$(dirname "$s")
  t=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) && t=$(cd "$t" && pwd -P) || return 0
