#!/usr/bin/env bash
# Plugin feedback: cases where the plugin itself misbehaved or lacks a rule, kept per person (every project's in one
# list) until someone sends them upstream. Never sends anything itself: feedback.md says how a case is applied.
#
# Cases: ${XDG_STATE_HOME:-~/.local/state}/session-orchestration/feedback/<category>/YYYY-MM-DD-<slug>.md, category
# bugfixes | features | refactorings. Each is defer-task's format plus where, found while, plugin, evidence, seen and
# status lines (feedback.md shows one).
# Project cases (--project): friction from the project itself (its hosts, sign-ins, docs, scripts), in the same format
# and layout, in this project's store: config feedback.project_dir (relative: to the project root), else
# ${XDG_STATE_HOME:-~/.local/state}/session-orchestration/feedback-projects/<project root, encoded>. Never committed,
# scrubbed or sent: the R&D run turns them into project fixes.
# The case files themselves (add, seen, list, count, mark) are project-memory's `cases`, given the store and the
# origin line; this script adds the plugin's scope, its footer, scrub and the ways a case goes upstream.
#
# Usage: feedback add CATEGORY TITLE --where PATH[:LINE] --found 'ROLE; STEP' --evidence TEXT [--suggested TEXT] [--new]
#                     [--project]
#                       writes a case and prints its path. Open cases (of the same scope) with the same file in
#                       `where` or two title words in common are printed instead (exit 3): add a date to one with
#                       `feedback seen FILE`, or rerun with --new.
#        feedback seen FILE      today's date added to its `seen:` line (a duplicate counts there, not as a new file)
#        feedback list [--all] [--plugin|--project]   open cases (--all: every case), the plugin's and this project's
#                                (or one scope): times seen, status, path, title (tabs), most seen first
#        feedback count [--plugin|--project]   `N open (M seen ≥2×)` per scope (both: `…; project: …`), nothing
#                                when none are open
#        feedback footer         both counts, at most once a day (the status sweep's footer). With a plugin coordinator
#                                (feedback.repo_dir), another root shows the plugin's count only while it isn't running
#                                (on a stamp of its own; a running one is checked at most once an hour)
#        feedback coordinator [--start]   the plugin coordinator's name when it runs (any account: another one is
#                                named); exit 1 when it doesn't, 2 with no feedback.repo_dir, 3 when an account's
#                                listing failed. --start: one that doesn't run is opened in a terminal tab (config
#                                terminal; plain prints the command to run)
#        feedback scrub FILE…    lines that could name the person or their projects (FILE:LINE: why: text); exit 1
#                                on any hit. The deny list covers every project root your sessions ran in
#        feedback mark FILE sent URL | fixed WHAT | dropped
#        feedback mode           how cases are applied here: pr | fork-pr | issue | local (config feedback.mode, else
#                                pr with feedback.repo_dir set, else fork-pr when gh is signed in, else issue)
#        feedback repo           the plugin's GitHub repo (owner/name), from plugin.json's repository
#        feedback label          the label an `issue`-mode case is filed with
set -uo pipefail
. "$(dirname "$0")/../../lib.sh" || exit 1
DIR=${XDG_STATE_HOME:-$HOME/.local/state}/session-orchestration/feedback
PLUGIN_JSON=$LIB_DIR/.claude-plugin/plugin.json
TODAY=$(date +%F)
LABEL=todo

die() { echo "$*" >&2; exit 2; }
# project-memory's cases keeps both stores; resolved only by the subcommands that use it.
cases() {
  [ -n "${CASES:-}" ] || CASES=$(pm_dir)/skills/project-memory/cases || exit 2
  [ -x "$CASES" ] || die "$CASES is missing: update project-memory"
  "$CASES" "$@"
}
# This project's store: feedback.project_dir (relative to the root), else cases' default for the project.
pdir() {
  local d; d=$(config feedback.project_dir 2>/dev/null)
  case $d in '') cases store ;; /*) echo "$d" ;; *) echo "$(cases root)/$d" ;; esac
}
# pc_name ROOT: ROOT's coordinator name (lib.sh slug).
pc_name() { echo "$(slug "$(basename "$1")")-coordinator"; }
# pc_live ROOT: the plugin coordinator, when it runs: a live session by its name in ROOT, under any account sharing
# this transcript store (whatever this project's features.accounts says). Prints its name, and the account when it's
# another (SendMessage reaches only its own). Exit 1: not running; 3: not found, but an account's listing failed.
pc_live() {
  local TMP rc; TMP=$(mktemp -d) || return 3
  load_module features accounts list_accounts 2>/dev/null
  # No early exit in awk: list_sessions would die of SIGPIPE, and pipefail would fail a found one.
  list_sessions | awk -F'\t' -v n="$(pc_name "$1")" -v r="$1" '!f && $2 == n && $3 !~ /^(done|failed|stopped)$/ &&
    ($6 == r || index($6, r "/") == 1) { f = 1; a = $4 }
    END { if (!f) exit 1; print n (a == "claude" ? "" : ", under another account (" a "): SendMessage reaches it only from there") }'
  rc=$?; [ "$rc" = 0 ] || [ ! -e "$TMP/ask.failed" ] || rc=3
  rm -rf "$TMP"; return "$rc"
}
repo() { jq -r '.repository // empty | if type == "object" then .url else . end' "$PLUGIN_JSON" 2>/dev/null |
  sed -E 's#^(git\+)?https?://github\.com/##; s#\.git$##; s#/$##' | grep -E '^[^/ ]+/[^/ ]+$'; }

case ${1:-} in
add)
  shift; args=() store=$DIR
  for a in "$@"; do [ "$a" = --project ] && store=$(pdir) || args+=("$a"); done
  if [ "$store" = "$DIR" ]; then
    # --where: a path in the plugin. The value follows the flag; a bad one is cases' to report.
    prev=; for a in ${args[@]+"${args[@]}"}; do
      [ "$prev" = --where ] && [[ $a == /* || $a == '~'* ]] &&
        die "--where is a path in the plugin (skills/…/session-status:206), never a project's (project friction: --project)"
      prev=$a
    done
    origin="plugin: $(jq -r .version "$PLUGIN_JSON")"
  else origin="project: $(cases root)"; fi
  out=$(cases --store "$store" --origin "$origin" add ${args[@]+"${args[@]}"}); rc=$?
  [ -z "$out" ] || echo "${out//cases seen FILE/feedback seen FILE}"
  # scrub's deny list covers this project even once its sessions are gone.
  [ "$rc" != 0 ] || { mkdir -p "$DIR" && find_root >> "$DIR/.roots"; }
  exit "$rc" ;;
seen) [ -f "${2:-}" ] || die "usage: feedback seen FILE"; cases seen "$2" ;;
list)
  shift; all= scope=
  for a in "$@"; do case $a in --all) all=$a ;; --plugin|--project) scope=$a ;; *) die "usage: feedback list [--all] [--plugin|--project]" ;; esac; done
  { [ "$scope" = --project ] || cases --store "$DIR" list $all; [ "$scope" = --plugin ] || cases --store "$(pdir)" list $all; } |
    sort -t$'\t' -k1,1nr ;;
count)
  cnt() { cases --store "$1" count; }
  case ${2:-} in
    --plugin) cnt "$DIR" ;; --project) cnt "$(pdir)" ;;
    '') p=$(cnt "$DIR") q=$(cnt "$(pdir)"); [ -z "$q" ] || p="${p:+$p; }project: $q"; [ -z "$p" ] || echo "$p" ;;
    *) die "usage: feedback count [--plugin|--project]" ;;
  esac ;;
footer)
  # Once a day each: the plugin's count per person, the project's per project (its own store's stamp).
  due() { [ "$(cat "$1" 2>/dev/null)" != "$TODAY" ]; }
  shown() { mkdir -p "${1%/*}" && echo "${2:-$TODAY}" > "$1"; }
  P=$(pdir) p= q= ask=' — apply? (feedback.md)' s=$DIR/.footer-shown hour=$(date '+%F %H')
  # With a plugin coordinator, the cases are its own: another root shows them only while it isn't running, on a stamp
  # of its own (so the plugin coordinator's footer doesn't hide that offer), checking a running one once an hour.
  if pr=$(plugin_root) && [ "$pr" != "$(find_root)" ]; then
    s=$DIR/.footer-elsewhere ask=", for the plugin coordinator, which isn't running — start it? (feedback coordinator --start)"
  else pr=; fi
  ! due "$s" || [ "$(cat "$s" 2>/dev/null)" = "$hour" ] || { p=$("$0" count --plugin)
    if [ -n "$p" ] && [ -n "$pr" ]; then
      pc_live "$pr" >/dev/null; case $? in 1) ;; 0) p=; shown "$s" "$hour" ;; *) p= ;; esac   # unknown: the next sweep asks
    fi
    [ -z "$p" ] || shown "$s"; }
  ! due "$P/.footer-shown" || { q=$("$0" count --project); [ -z "$q" ] || shown "$P/.footer-shown"; }
  [ -n "$p$q" ] || exit 0
  l=${p:+plugin feedback: $p$ask}
  [ -z "$q" ] || l="${l:+$l · }project feedback: $q, for the next R&D run"
  echo "$l" ;;
mark) [ -f "${2:-}" ] || die "usage: feedback mark FILE sent URL | fixed WHAT | dropped"; shift; cases mark "$@" ;;
mode)
  m=$(config feedback.mode 2>/dev/null)
  if [ -n "$m" ] && [ "$m" != auto ]; then echo "$m"
  elif [ -n "$(config feedback.repo_dir 2>/dev/null)" ]; then echo pr
  elif gh auth status >/dev/null 2>&1 && gh repo view "$(repo)" >/dev/null 2>&1; then echo fork-pr
  else echo issue; fi ;;
repo) repo || { echo "plugin.json names no GitHub repository" >&2; exit 1; } ;;
coordinator)
  case ${2:-} in ''|--start) ;; *) die "usage: feedback coordinator [--start]" ;; esac
  r=$(plugin_root) || die "no plugin coordinator: config feedback.repo_dir is unset (features/plugin-coordinator.md)"
  n=$(pc_name "$r"); pc_live "$r"
  case $? in 0) exit 0 ;; 1) ;; *) echo "an account's session listing failed, so whether $n runs is unknown: try again" >&2; exit 3 ;; esac
  [ "${2:-}" = --start ] || { echo "the plugin coordinator ($n) isn't running: feedback coordinator --start opens it" >&2; exit 1; }
  # -n: other roots find it by that name before open_pane names it. SESSION_STATUS_CLAUDE: the claude command, as for
  # --successor (a dev build's `claude --plugin-dir DIR`).
  cmd="${SESSION_STATUS_CLAUDE:-claude} -n $n 'Act as a coordinator'"
  load_terminal; out=$(open_view "$n" "$r" "$cmd" 2>&1); rc=$?
  case $rc in
    0) [ "${out#reused}" = "$out" ] || { echo "a tab titled \"$n\" is open already ($out), so nothing started: close it, or run $cmd there"; exit 1; }
       echo "started $n in $(tilde "$r") ($out): it reads the open cases at its Start" ;;
    2) echo "no terminal opens it here (config terminal): run in a new terminal: cd $(printf %q "$r") && $cmd"; exit 1 ;;
    *) echo "opening it failed ($out): run in a new terminal: cd $(printf %q "$r") && $cmd"; exit 1 ;;
  esac ;;
label) echo "$LABEL" ;;
scrub)
  shift; [ $# -gt 0 ] || die "usage: feedback scrub FILE…"
  # The deny list, from this machine: literal strings (whole words, any case) and patterns.
  lit=$(mktemp) keys=$(mktemp) v=$(mktemp); trap 'rm -f "$lit" "$keys" "$v"' EXIT
  # Cases come from every project, so every project root a case was added in or this person's sessions ran in adds to it.
  roots=$({ pwd -P; cat "$DIR/.roots" 2>/dev/null; list_sessions --all 2>/dev/null | cut -f6; } | sort -u | while read -r d; do
    [ -d "$d" ] && (cd "$d" && find_root); done | sort -u)
  echo '[A-Z][A-Z0-9]+-[0-9]+' > "$keys"   # session-status's default task key
  { echo "$HOME"; id -un; git config user.email; git config user.name
    while read -r d; do
      [ -n "$d" ] || continue; echo "$d"; basename "$d"
      # Their remotes' owner and repo names, and each one's key pattern and the hosts its adapter talks to.
      git -C "$d" remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[:/]([^/:]+)/([^/]+)$#\1\n\2#'
      (cd "$d" && config key_pattern 2>/dev/null) >> "$keys"
      a=$(adapter_path "$d") || continue
      (cd "$d" && "$a" key-pattern 2>/dev/null) >> "$keys"   # the adapter contract: cwd = its project root
      grep -oE 'https?://[A-Za-z0-9.-]+' "$a" | sed 's#.*://##'
      # Strings in its person and repo config (chat ids, names, domains), skipping the enum values.
      (cd "$d" && coord_json) | jq -r 'paths(strings) as $p | select(($p[-1] | tostring) | test("^(tracker|host|terminal|messages|rule|mode)$") | not)
        | getpath($p)' 2>/dev/null
    done <<<"$roots"
  } | grep -E '^.{3,}$' | grep -vxiE 'session-orchestration|claude-plugins|github\.com|none|true|false|main|master|src|repo' | sort -u > "$lit"
  # Login and each part of the name, however short: "Pat saw it" names the person too.
  { id -un; git config user.name | tr -s ' ' '\n'; } | grep . >> "$lit"
  k=$(grep -E . "$keys" | sort -u); printf '%s\n' "$k" > "$keys"   # no empty line: it would match every line
  r=$(repo) && repo_url=https://github.com/$r || repo_url="no repository"
  bad=0 q=\'
  for f in "$@"; do
    [ -f "$f" ] || { echo "$f: not a file"; bad=1; continue; }
    # The checks read the case with the plugin's own names replaced by `plugin` (its repo URL, name, script and state
    # paths), line for line, so naming the plugin is never a hit.
    while IFS= read -r l || [ -n "$l" ]; do
      for s in "$repo_url" '~/.cache/session-status' '~/.local/state/session-orchestration' '~/.config/session-orchestration' \
          session-orchestration session-status; do l=${l//"$s"/plugin}; done
      printf '%s\n' "$l"
    done < "$f" > "$v"
    { [ ! -s "$lit" ] || grep -niwF -f "$lit" -- "$v" | sed 's/:/\tnames a local name\t/'
      grep -nE -f "$keys" -- "$v" | sed 's/:/\ta task key\t/'
      grep -nE "(^|[[:space:](\`\"$q=])(/|~/)[A-Za-z0-9._-]+/[A-Za-z0-9._-]+" "$v" | sed 's/:/\tan absolute path\t/'
      grep -nE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' "$v" | sed 's/:/\tan email address\t/'
      grep -noE "https?://[^[:space:])>\`\"$q]+" "$v" | cut -d: -f1 | sed 's/$/\ta URL other than the plugin'\''s/'
      grep -nE '[0-9a-fA-F]{16,}' "$v" | sed 's/:/\ta long hex string\t/'
      grep -noE '[A-Za-z0-9+/=_-]{24,}' "$v" | grep -E '^[0-9]+:.*[A-Z]' | grep -E '^[0-9]+:.*[a-z]' | grep -E '^[0-9]+:.*[0-9]' | cut -d: -f1 | sed 's/$/\ta token-like string/'
      # Every line of a fenced block must be the plugin's own code.
      awk '/^```/ { in_ = !in_; next } in_ && NF { print NR "\t" $0 }' "$f" |
        while IFS=$'\t' read -r n code; do
          code=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<<"$code")
          grep -rqF -- "$code" "$LIB_DIR" || printf '%s\tcode not from the plugin\n' "$n"
        done
    } | sort -t$'\t' -k1,1n -u | while IFS=$'\t' read -r n why _; do
      printf '%s:%s: %s: %s\n' "$f" "$n" "$why" "$(sed -n "${n}p" "$f")"
    done | grep . && bad=1
  done
  exit "$bad" ;;
*) sed -n '/^# Usage:/,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
