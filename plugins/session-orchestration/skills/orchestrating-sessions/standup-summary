#!/bin/bash
# standup-summary: session-status --yesterday's text on stdin → what the user would say at the daily standup, a few
# spoken sentences, written by a small model (`claude -p --model haiku`, no tools, no plugins or hooks, no transcript;
# about $0.003 and 5-15s a run). The pane's Yesterday tab shows it in place of the lists (s swaps).
# ponytail: no lock, so two refreshes on one cache miss both pay a run; the pane only starts one per reading.
# Cached per start day in ${XDG_CACHE_HOME:-~/.cache}/session-orchestration/standup/DAY.txt and written again only
# when that day's data changes: its fingerprint leaves out sessions' spans and last text lines, which move at every
# refresh while a session works. Exit 1 with the reason on stdout when the model call fails (or takes over 90s).
# SESSION_STATUS_SUMMARY_MODEL picks another model; standup-summary.test.sh runs it against a stub claude.
set -uo pipefail

PROMPT="You turn a developer's raw activity log into what they would say at the daily standup: first person, plain
spoken text, 3 to 5 short sentences, about 60 to 90 words. No lists, no markdown, no times, no commit or PR numbers.
The log's first line is today, the second since when: if that day is the weekday before today, talk about it as
yesterday; else say \"on Friday\", \"since Thursday\" and so on. Lead with what got finished (merged, moved to test),
then what went to review or is in progress, then what waits on someone else. Mention at most the five things that
matter most.
Say what each piece of work is in a few plain words a teammate would understand. An uppercase tracker key (like
ABC-123) may stay, once, followed by those words; never a key alone. Never say a session name or a lowercase task id:
quoted names and lowercase slugs (like \"cache-ttl-cleanup\") are labels, not speech; say what the work did instead
(\"shortened how long the cache keeps entries\"), taken from the log's titles and text. Sessions' lines address the
developer as \"you\": you are the developer, so \"until you grant me access\" becomes \"waiting on access\".
Lines starting with \"Note:\" are facts about the project from the developer: follow them, never repeat them.
Skip noise: probes, sessions that did nothing, tickets only someone else touched. If the log shows nothing, say so in
one sentence."

summarize() {
  local input day fp cache out
  input=$(cat)
  day=$(sed -n '1s/^Since: \([0-9-]*\).*/\1/p' <<<"$input")
  [ -n "$day" ] || { echo "no Since: line in the input"; return 1; }
  local model=${SESSION_STATUS_SUMMARY_MODEL:-haiku} d pid w rc out err text
  # The session lines' format is session-status --yesterday's (`session "NAME" (SPAN): LAST`): keep the two in step.
  # The model and prompt count too, so changing either writes it again.
  fp=$( { echo "$model"; echo "$PROMPT"; sed -E 's/^(  [^	]*	)?(session|reviewed in session) ("[^"]*").*/\2 \3/' <<<"$input" |
    sort -u; } | shasum -a 256 | cut -c1-16)
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/session-orchestration/standup
  mkdir -p "$cache" || return 1
  if [ "$(head -1 "$cache/$day.txt" 2>/dev/null)" = "$fp" ]; then tail -n +2 "$cache/$day.txt"; return 0; fi
  # Its own empty folder: a print run still reads the cwd's settings, and nothing here is the project's. exec: the
  # pid killed at 90s is claude's own; files, not a pipe, so nothing waits on it after.
  d=$(mktemp -d) || return 1
  ( cd "$d" && exec claude -p --model "$model" --tools "" --safe-mode --no-session-persistence --max-budget-usd 0.1 \
    --system-prompt "$PROMPT" --output-format json ) <<<"Today: $(date '+%a %F')"$'\n'"$input" > "$d/out" 2> "$d/err" &
  pid=$!
  # &&: a sleep killed below skips the kill, so a reaped pid that got reused is never hit.
  { sleep "${STANDUP_SUMMARY_CAP_S:-90}" && kill "$pid"; } >/dev/null 2>&1 & w=$!
  disown "$w"   # killed below once claude is done: no "Terminated" line from bash
  wait "$pid" 2>/dev/null; rc=$?   # nor one for claude killed at the cap
  pkill -P "$w" sleep 2>/dev/null; kill "$w" 2>/dev/null
  out=$(cat "$d/out"); err=$(head -c 200 "$d/err"); rm -rf "$d"
  text=$(jq -r 'select(.is_error != true) | .result // empty' <<<"$out" 2>/dev/null)
  if [ "$rc" != 0 ] || [ -z "$text" ]; then
    echo "model call failed$([ "$rc" = 0 ] || echo " (exit $rc)"): $(jq -r '.result // empty' <<<"$out" 2>/dev/null | head -c 200)${err:+ $err}"
    return 1
  fi
  printf '%s\n%s\n' "$fp" "$text" > "$cache/$day.txt"
  printf '%s\n' "$text"
}

summarize
