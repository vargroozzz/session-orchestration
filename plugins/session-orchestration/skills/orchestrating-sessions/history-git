#!/usr/bin/env bash
# history-git: a local git history of the project's replies folder (the CLAUDE.md section's) and its handoff files
# (config pending.file: FILE = DIR/NAME.md, with NAME/, NAME-archive/ and NAME-archive.md beside it). A folder's repo
# keeps its git dir outside it, STATE/session-orchestration/history/<the folder's path, other characters as ->.git
# (core.worktree: the folder): no .git appears in the folder, so a worktree-isolated session writes there as before and
# a handoff folder inside a project checkout isn't a nested repo. A repo set up by hand is adopted instead: the folder's
# own or its parent's, with no remote, not the project root. Never pushed: no remote is ever added and a pre-push hook
# refuses every push. Dumps stay out: a file over 1 MB goes into the repo's info/exclude (untracked if it was tracked).
#   history-git commit         Stop hook: commits what changed in the cwd project's folders, a commit per folder,
#                              message `ID8: NAMES`, made on the first run. The folders are looked up again after 10
#                              minutes.
#   history-git versions FILE  FILE's committed versions, oldest first, as pending-diff.jq's records ({k: "v", v, t, i,
#                              s, turn}); exit 1 when FILE has no repo or no commit.
#   history-git run replies|handoff [GIT ARGS…]   git on that folder's repo (default: log --stat).
# Self-test: bash history-git.test.sh
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
here=$(cd "$(dirname "$0")" && pwd)
C=${XDG_CACHE_HOME:-$HOME/.cache}/session-status
H=${XDG_STATE_HOME:-$HOME/.local/state}/session-orchestration/history
MAX_KB=1024
sum() { printf %s "$1" | cksum | cut -d' ' -f1; }
g() { local d=$1 t=$2; shift 2; git --git-dir="$d" --work-tree="$t" -c user.name=session-orchestration \
  -c user.email=session-orchestration@localhost -c commit.gpgsign=false "$@"; }

# repo DIR [init]: GITDIR<TAB>TOP (TOP: the repo's work tree, DIR or the parent of an adopted one); with init it is made
# when missing. Fails when there is none. Needs ROOT.
repo() {
  local d t gd
  d=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  t=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)
  # never the project's own repo or one holding it (a monorepo, a home folder's)
  if [ -n "$t" ] && case $ROOT/ in "$t"/*) false ;; esac && { [ "$t" = "$d" ] || [ "$t" = "$(dirname "$d")" ]; } &&
     [ -z "$(git -C "$t" remote 2>/dev/null)" ]; then
    gd=$(git -C "$t" rev-parse --absolute-git-dir) || return 1
  else
    gd=$H/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$d").git; t=$d
    if [ ! -d "$gd" ]; then
      [ "${2:-}" = init ] || return 1
      mkdir -p "$H" && git init -q --bare "$gd" && git --git-dir="$gd" config core.bare false &&
        git --git-dir="$gd" config core.worktree "$d" && mkdir -p "$gd/hooks" &&
        printf '#!/bin/sh\necho "a local history repo (session-orchestration): never pushed" >&2\nexit 1\n' > "$gd/hooks/pre-push" &&
        chmod +x "$gd/hooks/pre-push" || return 1
    fi
  fi
  printf '%s\t%s\n' "$gd" "$t"
}

# targets: DIR<TAB>GLOB per folder to keep (GLOB: the names in DIR to keep, empty for all). Needs ROOT and lib.sh.
targets() {
  local r p
  r=$(replies_path "$ROOT"); [ -n "$r" ] && [ -d "$r" ] && printf '%s\t\n' "$r"
  p=$(config pending.file 2>/dev/null) && [ -n "$p" ] && [ -f "$ROOT/$p" ] &&
    printf '%s\t%s\n' "$(dirname "$ROOT/$p")" "$(basename "$p" .md)*"
  return 0
}

# commit_one GITDIR TOP DIR GLOB [WHO]
commit_one() {
  local gd=$1 t=$2 d=$3 glob=$4 f rel names
  d=$(cd "$d" && pwd -P) || return 0
  [ -z "$(find "$gd/index.lock" -mmin +1 2>/dev/null)" ] || rm -f "$gd/index.lock"   # left by a killed git
  # shellcheck disable=SC2086   # GLOB expands to the handoff files
  (cd "$d" && find ${glob:-.} -name .git -prune -o -type f -size +${MAX_KB}k -print 2>/dev/null) | while read -r f; do
    rel=$(sed 's/[][*?\\!#]/\\&/g' <<<"${d#"$t"}/${f#./}")   # escaped: a gitignore pattern
    grep -qxF -- "$rel" "$gd/info/exclude" 2>/dev/null || { mkdir -p "$gd/info"; echo "$rel" >> "$gd/info/exclude"; }
    (cd "$d" && g "$gd" "$t" rm -q --cached --ignore-unmatch -- "$f")
  done
  # only these paths, staged and committed: an adopted repo's other staged changes stay the user's
  cd "$d" && g "$gd" "$t" add -A -- "${glob:-.}" 2>/dev/null || return 0
  g "$gd" "$t" diff --cached --quiet -- "${glob:-.}" && return 0
  names=$(g "$gd" "$t" diff --cached --name-only -- "${glob:-.}" | sed 's#.*/##' | awk '!s[$0]++' | head -6 | paste -sd' ' -)
  g "$gd" "$t" commit -q --no-verify -m "${5:-user}: $names" -- "${glob:-.}" >/dev/null
}

case ${1:-} in
  commit)
    { read -r sid; read -r cwd; } < <(jq -r '.session_id // "", .cwd // ""' 2>/dev/null)
    [ -n "${cwd:-}" ] && cd "$cwd" 2>/dev/null || exit 0
    mkdir -p "$C"; w=$C/history-where-$(sum "$PWD")
    # shortcut: a config or CLAUDE.md change shows within 10 minutes; look up each time if that ever matters
    if [ -z "$(find "$w" -mmin -10 2>/dev/null)" ]; then
      ( . "$here/../../lib.sh" || exit 0; ROOT=$(find_root)
        targets | while IFS=$'\t' read -r d glob; do r=$(repo "$d" init) && printf '%s\t%s\t%s\n' "$r" "$d" "$glob"; done
      ) > "$w.$$" 2>/dev/null; mv "$w.$$" "$w"
    fi
    while IFS=$'\t' read -r gd t d glob; do
      [ -d "$gd" ] && [ -d "$d" ] && commit_one "$gd" "$t" "$d" "$glob" "${sid:0:8}"
    done < "$w" >/dev/null 2>&1
    exit 0 ;;
  versions)
    . "$here/../../lib.sh" || exit 1; ROOT=$(find_root)
    [ -f "${2:-}" ] || exit 1
    IFS=$'\t' read -r gd t < <(repo "$(dirname "$2")") && [ -n "${gd:-}" ] || exit 1
    rel=$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2"); rel=${rel#"$t"/}
    # the commits that leave FILE there, then all their versions in one cat-file, each after a `@@V` line
    list=$(g "$gd" "$t" log --reverse --diff-filter=d --format='%H %ct %s' -- "$rel" 2>/dev/null); [ -n "$list" ] || exit 1
    cut -d' ' -f1 <<<"$list" | sed "s#\$#:$rel#" | g "$gd" "$t" cat-file --batch='@@V %(objecttype)' |
      jq -cRn --arg list "$list" '[$list | split("\n")[] | capture("^(?<h>\\S+) (?<t>\\d+) ?(?<s>.*)$")] as $c
        | reduce inputs as $l ({v: [], cur: null}; if $l | startswith("@@V ") then .v += [.cur // empty] | .cur = ""
            else .cur += $l + "\n" end) | (.v + [.cur]) as $v   # cat-file ends each one with a newline more
        | range(0; $v | length) as $i | {k: "v", v: $v[$i][:-1], t: ($c[$i].t | tonumber | todate | sub("Z$"; ".000Z")),
            i: ($i + 1), s: ($c[$i].s | sub("[: ].*$"; "")), turn: ""}' ;;
  run)
    . "$here/../../lib.sh" || exit 1; ROOT=$(find_root)
    case ${2:-} in
      replies) d=$(replies_path "$ROOT") ;;
      handoff) p=$(config pending.file 2>/dev/null) && [ -n "$p" ] && d=$(dirname "$ROOT/$p") ;;
      *) echo "usage: session-status --git-history replies|handoff [GIT ARGS…]"; exit 2 ;;
    esac
    [ -n "${d:-}" ] || { echo "no $2 folder configured for $ROOT"; exit 2; }
    IFS=$'\t' read -r gd t < <(repo "$d") && [ -n "${gd:-}" ] ||
      { echo "$d has no history repo yet: the Stop hook makes one when a turn ends"; exit 2; }
    shift 2; [ $# -gt 0 ] || set -- log --stat
    cd "$d" && g "$gd" "$t" "$@" ;;
  *) echo "usage: history-git commit | versions FILE | run replies|handoff [GIT ARGS…]"; exit 2 ;;
esac
