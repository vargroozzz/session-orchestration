#!/usr/bin/env bash
# One line per task: status, local worktree state, owning session. Then: sessions waiting on the user, and
# leftovers (sessions/worktrees of finished tasks). No LLM involved.
#
# The project root is the nearest directory up from $PWD holding an executable .claude/session-status-adapter,
# else the git toplevel, else $PWD. The adapter (that one, else a committed .claude/coordination/session-status-adapter
# once trusted: lib.sh adapter_path) answers (one call per run, cwd = project root):
#   tasks [ARG…]   KEY<TAB>STATUS<TAB>TITLE<TAB>EXTRA per task, in display order. EXTRA is printed verbatim
#                  between STATUS and the worktree column (end it with its own separator, e.g. "| ").
#                  On failure: exit non-zero with the message on stdout; the board prints without tracker columns
#                  under `adapter tasks failed (exit N): MESSAGE` (none: stderr's last line); --changes exits 1 with
#                  the message instead. Exit 2 with nothing on stderr = not answered: the
#                  no-adapter rows below (an adapter with only `pending`, `urls` or `key-pattern` needs no `tasks`).
#                  After a sweep exits 2, the pointed-at keys that `done` doesn't report are looked up
#                  (`tasks KEY…`); its rows replace the bare ones, and the finished keys go to Leftovers.
#                  The coordinator pane groups and acts on these words in EXTRA, whitespace-separated:
#                    REPO#ID OPEN|MERGED   a PR (OPEN: In review; +NAME too: Landing)
#                    +NAME / !NAME         approved by / changes asked by NAME (!: Address comments); the
#                                          phrases `approved by NAME` / `changes requested by NAME` mean the same
#                    no-human-approval     open, waiting for a reviewer
#                    CONFLICT              merge conflict (Resolve conflicts)
#                    CI-FAILED             the PR's latest build failed (Fix CI)
#                    ↩MM-DD NAME→STATUS    the tracker sent it back
#                    (PRs as of HH:MM)     the PR words are from that time
#                  Anything else shows only in the item's details.
#                  A line `fix: LABEL → COMMAND` instead of a task (on success or failure) is printed as is after the
#                  rows; the coordinator pane offers it as an action while it's there. Never print outside text
#                  (a tracker's error, a message) at the start of a line: indent it, so it can't pose as one.
#   done KEY…      KEY[<TAB>LABEL] for each key that's finished; feeds "Leftovers" and "Resolved". A key it doesn't
#                  name with no row (or, when `tasks` with no keys doesn't answer, no status or PR on its row) is
#                  finished too once its session's last `done` reply for it the reply tool let through says so
#                  (reported_done): `report` with no prompt since (label
#                  `reported done`), or `pr`/`pushed` whose worktree landed (`landed`).
#   key-pattern    one ERE matching a task key (default: the config's key_pattern, else [A-Z][A-Z0-9]+-[0-9]+).
#   status-names   regex of the project's own status-command names (its wrapper); see below.
#   repos          git repos to look for worktrees in, one per line, relative to the root (default: the root
#                  if it's a repo, else its child repos).
#   pending        the coordinator's handoff text, printed as is by --pending (the coordinator pane shows it).
#   urls           link templates for the coordinator pane, one per line: `ticket URL` with {key}, `pr URL`
#                  with {repo} and {id} (a PR shows in EXTRA as repo#id). Printed as is by --urls.
#   session-dirs   more directories whose sessions belong to the project (absolute or ~/…, one per line), e.g. a
#                  tooling repo its coordinator starts sessions in. Their sessions never own a task: they show
#                  under "Other sessions". Default: the root only.
#   notices        short lines about things outside the tracker (new chat messages, mentions), one per item, on
#                  the sweep only; printed under "Notices". A line should stay the same while its item does.
#                  --changes reports a new or changed notice but not one that went away (read, answered).
#                  Exit 1 = failed, reason on stdout: the last good notices are shown, plus the reason. Other
#                  non-zero = not supported. Capped at 60s, which counts as a failure.
#                  A messages module (`messages` in the config: lib.sh, messages/msgraph.md) runs beside it, the
#                  same way; its lines come first. --messages-file prints where it keeps the message behind each line;
#                  --messages-forward LINE prints it ready to route (msgraph.md, Routing).
#   pr-keys REPO#ID  the task keys a PR names (branch, title), one per line; exit non-zero when it can't tell. For
#                  a messages module tagging PR links.
#   mine           the task keys you own, one per line; a messages module marks notices for them. Default: the
#                  keys of the last sweep's rows.
# "Waiting on you" leaves out a task's worker at rest whose row only waits on a reviewer (no-human-approval, nothing
# to fix): its row shows it idle. It adds `— blocked: TOOL `INPUT`` while hooks/blocked.sh's record of the prompt is newer than the
# session's transcript; that line appearing is a change. Any other blocked session is listed only while verdict
# (below) says it waits on the user; a prompt unanswered SESSION_STATUS_STALE_HOURS (6) goes under "Stale prompts"
# with its stop command instead (not compared by --changes).
# --changes also skips a row whose only change is its session flipping between working, idle and blocked, or entering
# `working`, or its worktree's counts
# changing while it works, and "Waiting on you" churn: an entry appearing, or going away while its session
# lives on (states of the sweep's sessions are kept in ~/.cache/session-status/<project>.agents). A
# live sub-coordinator's row compares as its key, session column and `sub: STATE` only: a chunk landing (the plan
# count, the tracker status, its PRs) wakes no one, the sub's own watcher (--watch KEY) included; its report's state
# changing, or the sub going, does.
# "Resolved (idle a week)": leftovers idle 7 days (SESSION_STATUS_RESOLVE_DAYS) whose removal loses nothing (a
# session idle or done; a clean worktree whose commits are merged or on origin): by transcript, last commit and folder times.
# --changes doesn't compare that section: an item moving there, or going away from it, isn't news.
# "Other sessions": live sessions that own no row (no task, a reviewer, a session dir) and aren't blocked (Waiting
# on you has those), coordinators (ran --start, --changes, --watch or --owner, or opened the pane) left out: `"NAME" STATE AGE[ · reviews KEY][ — LAST TEXT] (PREFIX attach ID)`.
# AGE is since start while working, else since its transcript was last written; idle or done ones drop off at
# SESSION_STATUS_OTHER_HOURS (3), unless at rest (blocked: still running) or superseded. --changes doesn't compare it either.
# A session folded into a live sub-coordinator's row (see Sub-coordinator below) shows in no footer section but Waiting
# on you, and there only on a prompt (`— blocked:`); the sub's own sweep shows them all.
# "Stale": `* ask ID KEY: REASONS`, `* pending "LABEL": REASONS`, `* session "NAME" (ID8)[ KEY]: decision not on the
# pane` (stale.jq). --changes reports an item once per wording (a new reason is a new wording), not one going away.
# Owners: a review session (`Session task: KEY review`, "review" ending the marker) never owns KEY. Task markers
# count only from a session's own text and the messages it received (its prompts, a SendMessage brief), not its
# tool inputs (a brief it sends names another session's task). A first prompt names a key only at its start, and
# beats any marker. The `maybe` guess skips a session whose first prompt names another key. A session in a
# session-dir never owns a task.
# A call the adapter doesn't answer exits non-zero and the default applies. With no adapter (or `tasks` exiting 2),
# rows are the keys named by running sessions and worktree branches; "Leftovers" has only the reported_done ones.
#
# Usage: session-status              all open tasks
#        session-status KEY [KEY…]   these tasks; no footer (it covers all sessions). A key with a live sub-coordinator
#                       lists its folded sessions under `Under KEY-coordinator:` (`"NAME" STATE (PREFIX attach ID)[ — blocked: …]`)
#        session-status ARG…         other args go to the adapter's `tasks`
#        session-status --start [args]   a coordinator's Start in one run: the status, the handoff file, the last
#                       handover note, the replies written since it (else in the last day) with their first lines,
#                       the pane answers still to act on (at most 5), and the coordination config with each enabled
#                       feature's start step; when there are any, the
#                       sessions that ended while the background service was off (or failed) with a task still open
#        session-status --resume-ended [--pause SECS] ID…   resume those one at a time, SECS (60) apart, each checked
#                       against the live list first
#        session-status --changes [args]   only lines changed since the previous --changes run
#        session-status --stale [args]   the sweep's "Stale" section alone: queued asks and handoff entries whose facts
#                       moved on, sessions asking the user with no ask queued (stale.jq has the signals); flags only
#        session-status --watch [--every SECS] [args]   block until --changes reports something at two polls in a
#                       row (or fails 3 in a row), print it and exit; checks every SECS (default 1800). Every
#                       SESSION_STATUS_TICK_S (60) it also prints "Idle: NAME (ID8): its last line" for each of the
#                       project's background sessions whose turn ended without a reply or a background task to wait
#                       on, and exits. Run it in the background, re-arm; no loop around it.
#        session-status --pending       the adapter's `pending` text only
#        session-status --pending-done LABEL [--] REASON   archive a handoff entry (config pending.file; `pending`)
#        session-status --pending-history LABEL [--last N] | --find KEY | --scan | --seed   an entry's history
#        session-status --git-history replies|handoff [GIT ARGS…]   git on the folder's local history repo (history-git)
#        session-status --urls          the adapter's `urls` text only
#        session-status --root          the project root: where the adapter and .claude/coordinator-actions.json are
#        session-status --agents        the sessions the last sweep saw: id, name, state, command prefix, started
#                       (epoch s), cwd, kind, status, pid (tabs)
#        session-status --activity      what each live session is doing, fresh, no tracker calls: id, name, state,
#                       transcript written (epoch s), doing, since (epoch s, 0 unknown), last text line, context
#                       tokens, context window, status (idle/busy/waiting), kind, cwd, command prefix (tabs); see
#                       session-activity.jq. --activity --all-projects: every project's sessions, not only this one's
#        session-status --peek ID [N]   a session's last N (12) prompts, texts and tool calls as Markdown, then
#                       what it's doing now (session-peek.jq); any project, any account; ID may be Desktop's local_ id
#        session-status --search TEXT [days]   one line per hit of TEXT (default the last 7 days) in sessions' prompts,
#                       messages and own text, any project and account: NAME (ID8) · date · who: snippet, masked
#                       and capped (retro.py search); --peek ID for more
#        session-status --dir KEY|ID…   the folder a task or session works in (the first argument that resolves):
#                       KEY's worktree; for an ID, the git top of its latest cwd (its transcript), else that cwd
#        session-status --diff KEY|ID…  that folder's changes since its merge-base with origin/HEAD, committed or
#                       not: `DIR · vs BASE`, the --stat lines and untracked `?? FILE`s, a blank line, the patch
#        session-status --compact ID   an idle background session runs /compact (stopped, resumed with it)
#        session-status --stop ID      stops a live session in any listed account and waits until its process ends
#                       (the pane's Stop); exit 3 mid-turn or being compacted, 2 not listed, 1 the listing or stop failed
#        session-status --send-when-idle [--here] ID TEXT   wait until it isn't busy, then deliver TEXT without forking
#                       it; --here: a session under another account is moved to yours (same id and name), so you can
#                       SendMessage it next
#        session-status --coordinator   names of this account's live coordinator sessions (ran --start,
#                       --changes, --watch or --owner, or opened the pane), newest first, excluding the caller (a
#                       ready successor NAME-next before an old one still holding NAME), then
#                       (features.accounts on) another account's by their live socket's uds: address; no tracker calls.
#                       A caller whose first prompt names KEY gets the live KEY-coordinator (its sub-coordinator,
#                       first prompt `Coordinate KEY`) before them; a sub-coordinator is listed to no other caller
#        session-status --address NAME|ID [--other]   the uds: address SendMessage reaches a live session at, any
#                       listed account (--other: another one's only, by exact name, exit 4 when this one's matches,
#                       3 whenever a listing failed); exit 1 no live socket, 2 none or several match, 3 a listing failed
#        session-status --coordinator-of DIR [--start]   the coordinator of DIR's project when it's another than
#                       this one (a subproject, the parent): its name; exit 1 not running (--start opens it), 3 listing
#                       failed, 4 none of its own (--start opens a new one there), 5 nothing opened
#        session-status --coordinators   every coordinated project of this person (registered at its coordinator's
#                       --start): NAME · ROOT · ACCOUNT · running or not · PURPOSE, under any account
#                       ; then Remote: the person's coordinators on their other computers (--remote add) and links
#        session-status --remote add NAME --purpose 'LINE' | --remote remove NAME   one of the person's coordinators on
#                       another computer, same claude.ai account (features/remote.md), listed under --coordinators
#        session-status --link create|join|send|list|fetch|renew|remove …   a link to a coordinator under another
#                       account or another person's, through a shared private GitHub repo (features/remote.md, Links)
#        session-status --purpose 'LINE'   writes this project's config coordinator.purpose (what its coordinator is
#                       for; --coordinators lists it), to the project's .claude/coordination.local.json
#        session-status --owner KEY…   who owns each task and why: the row's session, then each candidate
#                       (first prompt, marker, review, maybe) with its state, first prompt line and markers
#        session-status --handover ID|--self [--model M] [--effort E] [--escalate] [--] 'WHAT NEXT'   a task or chunk
#                       session too big to resume is stopped and a fresh one takes its task over, under its name, from the replies
#                       folder's KEY.md (a chunk: KEY-build.md's handoff); --self, a session hands itself over at its
#                       context mark, coordinator or not (see the block)
#        session-status --prev-name [NAME]   NAME-prev-K, the name a session renames itself to when it hands off: K the
#                       lowest free number over every listed session name (NAME: the caller's own); --title also
#                       titles the caller's terminal tab with it
#        session-status --successor [--account DIR] | --successor --done | --await ready|renamed|name|done [--timeout S] |
#                       --name-check NAME   a coordinator hands itself over to NAME-next it starts (see the block;
#                       handover.md)
#        session-status --inbox [--read N…|all] | --inbox-add [--from WHO] [SENDER_ID] < TEXT   the coordinator
#                       inbox: messages no live coordinator took (the reply tool's backstop), unread ones printed
#        session-status --inbox-add --root DIR < TEXT   a coordinator queues TEXT in DIR's project coordinator inbox,
#                       under any account (features/accounts.md, Messaging another project's coordinator)
#        session-status --inbox --sent   what this coordinator queued that way, each marked unread, read or gone; the
#                       status sweep's Sent footer lists the unread ones
#        session-status --report-file SESSION_ID [KEY] < REPORT   the reply tool's report: the top of
#                       <replies>/<KEY>.md (no KEY: that session's name), its `## Handoff` kept; a chunk's goes to
#                       <KEY>-cN-report.md, and one over a plan without a plan heading to <KEY>-report.md; a
#                       `# ` section it drops (a deliverable) moves to <KEY>-archive.md
#        session-status --report-publish FILE --kind KIND [--allow-markers]   may this session publish the report FILE
#                       as a private claude.ai page: `publish: yes` or `publish: no (why)`, exit 1
#                       (features/report-artifacts.md)
#        session-status --report-artifact SESSION_ID KEY KIND FILE URL VERSION_ID   the reply tool's artifact: the
#                       page's row in <replies>/report-artifacts.tsv; the sweep's Report pages footer lists open rows
#        session-status --init [--check | --write …]   set this folder up for coordination: the setting-up-coordination
#                       skill's session-init documents the modes; runs in the cwd, not the root
#        session-status --land TARGET   fast-forward TARGET, checked out in another worktree, to HEAD (a worker's
#                       approved landing in a project that lands by fast-forward), that checkout's files too
#        session-status --land OWNER/REPO#N   land GitHub PR N (a worker's approved landing): merge, wait until merged,
#                       watch the CI runs on main; one line at the end. Minutes long: run it in the background
#        session-status --config KEY   a config value (lib.sh at the plugin root lists the keys), e.g. approvals.delegate
#        session-status --pane-section SLUG open|line|hidden   how the coordinator pane draws a section (config
#                       pane.sections), written to the project's .claude/coordination.local.json; a title press runs it
#        session-status --approvals   the live approval answers clicked in this coordinator's pane (and its
#                       predecessors'), with the hours left and the relays sent of each
#        session-status --relay KEY [ACTION]   the approval block for KEY's newest live pane answer, verified as the
#                       worker will verify it, to send as is once its Quote approves ACTION (none: the Action the
#                       ask set, ending its answer; exit 1 with why when there's none, it is a No or the check fails)
#        session-status --kind KIND[:S|M|L] [NAME [--anyway]]   `--model M --effort E` from plan.models.KIND for a task
#                       start (a size moves the effort a step), logged as a usage start line (NAME, the -n session name,
#                       hashed); ` --advisor A` too where config plan.advisor.KIND is set and pairs with the model. A
#                       NAME starting with a task key runs --claim on it first (not for review, retro or research;
#                       coordinator: KEY-coordinator claims KEY), its lines on stderr; its exit 3 is --kind's: nothing
#                       printed, don't start. NAME: a letter or digit, then letters, digits, `.`, `_`, `-`, at most 80
#        session-status --claim KEY|NAME [--anyway]   ownership on start: exit 3 (not started) when the adapter's
#                       `owner KEY` says other or an origin branch naming KEY has another author's commits; the ask
#                       to put on the pane is its last line. Unassigned (none): `claim KEY`. --anyway (the user's
#                       start anyway): passes, claims nothing. KEY `#N`: a GitHub issue (no session name carries one)
#        session-status --launch NAME --kind KIND[:S|M|L] [--anyway] [--at WHEN | --after-reset [ACCOUNT]] [--] 'WHAT' 'WHY' 'DONE-WHEN' | --brief-file FILE
#                       a task start in one command: --kind, then the brief built from the three texts (or FILE's
#                       text, verbatim), started as NAME; --at or --after-reset queues it for a running --watch to start then. Not for coordinator,
#                       nor review named KEY-<more> (a review of KEY's task: its own first prompt)
#        session-status --launch --list | --cancel NAME | --now NAME [--anyway]   the queued starts; drop one; start
#                       one at once
#        session-status --plan FILE [--check | --next | --brief N | --done N]   a design's plan table: waves and chunk
#                       states, its problems (exit 1), the `claude --bg` lines of the runnable chunks, row N's brief
#                       skeleton, or (run by chunk N once it landed) its usage chunk line
#        session-status --open view [--account DIR] TITLE DIR -- CMD…   (or `--open split [--account DIR] DIR -- CMD…`)
#                       opens CMD in a tab or split of the configured terminal (config terminal; lib.sh's
#                       load_terminal), with its exit code: 2 means nothing opened and CMD is printed to copy
# Superseded: a first prompt's `Supersedes: ID` line (--handover writes it) or `You replace session ID` marks session
# ID replaced. It never owns
# a task, nor shows as a leftover: under Other sessions it reads `· superseded by NEWID`.
# Transcripts that ran session-status (or a status-names command) with --start, --changes, --watch or --owner, or that
# opened the pane (open_pane), are a coordinator's and never own a task; a plain run (a worker checking its own
# task) doesn't count. A sub-coordinator (first prompt `Coordinate KEY`, named KEY-coordinator: lib.sh sub_key) is the
# exception: it owns KEY before any other session, and --coordinator lists it only to KEY's own sessions, first.
# While it is live, its row carries `sub: STATE[; plan D/N landed, cX running]` before the title (STATE: its report's,
# <replies>/KEY-coordinator.md; the plan: <replies>/KEY.md's table), and the live sessions whose first prompt names KEY
# (its chunks and reviews; coordinators aside) fold into that row: the sweep's footer leaves them out but for a prompt,
# unless the caller is the sub. Its owner gone, the row reads `sub gone, KEY unfinished: …` and nothing folds.
# --watch with no key args skips a live sub's sessions in Idle and reports the sub's; with key args, only those keys'.
# The default key pattern also matches UTF-8 or SHA-256; a project with real keys should answer key-pattern.
set -uo pipefail
[ "${1:-}" = --init ] && { shift; exec bash "$(dirname "$0")/../setting-up-coordination/session-init" "$@"; }
# --help [--FLAG]: status-reference.md's Commands rows (those of --FLAG), never a sweep.
if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
  grep -F '| `session-status' "$(dirname "$0")/status-reference.md" | grep -E "session-status${2:+ $2([ \`]|\$)}" ||
    { echo "session-status --help: no command ${2:-}" >&2; exit 2; }
  exit 0
fi
. "$(dirname "$0")/../../lib.sh" || exit 1
# telemetry=full: a non-zero exit as an error line (lib.sh usage), named by its --flag (none: the board). Each later
# EXIT trap ends with it too.
SS_LIB=$(cd "$(dirname "$0")/../.." && pwd)/lib.sh SS_FLAG=${1:-}; [[ $SS_FLAG =~ ^--[a-z-]{1,40}$ ]] || SS_FLAG=
# Not faults: exit 3 and 4 (not done yet, busy, skipped, too big); a signal (128+: a closed reader, a stopped watcher);
# the flags whose 1 or 2 is an answer (the adapter's "no answer", a --plan --check list, "isn't running", "nothing to
# hand over"); --watch, whose gave-up line says it; a --watch poll (PEEK or FORWARD set), left to the poll-failed line.
# It logs from a fresh bash: after a closed reader (`| head -1`), bash 3.2 leaks the unsent output into a $(…) the trap
# forks, and usage's config call then hangs.
exit_fault() {
  case $1 in 0|3|4|12[89]|1[3-9][0-9]|2[0-9][0-9]) return ;; esac
  case $SS_FLAG in --urls|--pending|--agents|--plan|--coordinator-of|--address|--successor|--handover|--resume-ended|--relay|--watch) return ;; esac
  [ "$SS_FLAG:$1" != --report-publish:1 ] || return   # its "publish: no" is an answer; a usage error (2) is logged
  [ -n "${SESSION_STATUS_PEEK:-}${SESSION_STATUS_FORWARD:-}" ] ||
    bash -c '. "$1" && usage session-status error "$2" "$3"' _ "$SS_LIB" "$1" "${SS_FLAG:-skills/orchestrating-sessions/session-status}" </dev/null >/dev/null 2>&1
}
trap 'exit_fault $?' EXIT
[ "${1:-}" = --config ] && { config "${2:-}"; exit; }
# --remote add NAME --purpose 'LINE' | --remote remove NAME: the person's remote.tsv row (lib.sh remote_registry) for
# one of their coordinators on another computer, same claude.ai account (features/remote.md): added once ListAgents lists
# it as a Remote Control session and it said what it is for. --coordinators lists it under Remote.
if [ "${1:-}" = --remote ]; then
  u="usage: session-status --remote add NAME --purpose 'ONE LINE' | --remote remove NAME"
  case "${2:-} $#" in "add 5") [ "$4" = --purpose ] || { echo "$u" >&2; exit 2; } ;; "remove 3") ;; *) echo "$u" >&2; exit 2 ;; esac
  [[ $3 =~ ^[A-Za-z0-9._-]{1,100}$ ]] || { echo "--remote: NAME is a session name (letters, digits, . _ -)" >&2; exit 2; }
  f=$(remote_registry)
  [ "$(N=$3 awk -F'\t' '$1 == ENVIRON["N"] { print $2; exit }' "$f" 2>/dev/null)" != link ] ||
    { echo "--remote: $3 is a link (session-status --link list): --link remove $3 ends it" >&2; exit 2; }
  if [ "$2" = remove ]; then
    awk -F'\t' -v n="$3" '$1 == n { f = 1 } END { exit !f }' "$f" 2>/dev/null || { echo "--remote remove: no remote coordinator $3 in $(tilde "$f")" >&2; exit 2; }
    tsv_put "$f" "$3" && echo "removed $3"; exit
  fi
  p=$(one_line "$5"); [ -n "$p" ] || { echo "$u" >&2; exit 2; }
  # The same project on both computers gives both coordinators one name, and SendMessage by it stays on this one.
  [ ! -f "$(coord_registry)" ] || while IFS=$'\t' read -r r _; do
    [ -n "$r" ] && [ "$(coord_name "$r" 2>/dev/null)" = "$3" ] || continue
    echo "--remote add: $3 is also this computer's coordinator of $(tilde "$r"), so a SendMessage by that name stays here: rename the other computer's one there (/rename) and add that name" >&2; exit 2
  done < "$(coord_registry)"
  tsv_put "$f" "$3" "$(printf '%s\trc\t%s\t%s' "$3" "$p" "$(date +%s)")" && echo "added $3 · $p"; exit
fi
[ "${1:-}" = --pane-section ] && { [ $# = 3 ] || set -- "$1" "" ""; pane_section_set "$2" "$3"; exit; }
# --land TARGET: fast-forward branch TARGET to HEAD where TARGET is checked out in another worktree (a project that
# lands by fast-forwarding its main checkout's branch), from a worktree-isolated session: git refuses a plain
# `push . HEAD:TARGET` there, and git -C into that checkout is the isolation guard's to refuse. updateInstead moves the
# branch and that checkout's files together, and refuses a dirty checkout or a non-fast-forward (no --force).
# --land OWNER/REPO#N: land GitHub PR N in one run: merge it (--auto --rebase; a clean PR, which gh refuses --auto,
# plain --rebase; "Base branch was modified" retried), wait until it merged, then watch every CI run on its merge
# commit (one rerun of a job cancelled for want of a runner). One line at the end: merged and green, or what failed.
# It gives up after SESSION_STATUS_LAND_MAX seconds (3 h), naming the read-only calls to go on with.
# Checked before the branch form: # is legal in a branch name. The approval hook classifies with this same regex.
# shortcut: gh only; a Forgejo or Bitbucket PR lands by hand until a project needs it here.
if [ "${1:-}" = --land ] && [ $# = 2 ] && [[ $2 =~ ^([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)#([0-9]+)$ ]]; then
  repo=${BASH_REMATCH[1]} n=${BASH_REMATCH[2]} poll=${SESSION_STATUS_LAND_POLL:-60}
  deadline=$((SECONDS + ${SESSION_STATUS_LAND_MAX:-10800}))
  trap - EXIT   # every outcome here (refused, a conflict, red, gave up) is an answer on the last line, not a fault
  say() { local t; t=$(one_line "${1:0:200}"); echo "${t:-$1}"; }
  on() { echo "continue read-only: gh pr view $n -R $repo --json state,mergeCommit, gh run list -R $repo -c SHA, gh run watch ID -R $repo --exit-status --interval 60"; }
  plain=
  for try in 1 2 3 4; do
    out=$(gh pr merge "$n" -R "$repo" --auto --rebase 2>&1) && break
    [[ $out != *'clean status'* ]] || { out=$(gh pr merge "$n" -R "$repo" --rebase 2>&1) && plain=1 && break; }
    [[ $out == *'Base branch was modified'* ]] && [ "$try" -lt 4 ] || { say "merge refused: $out"; exit 1; }
    sleep $((poll / 12))
  done
  # Red: a check run that ended other than success, skipped or neutral, or a commit status that failed or errored.
  bad='"FAILURE","CANCELLED","TIMED_OUT","STARTUP_FAILURE","ACTION_REQUIRED","ERROR"'
  while :; do
    for try in 1 2 3; do
      st=$(gh pr view "$n" -R "$repo" --json state,mergeStateStatus,mergeCommit,autoMergeRequest,statusCheckRollup \
        --jq "[.state, .mergeStateStatus, (.mergeCommit.oid // \"-\"), (.autoMergeRequest != null), ([.statusCheckRollup[]? | .conclusion // .state] | any(IN($bad)))] | map(tostring) | join(\" \")" 2>/dev/null) && break
      [ "$try" = 3 ] && { echo "gh pr view $repo#$n failed 3 times; the merge may be queued: $(on)"; exit 1; }
      sleep $((poll / 12))
    done
    read -r s m sha auto red <<<"$st"
    [ "$s" != MERGED ] || break
    [ "$s" = OPEN ] || { say "$repo#$n is $s, not merged"; exit 1; }
    [ "$m" != DIRTY ] || { echo "conflict: rebase on origin/main and push --force-with-lease; auto-merge stays on (gh pr view $n -R $repo --json state shows when it merged)"; exit 1; }
    [ "$red" != true ] || { echo "a check failed on $repo#$n: gh pr checks $n -R $repo; fix and push, auto-merge stays on"; exit 1; }
    [ "$auto" = true ] || [ -n "$plain" ] || { echo "$repo#$n is open with no auto-merge queued: the relay still covers it while no new commits are pushed: run --land again once it can merge"; exit 1; }
    [ "$SECONDS" -lt "$deadline" ] || { echo "$repo#$n not merged yet, auto-merge stays on: $(on)"; exit 1; }
    sleep "$poll"
  done
  # Every run on the merge commit (test, release, …), listed a few seconds after the merge. None: no CI to watch.
  for try in 1 2 3 4 5 6; do
    ids=$(gh run list -R "$repo" -c "$sha" --json databaseId --jq '.[].databaseId' 2>/dev/null) && listed=1 || ids= listed=
    [ -z "$ids" ] || break; [ "$try" = 6 ] || sleep $((poll / 6))
  done
  [ -n "$ids" ] || [ -z "$listed" ] || { echo "merged: $sha (no CI run on it)"; exit 0; }
  [ -n "$ids" ] || { echo "merged: $sha, but gh run list failed: $(on)"; exit 1; }
  for id in $ids; do
    rerun=1
    while :; do
      [ "$SECONDS" -lt "$deadline" ] || { echo "merged: $sha, its run $id still running: $(on)"; exit 1; }
      # gh run watch also fails on its own (HTTP 403, the network): only a completed run's conclusion decides.
      gh run watch "$id" -R "$repo" --exit-status --interval "$poll" >/dev/null 2>&1 && break
      v=$(gh run view "$id" -R "$repo" --json status,conclusion --jq '.status + " " + .conclusion' 2>/dev/null)
      case $v in "completed "success|"completed "skipped|"completed "neutral) break ;; completed*) ;; *) sleep "$poll"; continue ;; esac
      # One rerun of a job cancelled for want of a runner, then wait until the rerun shows before watching again.
      [ -n "$rerun" ] && log=$(gh run view "$id" -R "$repo" 2>&1) && [[ $log == *'acquired by Runner'* ]] &&
        gh run rerun "$id" -R "$repo" --failed >/dev/null 2>&1 || { echo "merged: $sha, but its run $id is red: gh run view $id -R $repo"; exit 1; }
      rerun=
      for try in 1 2 3 4 5 6; do
        [ "$(gh run view "$id" -R "$repo" --json status --jq .status 2>/dev/null)" = completed ] || break
        sleep $((poll / 6))
      done
    done
  done
  echo "merged and green: $sha"; exit 0
fi
