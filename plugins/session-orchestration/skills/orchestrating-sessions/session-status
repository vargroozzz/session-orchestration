}
# inbox_lock FILE: an add and a --read's rewrite never interleave (an add between the read and the mv was lost; two adds
# took one number). A flock(2) on FILE.flock, held on fd 9 until this process exits, so a killed run frees it at once:
# the old mkdir lock's stale-owner takeover let two waiters in together. perl takes it (no flock CLI on macOS); the lock
# is on the open file, which this shell keeps after perl exits. The file stays: unlinking it would let a waiter lock a
# file nobody else sees. After a minute it goes on unlocked, so a hung holder never drops a message.
inbox_lock() {
  exec 9>>"$1.flock" && perl -MFcntl=:flock -e 'alarm 60; open(my $l, ">>&=", 9) or exit 1; flock($l, LOCK_EX) or exit 1' ||
    echo "session-status: couldn't lock $1; going on unlocked" >&2
}
# What this project's coordinator queued in other projects' inboxes (--inbox-add --root): a line FILE, N, DIR, WHEN each
# in a personal cache file. sent_marks prints MARK, DIR, N, WHEN and the text's first line per entry, tab-separated, MARK
# unread, read, or gone (its file or entry no longer there; an entry N of another WHEN is a recreated inbox's).
# shortcut: the log only grows (a line per message sent); prune its read entries if it ever gets long.
SENT_LOG=~/.cache/session-status/$ENC.sent
sent_marks() {
  [ -f "$SENT_LOG" ] || return 0
  local f n d w; while IFS=$'\t' read -r f n d w; do
    awk -v n="$n" -v d="$d" -v w="$w" 'BEGIN { OFS = "\t"; m = "gone" } h { t = $0; exit } /^## [0-9]+ · / && $2 == n { split($0, p, " · "); if (p[3] == w) { m = p[2]; h = 1 } }
      END { print m, d, n, w, t }' "$f" 2>/dev/null || printf 'gone\t%s\t%s\t%s\t\n' "$d" "$n" "$w"
