    rd=$(replies_path "$d"); [ -n "$rd" ] || { echo "$(tilde "$d")/CLAUDE.md names no replies folder: no inbox there" >&2; exit 2; }
    f=$rd/coordinator-inbox.md g=$rd; while [ ! -d "$g" ]; do g=${g%/*}; g=${g:-/}; done
