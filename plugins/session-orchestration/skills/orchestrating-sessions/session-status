  dk=; [[ ${CLAUDE_CODE_ENTRYPOINT:-} != claude-desktop* ]] || dk=" detach each session you started other than your successor, so archiving you leaves it (mcp__ccd_session_mgmt__list_sessions {\"linked\": true} lists them, then mcp__ccd_session_mgmt__detach_session; one that refuses: name it in an inbox entry for the user),"
  while :; do
