    { echo "couldn't write $f" >&2; exit 1; }
  # --root: logged, so --inbox --sent and the status footer show it until the other coordinator reads it
  [ -z "$to" ] || { mkdir -p "${SENT_LOG%/*}"; printf '%s\t%s\t%s\t%s\n' "$f" "$k" "$d" "$w" >> "$SENT_LOG"; }
