#!/usr/bin/env bash
# One line per task: status, local worktree state, owning session. Then: sessions waiting on the user, and
# leftovers (sessions/worktrees of finished tasks). No LLM involved.
#
# The project root is the nearest directory up from $PWD holding an executable .claude/session-status-adapter,
# else the git toplevel, else $PWD. The adapter (that one, else a committed .claude/coordination/session-status-adapter
# once trusted: lib.sh adapter_path) answers (one call per run, cwd = project root):
#   tasks [ARG…]   KEY<TAB>STATUS<TAB>TITLE<TAB>EXTRA per task, in display order. EXTRA is printed verbatim
#                  between STATUS and the worktree column (end it with its own separator, e.g. "| ").
#                  On failure: exit non-zero with the message on stdout; the board prints without tracker columns
#                  under `adapter tasks failed (exit N): MESSAGE` (none: stderr's last line); --changes exits 1 with
#                  the message instead. Exit 2 with nothing on stderr = not answered: the
#                  no-adapter rows below (an adapter with only `pending`, `urls` or `key-pattern` needs no `tasks`).
#                  After a sweep exits 2, the pointed-at keys that `done` doesn't report are looked up
#                  (`tasks KEY…`); its rows replace the bare ones, and the finished keys go to Leftovers.
#                  The coordinator pane groups and acts on these words in EXTRA, whitespace-separated:
#                    REPO#ID OPEN|MERGED   a PR (OPEN: In review; +NAME too: Landing)
#                    +NAME / !NAME         approved by / changes asked by NAME (!: Address comments); the
#                                          phrases `approved by NAME` / `changes requested by NAME` mean the same
#                    no-human-approval     open, waiting for a reviewer
#                    CONFLICT              merge conflict (Resolve conflicts)
#                    CI-FAILED             the PR's latest build failed (Fix CI)
#                    ↩MM-DD NAME→STATUS    the tracker sent it back
#                    (PRs as of HH:MM)     the PR words are from that time
#                  Anything else shows only in the item's details.
#                  A line `fix: LABEL → COMMAND` instead of a task (on success or failure) is printed as is after the
#                  rows; the coordinator pane offers it as an action while it's there. Never print outside text
#                  (a tracker's error, a message) at the start of a line: indent it, so it can't pose as one.
#   done KEY…      KEY[<TAB>LABEL] for each key that's finished; feeds "Leftovers" and "Resolved".
#   key-pattern    one ERE matching a task key (default: the config's key_pattern, else [A-Z][A-Z0-9]+-[0-9]+).
#   status-names   regex of the project's own status-command names (its wrapper); see below.
#   repos          git repos to look for worktrees in, one per line, relative to the root (default: the root
#                  if it's a repo, else its child repos).
#   pending        the coordinator's handoff text, printed as is by --pending (the coordinator pane shows it).
#   urls           link templates for the coordinator pane, one per line: `ticket URL` with {key}, `pr URL`
#                  with {repo} and {id} (a PR shows in EXTRA as repo#id). Printed as is by --urls.
#   session-dirs   more directories whose sessions belong to the project (absolute or ~/…, one per line), e.g. a
#                  tooling repo its coordinator starts sessions in. Their sessions never own a task: they show
#                  under "Other sessions". Default: the root only.
#   notices        short lines about things outside the tracker (new chat messages, mentions), one per item, on
#                  the sweep only; printed under "Notices". A line should stay the same while its item does.
#                  --changes reports a new or changed notice but not one that went away (read, answered).
#                  Exit 1 = failed, reason on stdout: the last good notices are shown, plus the reason. Other
#                  non-zero = not supported. Capped at 60s, which counts as a failure.
#                  A messages module (`messages` in the config: lib.sh, messages/msgraph.md) runs beside it, the
#                  same way; its lines come first. --messages-file prints where it keeps the message behind each line.
#   pr-keys REPO#ID  the task keys a PR names (branch, title), one per line; exit non-zero when it can't tell. For
#                  a messages module tagging PR links.
#   mine           the task keys you own, one per line; a messages module marks notices for them. Default: the
#                  keys of the last sweep's rows.
# "Waiting on you" leaves out a task's worker at rest whose row only waits on a reviewer (no-human-approval, nothing
# to fix): its row shows it idle. It adds `— blocked: TOOL `INPUT`` while hooks/blocked.sh's record of the prompt is newer than the
# session's transcript; that line appearing is a change. Any other blocked session is listed only while verdict
# (below) says it waits on the user; a prompt unanswered SESSION_STATUS_STALE_HOURS (6) goes under "Stale prompts"
# with its stop command instead (not compared by --changes).
# --changes also skips a row whose only change is its session flipping between working, idle and blocked, or entering
# `working`, or its worktree's counts
# changing while it works, and "Waiting on you" churn: an entry appearing, or going away while its session
# lives on (states of the sweep's sessions are kept in ~/.cache/session-status/<project>.agents).
# "Resolved (idle a week)": leftovers idle 7 days (SESSION_STATUS_RESOLVE_DAYS) whose removal loses nothing (a
# session idle or done; a clean worktree whose commits are merged or on origin): by transcript, last commit and folder times.
# --changes doesn't compare that section: an item moving there, or going away from it, isn't news.
# "Other sessions": live sessions that own no row (no task, a reviewer, a session dir) and aren't blocked (Waiting
# on you has those), coordinators (ran --start, --changes, --watch or --owner, or opened the pane) left out: `"NAME" STATE AGE[ · reviews KEY][ — LAST TEXT] (PREFIX attach ID)`.
# AGE is since start while working, else since its transcript was last written; idle or done ones drop off at
# SESSION_STATUS_OTHER_HOURS (3), unless at rest (blocked: still running) or superseded. --changes doesn't compare it either.
# "Stale": `* ask ID KEY: REASONS`, `* pending "LABEL": REASONS`, `* session "NAME" (ID8)[ KEY]: decision not on the
# pane` (stale.jq). --changes reports an item once per wording (a new reason is a new wording), not one going away.
# Owners: a review session (`Session task: KEY review`, "review" ending the marker) never owns KEY. Task markers
# count only from a session's own text and the messages it received (its prompts, a SendMessage brief), not its
# tool inputs (a brief it sends names another session's task). A first prompt names a key only at its start, and
# beats any marker. The `maybe` guess skips a session whose first prompt names another key. A session in a
# session-dir never owns a task.
# A call the adapter doesn't answer exits non-zero and the default applies. With no adapter (or `tasks` exiting 2),
# rows are the keys named by running sessions and worktree branches; no "Leftovers".
#
# Usage: session-status              all open tasks
#        session-status KEY [KEY…]   these tasks; no footer (it covers all sessions)
#        session-status ARG…         other args go to the adapter's `tasks`
#        session-status --start [args]   a coordinator's Start in one run: the status, the handoff file, the last
#                       handover note, the replies written since it (else in the last day) with their first lines,
#                       and the coordination config with each enabled feature's start step; when there are any, the
#                       sessions that ended while the background service was off (or failed) with a task still open
#        session-status --resume-ended [--pause SECS] ID…   resume those one at a time, SECS (60) apart, each checked
#                       against the live list first
#        session-status --changes [args]   only lines changed since the previous --changes run
#        session-status --stale [args]   the sweep's "Stale" section alone: queued asks and handoff entries whose facts
#                       moved on, sessions asking the user with no ask queued (stale.jq has the signals); flags only
#        session-status --watch [--every SECS] [args]   block until --changes reports something at two polls in a
#                       row (or fails 3 in a row), print it and exit; checks every SECS (default 1800). Run it in
#                       the background, re-arm; no loop around it.
#        session-status --pending       the adapter's `pending` text only
#        session-status --pending-done LABEL [--] REASON   archive a handoff entry (config pending.file; `pending`)
#        session-status --pending-history LABEL [--last N] | --find KEY | --scan | --seed   an entry's history
#        session-status --urls          the adapter's `urls` text only
#        session-status --root          the project root: where the adapter and .claude/coordinator-actions.json are
#        session-status --agents        the sessions the last sweep saw: id, name, state, command prefix, started
#                       (epoch s), cwd, kind, status, pid (tabs)
#        session-status --activity      what each live session is doing, fresh, no tracker calls: id, name, state,
#                       transcript written (epoch s), doing, since (epoch s, 0 unknown), last text line, context
#                       tokens, context window, status (idle/busy/waiting), kind, cwd, command prefix (tabs); see
#                       session-activity.jq. --activity --all-projects: every project's sessions, not only this one's
#        session-status --peek ID [N]   a session's last N (12) prompts, texts and tool calls as Markdown, then
#                       what it's doing now (session-peek.jq); any project, any account
#        session-status --search TEXT [days]   one line per hit of TEXT (default the last 7 days) in sessions' prompts,
#                       messages and own text, any project and account: NAME (ID8) · date · who: snippet, masked
#                       and capped (rnd.py search); --peek ID for more
#        session-status --dir KEY|ID…   the folder a task or session works in (the first argument that resolves):
#                       KEY's worktree; for an ID, the git top of its latest cwd (its transcript), else that cwd
#        session-status --diff KEY|ID…  that folder's changes since its merge-base with origin/HEAD, committed or
#                       not: `DIR · vs BASE`, the --stat lines and untracked `?? FILE`s, a blank line, the patch
#        session-status --compact ID   an idle background session runs /compact (stopped, resumed with it)
#        session-status --send-when-idle [--here] ID TEXT   wait until it isn't busy, then deliver TEXT without forking
#                       it; --here: a session under another account is moved to yours (same id and name), so you can
#                       SendMessage it next
#        session-status --coordinator   names of this account's live coordinator sessions (ran --start,
#                       --changes, --watch or --owner, or opened the pane), newest first, excluding the caller; no
#                       tracker calls
#        session-status --coordinator-of DIR [--start]   the coordinator of DIR's project when it's another than
#                       this one (a subproject, the parent): its name; exit 1 not running (--start opens it), 3 listing
#                       failed, 4 none of its own (--start opens a new one there), 5 nothing opened
#        session-status --owner KEY…   who owns each task and why: the row's session, then each candidate
#                       (first prompt, marker, review, maybe) with its state, first prompt line and markers
#        session-status --handover ID|--self [--model M] [--effort E] [--] 'WHAT NEXT'   a task or chunk session too
#                       big to resume is stopped and a fresh one takes its task over, under its name, from the replies
#                       folder's KEY.md (a chunk: KEY-build.md's handoff); --self, a session hands itself over when no
#                       coordinator runs (see the block)
#        session-status --prev-name [NAME]   NAME-prev-K, the name a session renames itself to when it hands off: K the
#                       lowest free number over every listed session name (NAME: the caller's own); --title also
#                       titles the caller's terminal tab with it
#        session-status --successor [--account DIR] | --successor --done | --await ready|renamed|name|done [--timeout S] |
#                       --name-check NAME   a coordinator hands itself over to NAME-next it starts (see the block;
#                       handover.md)
#        session-status --inbox [--read N…|all] | --inbox-add [--from WHO] [SENDER_ID] < TEXT   the coordinator
#                       inbox: messages no live coordinator took (the reply tool's backstop), unread ones printed
#        session-status --init [--check | --write …]   set this folder up for coordination: the setting-up-coordination
#                       skill's session-init documents the modes; runs in the cwd, not the root
#        session-status --config KEY   a config value (lib.sh at the plugin root lists the keys), e.g. approvals.delegate
#        session-status --kind KIND   `--model M --effort E` from plan.models.KIND for a task start, logged as a usage
#                       start line
#        session-status --plan FILE [--check | --next | --brief N | --done N]   a design's plan table: waves and chunk
#                       states, its problems (exit 1), the `claude --bg` lines of the runnable chunks, row N's brief
#                       skeleton, or (run by chunk N once it landed) its usage chunk line
#        session-status --open view [--account DIR] TITLE DIR -- CMD…   (or `--open split [--account DIR] DIR -- CMD…`)
#                       opens CMD in a tab or split of the configured terminal (config terminal; lib.sh's
#                       load_terminal), with its exit code: 2 means nothing opened and CMD is printed to copy
# Superseded: a first prompt's `Supersedes: ID` line (--handover writes it) or `You replace session ID` marks session
# ID replaced. It never owns
# a task, nor shows as a leftover: under Other sessions it reads `· superseded by NEWID`.
# Transcripts that ran session-status (or a status-names command) with --start, --changes, --watch or --owner, or that
# opened the pane (open_pane), are a coordinator's and never own a task; a plain run (a worker checking its own
# task) doesn't count.
# The default key pattern also matches UTF-8 or SHA-256; a project with real keys should answer key-pattern.
set -uo pipefail
[ "${1:-}" = --init ] && { shift; exec bash "$(dirname "$0")/../setting-up-coordination/session-init" "$@"; }
. "$(dirname "$0")/../../lib.sh" || exit 1
[ "${1:-}" = --config ] && { config "${2:-}"; exit; }
# --kind KIND: `--model M --effort E` from plan.models.KIND for a plain task start's `claude --bg` line, logged as a
# usage start line (lib.sh usage), data for rnd to set plain starts beside chunks (no reader yet).
if [ "${1:-}" = --kind ]; then
  [ $# = 2 ] && me=$(config "plan.models.$2" 2>/dev/null) ||
    { echo "usage: session-status --kind design|build|mechanical|review|release|scan" >&2; exit 2; }
  usage "$2" start "${me%%/*}" "${me#*/}"
  echo "--model ${me%%/*} --effort ${me#*/}"; exit
fi
# prev_name NAME: NAME-prev-K, the name a session takes when it hands off (its successor keeps NAME). NAME loses any
# -prev-K first; K is the lowest number no session of a listed account (lib.sh list_sessions --all: live or
# retired) carries, so no two sessions share a name. Listing failed: K = 1. The caller ($CLAUDE_CODE_SESSION_ID)
# already named NAME-prev-K keeps that name (so no other name of the caller's can be NAME-prev-K). NAME "": the
# caller's own; fails when the caller isn't listed. One listing.
prev_name() {
  local b k=1 all me names
  all=$(list_sessions --all)
  me=$(awk -F'\t' -v s="${CLAUDE_CODE_SESSION_ID:-}" 's != "" && $1 == s {print $2; exit}' <<<"$all")
  b=${1:-$me}; [ -n "$b" ] || return 1; [[ $b =~ ^(.+)-prev-[0-9]+$ ]] && b=${BASH_REMATCH[1]}
  [[ $me == "$b-prev-"* && ${me#"$b-prev-"} =~ ^[0-9]+$ ]] && { echo "$me"; return; }
  names=$(cut -f2 <<<"$all")
  while grep -qxF -- "$b-prev-$k" <<<"$names"; do k=$(( k + 1 )); done
  echo "$b-prev-$k"
}
# --prev-name [NAME]: prev_name's name for NAME, by default the caller's own (by $CLAUDE_CODE_SESSION_ID).
# --prev-name --title: the caller's, and its terminal's tab (title_tty, by its process's tty) titled with it, so the
# successor finds and the user tells the old coordinator's tab; a terminal that can't is noted on stderr.
if [ "${1:-}" = --prev-name ]; then
  t=; [ "${2:-}" = --title ] && { t=1; shift; }
  p=$(prev_name "${2:-}") || { echo "usage: session-status --prev-name [--title] [NAME] (this session isn't listed: name it)" >&2; exit 2; }
  echo "$p"
  if [ -n "$t" ]; then
    pid=$(list_sessions | awk -F'\t' -v s="${CLAUDE_CODE_SESSION_ID:-}" 's != "" && $1 == s { print $9; exit }')
    tty=; [ -z "$pid" ] || tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    if [ -z "$tty" ] || [[ $tty = \?* ]]; then echo "note: no terminal for this session's process: tab not titled" >&2
    else load_terminal; title_tty "$tty" "$p" >/dev/null 2>&1 || echo "note: the $(config terminal) terminal didn't title the tab of $tty" >&2
    fi
  fi
  exit 0
fi
# --search TEXT [days]: rnd.py search, every project and account, the caller left out.
if [ "${1:-}" = --search ]; then
  [ -n "${2:-}" ] && [[ ${3:-7} =~ ^[0-9]+$ ]] || { echo "usage: session-status --search TEXT [days]" >&2; exit 2; }
  exec python3 -I "$(dirname "$0")/../rnd/rnd.py" search "$2" "${3:-7}"
fi
# --plan FILE [--check | --next | --brief N | --done N]: FILE's plan table (the first table under `## Plan` or `## Build plan`:
# # | Chunk | Kind | Deps | Touches | Est | Model/effort | Done when), with each chunk's state from the
# `## cN: done|handoff` sections of KEY-build.md beside it (KEY: FILE's name without .md; any done is done) and the
# live sessions (one named KEY-cN: running). Alone: the waves and each row's state. --check: one line per problem,
# exit 1. --next: the waves, then a `claude --bg` line per runnable chunk, running ones holding slots and touches.
# --brief N: a brief skeleton for row N, to finish by hand. --done N: row N's kind, model/effort (default: plan.models)
# and est, with this session's act_K from `rnd.py chunks 7 --session` (summed over the sessions its Supersedes: chain
# reaches; left out if rnd fails), go to lib.sh usage as a
# chunk line; it prints the line or why nothing was logged.
# bg_cmd PREFIX: `PREFIX --bg`, plus ` --permission-mode default` when that account's settings default to plan mode
# (--handover and --plan --next start sessions with it).
# pre_dir PREFIX: the config dir a command prefix runs under, no trailing slash.
pre_dir() {
  local cfg
  case $1 in claude) cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude} ;; 'env -u CLAUDE_CONFIG_DIR claude') cfg=$HOME/.claude ;; *) cfg=${1#CLAUDE_CONFIG_DIR=}; cfg=${cfg% claude}; cfg=${cfg/#\~/$HOME} ;; esac
  printf '%s' "${cfg%/}"
}
bg_cmd() {
  printf '%s --bg' "$1"; [ "$(jq -r '.permissions.defaultMode // empty' "$(pre_dir "$1")/settings.json" 2>/dev/null)" != plan ] || printf ' --permission-mode default'
}
if [ "${1:-}" = --plan ]; then
  models=; for k in design build mechanical review release scan; do models+="$k=$(config "plan.models.$k") "; done
  read -r PLAN_W PLAN_WFROM < <(compact_window "$(find_root)")
  live= lfail=   # live names (a KEY-cN one is running), listed only where they're read
  if [ -f "${2:-}" ] && { [ -z "${3:-}" ] || { [ "$3" = --next ] && [ "$(config plan.enabled)" != false ]; }; }; then
    TMP=$(mktemp -d); live=$(list_sessions | cut -f2); [ ! -e "$TMP/ask.failed" ] || lfail=1; rm -rf "$TMP"; unset TMP
  fi
  shift; PLAN_LIVE=$live PLAN_LFAIL=$lfail PLAN_MAXP=$(config plan.max_parallel) PLAN_AT=$(config handoff.at.chunk) PLAN_MODELS=$models PLAN_LIB=$(dirname "$0")/../../lib.sh PLAN_ON=$(config plan.enabled) \
    PLAN_TELEMETRY=$(config telemetry) PLAN_LOG=$(usage_log) PLAN_W=$PLAN_W PLAN_WFROM=$PLAN_WFROM PLAN_WANT=$(config compact.window) \
    PLAN_BG=$(bg_cmd claude) exec python3 -I - "$@" <<'PY'
import os, re, shlex, subprocess, sys
die = lambda msg: sys.exit(print(msg, file=sys.stderr) or 2)
usage = "usage: session-status --plan FILE [--check | --next | --brief N | --done N]"
a = sys.argv[1:]
if not a or a[1:2] not in ([], ["--check"], ["--next"], ["--brief"], ["--done"]) or \
        (len(a) == 3) != (a[1:2] in (["--brief"], ["--done"])) or len(a) > 3:
    die(usage)
if not os.path.isfile(a[0]): die(f"no file {a[0]}")
path = os.path.abspath(a[0]); mode = a[1] if len(a) > 1 else ""
d, key = os.path.dirname(path), os.path.basename(path).removesuffix(".md")
MODEL_EFFORT = r"[a-z][a-z0-9.-]*/(low|medium|high|xhigh|max)"
KINDS = dict(m.split("=", 1) for m in os.environ["PLAN_MODELS"].split())
MAXP, AT = max(1, int(os.environ["PLAN_MAXP"])), int(os.environ["PLAN_AT"])
okme = lambda me: bool(re.fullmatch(MODEL_EFFORT, me)) and "fable" not in me   # lib.sh model_ok: one rule
START = 60000   # ponytail: a constant session start; a later chunk calibrates it from rnd.py's measured base

lines, i = open(path).read().splitlines(), 0
while i < len(lines) and not re.match(r"## (Build )?[Pp]lan(\s|$)", lines[i]): i += 1
i += 1
while i < len(lines) and not lines[i].startswith(("|", "# ", "## ")): i += 1   # the table is in the plan's section
rows, bad = [], []
for ln in lines[i:]:
    if not ln.startswith("|"): break
    c = [x.strip().replace("\\|", "|") for x in re.split(r"(?<!\\)\|", ln.strip())[1:-1]]
    if not any(c): continue   # a lone `|` or empty cells
    if c[:1] == ["#"] or c and c[0] and set(c[0]) <= set("-: "): continue   # the header and the --- line
    (rows if len(c) == 8 else bad).append(c)
if not rows: die(f"no plan table in {path}")
R, dup = {}, []
nil = lambda s: s.lower() in ("", "-", "–", "—", "none")   # a Deps or Touches cell that names nothing
for n, title, kind, deps, touch, est, model, done in rows:
    ds = []
    if n in R: dup.append(n)
    for p in ([] if nil(deps) else re.split(r"\s*,\s*", deps)):
        m = re.fullmatch(r"c?(\d+)\s*[–-]\s*c?(\d+)", p)   # a range, 1–4
        p = p.removeprefix("c")
        ds += [str(x) for x in range(int(m[1]), int(m[2]) + 1)] if m else [p]
    ts = [] if nil(touch) or touch[:1] in "-–—" else re.findall(r"`([^`]+)`", touch) or re.split(r"\s*,\s*", touch)
    m = re.fullmatch(r"(\d+)\s*[Kk]", est)
    R[n] = dict(title=title, kind=kind, deps=ds, touch=ts, est=int(m[1]) * 1000 if m else None, raw_est=est, model=model, done=done)
state = {}
try:
    for m in re.finditer(r"^## c(\S+): (done|handoff)\b", open(os.path.join(d, f"{key}-build.md")).read(), re.M):
        state[m[1]] = "done" if "done" in (m[2], state.get(m[1])) else m[2]   # any done is done (--handover's rule)
except FileNotFoundError: pass
isdone = lambda n: state.get(n) == "done"
LIVE = set(os.environ["PLAN_LIVE"].splitlines())
if os.environ["PLAN_LFAIL"]: print("couldn't list an account's sessions: a running chunk may show as not running", file=sys.stderr)
running = lambda n: not isdone(n) and f"{key}-c{n}" in LIVE   # a live KEY-cN session; KEY-cN-prev-K isn't one

# Waves: 1 + the latest wave of a chunk's deps. A chunk on a cycle or with an unknown dep gets none.
wave, cycles = {}, []
def wv(n, path=()):
    if n in path: cycles.append(path[path.index(n):] + (n,)); return None
    if n not in R: return None
    if n not in wave:
        ws = [wv(x, path + (n,)) for x in R[n]["deps"]]
        wave[n] = None if None in ws else 1 + max(ws, default=0)
    return wave[n]
for n in R: wv(n)
W = sorted({w for w in wave.values() if w})
waves = " → ".join("{" + ",".join(n for n in R if wave[n] == w) + "}" for w in W)

def anc(n, seen=None):   # every chunk n waits for
    seen = set() if seen is None else seen
    for x in R.get(n, {}).get("deps", []):
        if x not in seen: seen.add(x); anc(x, seen)
    return seen
def base(t):   # the part before the first glob character, and whether there was one
    m = re.search(r"[*?\[]", t); return (t[:m.start()], True) if m else (t, False)
def overlap(x, y):
    (px, gx), (py, gy) = base(x), base(y)
    if gx or gy: return px.startswith(py) or py.startswith(px)
    return x == y or x.startswith(y.rstrip("/") + "/") or y.startswith(x.rstrip("/") + "/")

if mode == "--check":
    if os.environ["PLAN_W"] != os.environ["PLAN_WANT"]:   # info, not a problem (stderr: stdout is one line per problem)
        print(f"window {os.environ['PLAN_W']} from {os.environ['PLAN_WFROM']}; expected {os.environ['PLAN_WANT']}", file=sys.stderr)
    out, seen =[f"row {c[0]}: {len(c)} cells, not 8" for c in bad] + [f"c{n}: two rows" for n in dup], set()
    for n, r in R.items():
        out += [f"c{n}: unknown dep {x}" for x in r["deps"] if x not in R]
        if r["kind"] not in KINDS: out.append(f"c{n}: unknown kind {r['kind'] or '(none)'}")
        if not r["done"]: out.append(f"c{n}: no done-when")
        if r["model"] != "default" and not okme(r["model"]): out.append(f"c{n}: model/effort {r['model'] or '(none)'} is not like opus/medium (efforts: low medium high xhigh max; no fable)")
        if r["est"] is None: out.append(f"c{n}: est {r['raw_est'] or '(none)'} is not like 60K")
        elif AT > 0 and r["est"] > AT - START: out.append(f"c{n}: est {r['est'] // 1000}K over the {(AT - START) // 1000}K budget")
    for cy in cycles:
        k = frozenset(cy)
        if k not in seen: seen.add(k); out.append("cycle: " + " → ".join(f"c{x}" for x in cy))
    ns = list(R)
    for i, x in enumerate(ns):
        for y in ns[i + 1:]:
            if x not in anc(y) and y not in anc(x):   # neither waits for the other: they may run at once
                both = [f"{s} ~ {t}" if s != t else s for s in R[x]["touch"] for t in R[y]["touch"] if overlap(s, t)]
                if both: out.append(f"c{x} and c{y} both touch {', '.join(both)}")
    if out: sys.exit(print("\n".join(out)) or 1)
    sys.exit()

if mode == "--done":   # row N's kind, model/effort and est, and this session's act from rnd.py, as a usage chunk line
    n = a[2].removeprefix("c")
    if n not in R: die(f"no row {n} in {path}")
    r = R[n]; m, _, e = (KINDS.get(r["kind"], "") if r["model"] == "default" else r["model"]).partition("/")
    if r["est"] is None: sys.exit(print(f"nothing logged: c{n}'s est {r['raw_est'] or '(none)'} is not like 60K"))
    if os.environ["PLAN_TELEMETRY"] != "local":
        sys.exit(print(f"nothing logged: telemetry is {os.environ['PLAN_TELEMETRY']}, not local (config telemetry)"))
    act, sid = "", os.environ.get("CLAUDE_CODE_SESSION_ID", "")[:8]
    try:   # growth has one definition: rnd.py's; no session id, no act
        if not sid: raise ValueError
        out = subprocess.run([sys.executable, "-I", os.path.join(os.path.dirname(os.environ["PLAN_LIB"]), "skills/rnd/rnd.py"),
                              "chunks", "7", "--session", sid], capture_output=True, text=True, timeout=120).stdout.splitlines()
        act = out[1].split("\t")[out[0].split("\t").index("act_K")] if len(out) > 1 else ""
    except (OSError, ValueError, IndexError, subprocess.SubprocessError): pass
    log = os.environ["PLAN_LOG"]; size = os.path.getsize(log) if os.path.exists(log) else 0
    subprocess.run(["bash", "-c", '. "$0" && usage "$@"', os.environ["PLAN_LIB"], r["kind"], "chunk", m, e, str(r["est"] // 1000), act])
    new = open(log).read()[size:].strip() if os.path.exists(log) else ""
    print(new or f"nothing logged: usage refused or couldn't write kind {r['kind']}, model/effort {m}/{e}, est {r['est'] // 1000}, act {act or '-'}")
    sys.exit()

if mode == "--brief":
    n = a[2].removeprefix("c")
    if n not in R: die(f"no row {n} in {path}")
    r = R[n]; me = KINDS.get(r["kind"], "?") if r["model"] == "default" else r["model"]
    print(f"""# {key} c{n} · {r['title']}

Kind: {r['kind']} · Model: {me} · Est: {r['raw_est']} growth · Deps: {', '.join(r['deps']) or 'none'} · Wave {wave[n] or '?'}

**First:** read `{d}/{key}-chunk-rules.md` (paths, setup, interface, landing). N = {n}.

**Goal.** {r['title']}

**Read only:** (sections, as line ranges)

**Touches:** {', '.join(f'`{t}`' for t in r['touch']) or '–'}.

**Done when:** {r['done']}""")
    sys.exit()

print(f"waves: {waves or '(none)'}")
if mode == "--next" and os.environ["PLAN_ON"] == "false":
    print("plan.enabled is false: run tasks without a plan")
elif mode == "--next":
    run = [n for n in R if running(n)]
    cand = list(run)   # running chunks first: they hold slots and touches
    for n in R:   # runnable, in row order, skipping one whose touches overlap a chunk already picked
        if n not in run and not isdone(n) and wave[n] and all(isdone(x) for x in R[n]["deps"]) and \
           not any(overlap(s, t) for c in cand for s in R[c]["touch"] for t in R[n]["touch"]): cand.append(n)
    tops = [{t.split("/")[0] if "/" in t else "." for t in R[n]["touch"]} for n in cand]
    if any(tops[i] & tops[j] for i in range(min(len(tops), MAXP)) for j in range(i)):   # 2+ in one top-level directory: cap at 2,
        k = max(1, len(run))   # keeping the running ones (or the first pick), preferring a disjoint one
        cand = cand[:k] + ([n for n, t in zip(cand[k:], tops[k:]) if not t & tops[0]] or cand[k:k + 1])[:max(0, 2 - k)]
    cand = [n for n in cand[:MAXP] if n not in run]
    for n in cand:
        r = R[n]; me = KINDS.get(r["kind"], "opus/medium") if r["model"] == "default" else r["model"]
        if not okme(me): print(f"c{n}: model/effort {me} not allowed (--check): not started"); continue
        m, _, e = me.partition("/")
        prompt = f"Session task: {key}\nChunk: {key}/{n}\nRead {d}/{key}-c{n}.md and do it."
        print(f"{os.environ['PLAN_BG']} --model {shlex.quote(m)} --effort {shlex.quote(e)} -n {shlex.quote(f'{key}-c{n}')} {shlex.quote(prompt)}")
else:
    for n, r in R.items():
        st = "running" if running(n) else state.get(n) or ("ready" if wave[n] and all(isdone(x) for x in r["deps"]) else "waiting" if wave[n] else "blocked")
        print(f"c{n:<3} {st:<8} {r['kind']:<10} {r['title']}")
PY
fi
if [ "${1:-}" = --open ]; then
  case ${2:-} in view) fn=open_view ;; split) fn=open_split ;; *) echo "usage: session-status --open view|split …" >&2; exit 1 ;; esac
  shift 2; a=(); while [ $# -gt 0 ] && [ "$1" != -- ]; do a+=("$1"); shift; done; shift
  load_terminal; "$fn" ${a[@]+"${a[@]}"} "$@"; exit
fi

SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
# --coordinator-of DIR [--start]: the coordinator of the project DIR is in, when that is another than this one (a
# subproject with its own adapter, or the parent above this one).
if [ "${1:-}" = --coordinator-of ]; then
  [ -n "${2:-}" ] && d=$(cd "$2" 2>/dev/null && pwd -P) && case ${3:-} in ''|--start) ;; *) false ;; esac ||
    { echo "usage: session-status --coordinator-of DIR [--start]" >&2; exit 2; }
  me=$(find_root) r=$(cd "$d" && find_root) own=1
  [ "$d" != "$me" ] || { echo "$(tilde "$d") is this project's root: its coordinator is this one" >&2; exit 2; }
  # None of its own: DIR's coordinator, when one was opened there and hasn't run setup yet.
  [ "$r" != "$me" ] && is_root "$r" || { own= r=$d; }
  n=$(coord_name "$r"); coord_live "$r"
  case $? in 0) exit 0 ;; 1) ;; *) echo "an account's session listing failed, so whether $n runs is unknown: try again" >&2; exit 3 ;; esac
  if [ "${3:-}" != --start ]; then
    [ -z "$own" ] || { echo "$n ($(tilde "$r")) isn't running: --start opens it" >&2; exit 1; }
    echo "$(tilde "$d") has no coordinator of its own: --start opens one there, whose setup asks the user to give it its own (--init --own)" >&2; exit 4
  fi
