  awk -F'\t' -v me="${CLAUDE_CODE_SESSION_ID:-}" -v n="$2" -v mine="$(ho_name "${CLAUDE_CODE_SESSION_ID:-}")" '$1 != me && $2 == n && h == "" { h = $1 }
