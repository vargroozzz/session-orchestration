  load_terminal
  # a coordinator that was a successor itself may still have the NAME-next tab title (--await name's retitle didn't
  # take, or never ran): retitle the caller's own tab first, or open_view below selects it and starts nothing
  own=; ho_retitle "$id" "$n" || own=" It may be this session's own tab, left from its start as a successor (its retitle to \"$n\" failed): then retitle that tab \"$n\" by hand instead of closing it."
  # TERMINAL_QUIET: the tab opens behind the app and tab the user is on (each handover pulled them to it); set in the
  # subshell, not as a prefix: a prefix exports it, and a module that spawns the terminal would hand it to the successor
  out=$(TERMINAL_QUIET=1; open_view --account "$acct" "$n-next" "$ROOT" "$cmd"); rc=$?; q=$(printf %q "$ROOT")
  # open_view selects an open tab with the title instead: a successor that exited left it, and nothing was started
  [ "$rc" != 0 ] || [ "${out#reused}" = "$out" ] ||
    { echo "a tab titled \"$n-next\" is open already ($out), so nothing started: close it (a successor that exited?), then run this again.$own"; exit 3; }
  # Desktop (claude-desktop, claude-desktop-3p) draws no tab of its own; its Terminal panel runs the successor as a
  # CLI session beside the chat.
  desk=; [[ ${CLAUDE_CODE_ENTRYPOINT:-} != claude-desktop* ]] || desk="This is Claude Code Desktop: tell the user to run it in the session's Terminal (its title bar, or Ctrl+\`) or any terminal app; the successor is a terminal session from then on."
  case $rc in
    0) echo "started \"$n-next\" under $(tilde "$acct") ($out)."; echo "$next" ;;
    2) echo "nothing opened (terminal $(config terminal)): hand the user this command (hand_command, key coordinator), then go on:"
       echo "  cd $q && $pre$cmd"; [ -z "$desk" ] || echo "$desk"; echo "$next" ;;
    *) echo "the terminal failed (exit $rc): $out. Not started: hand the user \`cd $q && $pre$cmd\`, or try again"; [ -z "$desk" ] || echo "$desk" ;;
  esac
  exit "$rc"
fi
if [ "${1:-}" = --await ]; then
  what=${2:-}; shift 2 2>/dev/null || shift $#; tmo=3600; [ "$what" != ready ] || tmo=86400; [ "${1:-}" = --timeout ] && { tmo=${2:-}; shift 2 2>/dev/null || shift $#; }
  case $what in ready|renamed|name|done) ;; *) what= ;; esac
  [ -n "$what" ] && [[ $tmo =~ ^[1-9][0-9]*$ ]] && [ $# = 0 ] || { echo "usage: session-status --await ready|renamed|name|done [--timeout SECS]"; exit 2; }
  every=${SESSION_STATUS_AWAIT_S:-10}; end=$(( $(date +%s) + tmo )); id=${CLAUDE_CODE_SESSION_ID:-}
  ho_live || exit 1; me=$(ho_name "$id")
  [ -n "$id" ] && [ -n "$me" ] || { echo "this session isn't listed (CLAUDE_CODE_SESSION_ID ${id:-unset})"; exit 2; }
  n=$(ho_base "$me"); mkdir -p "$HO_DIR"
  [ "$what" = ready ] || [ "$what" = renamed ] || [ "$me" != "$n" ] || [ "$what" = done ] || { echo "you are \"$me\", not \"$n-next\": no handover to wait on"; exit 2; }
