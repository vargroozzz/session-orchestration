fi
if [ "${1:-}" = --successor ]; then
  shift; acct=${CLAUDE_CONFIG_DIR:-$HOME/.claude} fin= given=
  case ${1:-} in --account) acct=${2:-} given=1; shift 2 || true ;; --done) fin=1; shift ;;
    --started) id=${CLAUDE_CODE_SESSION_ID:-}; [[ ${2:-} =~ ^[A-Za-z0-9._-]+$ ]] && [ $# = 2 ] && [ -n "$id" ] ||
        { echo "usage: session-status --successor --started NAME (as the successor, CLAUDE_CODE_SESSION_ID set)"; exit 2; }
      ho_live || exit 1
      # only while another live session (the old coordinator) holds NAME, and no other live successor is recorded
      [ -n "$(awk -F'\t' -v me="$id" -v n="$2" '$1 != me && $2 == n { print $1; exit }' <<<"$live")" ] ||
        { echo "no other live session holds \"$2\": no handover to succeed in"; exit 2; }
      r=$(ho_next "$2"); [ -z "$r" ] || [ "$r" = "$id" ] || [ "$(ho_name "$r")" != "$2-next" ] ||
        { echo "\"$2-next\" is recorded already (${r:0:8}, live): not recorded"; exit 3; }
      mkdir -p "$HO_DIR"; echo "$id" > "$HO_DIR/$2.next"
      echo "recorded: you count as \"$2-next\" whatever your name; go on with your Start."; exit 0 ;;
  esac
  acct=${acct/#\~/$HOME}; acct=${acct%/}
  [ $# = 0 ] && [ -d "$acct" ] || { echo "usage: session-status --successor [--account CONFIG_DIR] | --successor --done | --successor --started NAME"; exit 2; }
  ho_live || exit 1; id=${CLAUDE_CODE_SESSION_ID:-}; me=$(ho_field 1 "$id" 2)
  [ -n "$id" ] && [ -n "$me" ] || { echo "this session isn't listed (CLAUDE_CODE_SESSION_ID ${id:-unset}): hand over by hand"; exit 2; }
  n=$(ho_base "$me"); mkdir -p "$HO_DIR"
  if [ -n "$fin" ]; then
    # the done stamp names the session whose terminal the successor closes: only the old one writes it, renamed
    # (NAME-prev-K), or still NAME once its NAME-next has finished its Start (it renames itself last)
    if [ "$me" = "$n" ]; then s=$(cat "$HO_DIR/$n.ready" 2>/dev/null)
      [ -n "$s" ] && [ "$(ho_name "$s")" = "$n-next" ] ||
        { echo "no live \"$n-next\" has finished its Start (\`$SELF --await ready\` wakes when one has): no done stamp written"; exit 3; }
      echo "$id" > "$HO_DIR/$n.done"
      echo "done: now, last, rename yourself (name_session with the name \`$SELF --prev-name --title\` prints; it also titles your tab) and end your turn; the successor takes \"$n\" and closes this session's terminal once it is idle."; exit 0
    fi
    [[ $me =~ -prev-[0-9]+$ ]] || { echo "\"$me\" isn't a renamed old coordinator (NAME-prev-K): no done stamp written"; exit 2; }
