  [ -n "$nx" ] || [ -z "$r" ] || [ "$r" = "$id" ] || [ "$(ho_name "$r")" != "$n-next" ] || nx=$r
  [ -z "$nx" ] || { echo "\"$n-next\" (${nx:0:8}) runs already: arm \`$SELF --await ready\` in the background"; exit 3; }
  rm -f "$HO_DIR/$n.ready" "$HO_DIR/$n.done" "$HO_DIR/$n.next"
  # The name goes into a command typed into a shell: only the characters name_session and open_pane give one.
  [[ $n =~ ^[A-Za-z0-9._-]+$ ]] || { echo "\"$n\" has characters a shell would read (a /rename?): not handed over; rename it with name_session first"; exit 2; }
  # the handover note written since this session started (a failed Write leaves the predecessor's: its state, not ours)
  rd=$(replies_path); h=${rd:+$rd/coordinator-handover.md}; st=$(ho_field 1 "$id" 5)
  [ -z "$h" ] || { [ -f "$h" ] && [ "$(mtime "$h")" -ge "${st:-0}" ]; } ||
    { echo "$(tilde "$h") is missing or older than this session's start: write (or rewrite: a resumed session's start is its resume) your handover note there (handover.md), then run this again. Nothing started."; exit 3; }
  # SESSION_STATUS_CLAUDE: the claude command, for a dev build's successor (`claude --plugin-dir DIR`)
  # the model and effort this coordinator runs on (fable too: the user chose it), else config plan.models.coordinator
  # for the account the successor starts under (fable only where fable.accounts lists it)
  read -r sm se < <(last_model "$(ls "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$id".jsonl 2>/dev/null | head -1)")
  [[ ${sm:-} != *fable* ]] || ! fable_no "$acct" || sm=   # no fable there (or its Fable limit is hit): config's
  [ -n "${sm:-}" ] || { cm=$(FABLE_ACCT=$acct config plan.models.coordinator 2>/dev/null); sm=${cm%%/*}; se=${cm#*/}; }   # never config's effort on another model
  # its advisor too, where it still pairs with that model and, for fable, the account has it (the terminal line only)
  sa=$(last_advisor "$(ls "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$id".jsonl 2>/dev/null | head -1)")
  [ -z "$sa" ] || { FABLE_OK=1 advisor_ok "$sm" "$sa" && { [ "$sa" != fable ] || ! fable_no "$acct"; }; } || sa=
  cmd="${SESSION_STATUS_CLAUDE:-claude} --model $(printf %q "$sm")${se:+ --effort $se}${sa:+ --advisor $sa}$(remote_flag "$ROOT") -n $n-next 'Act as a coordinator. You succeed \"$n\" (${id:0:8}): end your Start with the successor step (${SELF%/*}/handover.md).'"
  next="Then arm \`$SELF --await ready\` (Bash, run_in_background) and end your turn. From now on act on no message: forward each to the inbox (\`$SELF --inbox-add --from '<sender name> (<id8>)'\`, its text on stdin)."
  # Desktop (claude-desktop, claude-desktop-3p), same account: the coordinator starts the successor as an app session
  # (start_session), so it stays in the sidebar. The successor records its id first: whether start_session's title
  # becomes the name `claude agents` lists is unverified.
  if [[ ${CLAUDE_CODE_ENTRYPOINT:-} == claude-desktop* ]] && [ -z "$given" ]; then
    echo "This is Claude Code Desktop: start the successor as an app session. Call mcp__ccd_session__start_session (ToolSearch it) with:"
    echo "  title \"$n-next\", context \"fresh\", use_worktree false${sm:+, model \"$sm\"}${se:+, effort \"$se\"},"
    echo "  initiation \"user_asked\" if the user asked for this handover in this turn, else \"own_initiative\" (a card the user starts),"
    echo "  background: goal, decisions and constraints from <replies>/coordinator-handover.md,"
    echo "  prompt: Act as a coordinator. You succeed \"$n\" (${id:0:8}). First run \`$SELF --successor --started $n\`, then end your Start with the successor step (${SELF%/*}/handover.md)."
    [ -z "$(remote_flag "$ROOT")" ] || echo "features.remote is on, and an app session can't be started with Remote Control: once it holds \"$n\", tell the user to turn it on there (/remote-control) for your other computers to reach it (features/remote.md)."
    echo "Leave your pin and never archive this session yourself: the successor moves the pin and archives this one once it holds \"$n\" (archiving it before then takes the successor with it). An approval you relay in the handover note may not verify for the successor (its prompt isn't typed by the user): if its approval check rejects one, it asks the user again."
    echo "$next"; exit 2
  fi
