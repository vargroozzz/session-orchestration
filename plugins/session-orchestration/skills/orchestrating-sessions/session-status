fi
# --report-file SESSION_ID [KEY] < REPORT: the reply tool's `report`, the status report at the top of <replies>/<KEY>.md
# (the file --handover reads; worker.md, The replies file). No KEY: the task key context-watch.sh cached for that
# session, else its name less a -prev-K; a sub-coordinator's (`Coordinate KEY`), always KEY-coordinator. It replaces what precedes the first `## Handoff` and keeps that section on,
# so a report never drops the handoff; a report with its own `## Handoff` replaces it. A chunk files under KEY-cN-report;
# a report without a plan heading over a file whose top has one (`## Plan`, `## Build plan`) goes to NAME-report.md.
# A file with a `# Title` line (a design written to KEY.md) keeps it and what follows (up to a new report's own `## Handoff`; none when the report has a `# ` line). A `# ` section the write drops is first appended, with the whole old file, to NAME-archive.md. Exit 3: no replies folder.
if [ "${1:-}" = --report-file ]; then
  rd=$(replies_path); [ -n "$rd" ] || { echo "$ROOT/CLAUDE.md names no replies folder" >&2; exit 3; }
  body=$(cat); [ -n "${body//[[:space:]]/}" ] && [ -n "${2:-}" ] || { echo "usage: session-status --report-file SESSION_ID < REPORT" >&2; exit 2; }
  ok='^[A-Za-z0-9][A-Za-z0-9._-]*$'
  kd= ck= cn=; [[ $2 =~ ^[A-Za-z0-9_-]+$ ]] && read -r kd ck cn _ 2>/dev/null < "${XDG_CACHE_HOME:-$HOME/.cache}/session-status/handoff-$2.kind" || kd=
  # a sub-coordinator (context-watch's kind) files under its name, KEY-coordinator, whatever key it passes: KEY.md is its plan
  # shortcut: relies on .kind (written at its first prompt); classify here too if a sub ever reports before that
  if [ "$kd" = subcoordinator ] && [[ $ck =~ $ok ]]; then n=$ck-coordinator
  # a chunk files under KEY-cN-report: KEY.md is the plan, KEY-cN.md the chunk's brief
  elif [ "$kd" = chunk ] && [[ $ck =~ $ok ]] && [[ $cn =~ ^[0-9]+$ ]] && [[ -z ${3:-} || $3 == "$ck" || $3 == "$ck-c$cn" ]]; then n=$ck-c$cn-report
  elif [ -n "${3:-}" ]; then n=$3; [[ $n =~ $ok ]] || { echo "key \"$n\": letters, digits, . _ - only (a keyless task: its session name)" >&2; exit 2; }
  else
    # a task's cached key only: a chunk's second field is its plan's key, and KEY.md is the plan
    n=; [ "$kd" != task ] || n=$ck
    [[ $n =~ $ok ]] || { n=$(list_sessions | awk -F'\t' -v s="$2" '$1 == s { print $2; exit }'); [[ $n =~ ^(.+)-prev-[0-9]+$ ]] && n=${BASH_REMATCH[1]}; }
    [[ $n =~ $ok ]] || { echo "session ${2:0:8} has no name to file the report under${n:+ (\"$n\")}: pass key, or name_session first" >&2; exit 2; }
  fi
  f=$rd/$n.md; mkdir -p "$rd"
  # a plan (a `## Plan` or `## Build plan` above its handoff) is never replaced by a report that has none: NAME-report.md
  if [ -f "$f" ] && ! grep -qE '^## (Build )?[Pp]lan([[:space:]]|$)' <<<"$body" &&
    awk '/^## Handoff/ { exit } /^## (Build )?[Pp]lan([[:space:]]|$)/ { p = 1; exit } END { exit !p }' "$f"; then n=$n-report; f=$rd/$n.md; fi
  # kept: from the first `# Title` (a deliverable written to KEY.md, e.g. a design), else from `## Handoff` unless the report has its own
  kept=; [ ! -f "$f" ] || kept=$(awk -v h="$(grep -c '^## Handoff' <<<"$body")" -v t="$(grep -c '^# ' <<<"$body")" '/^## Handoff/ && h { on = 0; done = 1 } !done && ((!t && /^# /) || (!h && /^## Handoff/)) { on = 1 } on' "$f")
  # a `# ` section the write would drop (a deliverable, or an older report's own title) moves to NAME-archive.md first
  if [ -f "$f" ] && [ "$(grep -c '^# ' "$f")" -gt "$(grep -c '^# ' <<<"$kept")" ]; then
    { printf '\n<!-- replaced by a report, %s -->\n' "$(date -u +%Y-%m-%dT%H:%MZ)"; cat "$f"; } >> "$rd/$n-archive.md" || { echo "couldn't archive $f" >&2; exit 1; }
  fi
  { printf '%s\n' "$body"; [ -z "$kept" ] || printf '\n%s\n' "$kept"; } > "$f.$$" && mv "$f.$$" "$f" && echo "$f" || { rm -f "$f.$$"; echo "couldn't write $f" >&2; exit 1; }
  exit
fi
if [ "${1:-}" = --inbox ] && [ "${2:-}" = --sent ]; then
  # each entry this coordinator queued in another project's inbox, newest last: `MARK · DIR (its coordinator) #N · WHEN · text`
  sent_marks | while IFS=$'\t' read -r m d n w t; do printf '%s · %s (%s) #%s%s%s\n' "$m" "$(tilde "$d")" "$(coord_name "$d")" "$n" "${w:+ · $w}" "${t:+ · ${t:0:80}}"; done
