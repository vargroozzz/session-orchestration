    if st=$(awk -F'\t' -v n="$n" -v r="$r" -v id="$id" '($1 == n || $1 == n "-next" || (id != "" && $4 == id)) && ($2 == r || index($2, r "/") == 1) {
          if (!f || (!own && $3 == "claude")) { m = $1; own = $3 == "claude"; pid = $5 } f = 1 }
        END { if (!f) exit 1; print m "\t" (own ? "running" : "running under another account") "\t" pid }' <<<"$live"); then
      IFS=$'\t' read -r n st pid <<<"$st"   # pid last: tabs are IFS whitespace, so an empty one between would collapse
      # Another account's live coordinator takes a SendMessage at its socket, with features.accounts on (as coord_live).
      [ "$st" = running ] || [ "$acc" != true ] || ! a=$(sock_addr "$pid") || st="$st: SendMessage to \"$a\""
    elif [ -e "$TMP/ask.failed" ]; then st="unknown (an account's session listing failed)"
    else st='not running'; fi
    [ "$r" != "$ROOT" ] || st="$st, this project"
    [ -n "$(replies_path "$r")" ] || st="$st, no inbox (its CLAUDE.md names no replies folder)"
    p=$(coord_purpose "$r")
    printf '%s · %s · %s · %s · %s\n' "$n" "$(tilde "$r")" "$(tilde "$acct")" "$st" "${p:-(no purpose set: its coordinator sets one with --purpose)}"
  done | grep . || echo "(none set up any more: each registered root has gone or dropped its setup; $(tilde "$reg"))"
  remote_block; exit 0
fi
# coord_me WHAT: sets me to this session's listed name when it is this project's coordinator (or its -next), else
# exits 2 saying only the coordinator WHAT (3: a listing failed, so it's unknown).
coord_me() {
  local c t; t=$(mktemp -d) || exit 1; c=$(coord_name "$ROOT")
  me=$(TMP=$t list_sessions | awk -F'\t' -v s="${CLAUDE_CODE_SESSION_ID:-}" -v r="$ROOT" 's != "" && $1 == s && ($6 == r || index($6, r "/") == 1) { print $2; exit }')
  [ -n "$me" ] || [ ! -e "$t/ask.failed" ] || { rm -rf "$t"; echo "an account's session listing failed, so whether this session is the coordinator is unknown: try again" >&2; exit 3; }
  rm -rf "$t"
  case $me in "$c"|"$c-next") ;;
    *) echo "only this project's coordinator $1 (this session: \"${me:-not listed in $(tilde "$ROOT")}\"); a task session messages its own coordinator" >&2; exit 2 ;;
