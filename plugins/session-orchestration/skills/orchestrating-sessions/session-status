# The coordinator inbox: <replies>/coordinator-inbox.md holds the messages no live coordinator took (the reply tool's
# backstop) and what an old coordinator forwards while it hands over. An entry is a `## N · unread · MM-DD HH:MM ·
# from WHO` heading and the text under it; --inbox --read N marks it read.
inbox_file() { local rd; rd=$(replies_path); [ -n "$rd" ] && echo "$rd/coordinator-inbox.md"; }
inbox_unread() {   # the unread entries, heading and text, oldest first
