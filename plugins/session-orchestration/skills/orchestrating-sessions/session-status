if [ "${1:-}" = --inbox-add ]; then
  shift; from= to=
  usage="usage: session-status --inbox-add [--from WHO] [SENDER_ID] < TEXT | --inbox-add --root DIR < TEXT"
  case ${1:-} in
    --from) from=${2:-}; shift 2 ;;
    --root) to=${2:-}; [ -n "$to" ] && [ $# = 2 ] || { echo "$usage" >&2; exit 2; }; shift 2 ;;
  esac
  body=$(cat); [ -n "${body//[[:space:]]/}" ] && [ "${1:-}" != --root ] || { echo "$usage" >&2; exit 2; }
  if [ -n "$to" ]; then
    # --root DIR: another project's coordinator inbox, under any account (features/accounts.md, Messaging another
    # project's coordinator). Coordinator to coordinator only, never an approval, never into a folder git would commit.
    # The cheap refusals first: the listing below asks every account.
    [ "$(config features.accounts)" = true ] || { echo "--inbox-add --root: features.accounts is off in this project" >&2; exit 2; }
    d=$(cd "${to/#\~/$HOME}" 2>/dev/null && pwd -P) && is_root "$d" ||
